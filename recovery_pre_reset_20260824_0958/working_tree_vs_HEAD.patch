+		sItem[i].CODE = g_MingwItemCodeMap[i].CODE;
+
+		ZeroMemory(
+			sItem[i].LastCategory,
+			sizeof(sItem[i].LastCategory)
+		);
+
+		memcpy(
+			sItem[i].LastCategory,
+			g_MingwItemCodeMap[i].LastCategory,
+			5
+		);
+
+		sItem[i].sItemInfo.CODE =
+			g_MingwItemCodeMap[i].CODE;
+	}
+
+	return count;
