+				fTiling_v = aseMaterial[fmat].UVW_V_TILING[tcnt];
+				fAngle = (float)(aseMaterial[fmat].UVW_ANGLE[tcnt] * smMULT_PIE);
+				fSin = ((float)GetSin[((int)fAngle) & ANGLE_MASK]) / 65536;
