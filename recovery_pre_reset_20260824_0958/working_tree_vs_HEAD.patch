+
+
+			fp = ReadASE_GEOMOBJECT(fp, obj);
+
+
+
+			if((obj->NodeName[0] == 'B' && obj->NodeName[1] == 'i' && obj->NodeName[2] == 'p'))
+			{
+				delete obj;
+				obj = nullptr;
+			}
+			else
+			{
+				obj->SortVertex();
+				pat->AddObject(obj);
+			}
+
+		}
+
+	}
+
+	fclose(fp);
+
+	pat->TmParent = smPhysique;
+
+	if(smPhysique)
+	{
+		pat->ReformPhysique();
+	}
+	else
+	{
+		pat->LinkObject();
+		pat->ReformTM();
+	}
+
+	szFile = ChangeFileExt(file, szFileModel);
+	pat->SaveFile(szFile);
+
+	delete pat;
+	pat = nullptr;
+
+	pat = smReadModel(szFile, szName);
+
+	return pat;
+
+}
