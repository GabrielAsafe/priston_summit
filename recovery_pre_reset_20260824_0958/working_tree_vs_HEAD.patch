+
+					fu = (fU * fCos) + (fV * fSin);
+					fv = (fV * fCos) - (fU * fSin);
+
+					fu -= fOffset_u;
+					fv -= fOffset_v;
+
+					fu *= fTiling_u;
+					fv *= fTiling_v;
