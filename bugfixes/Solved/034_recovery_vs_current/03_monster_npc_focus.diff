+
+
+	for(cnt = 0; cnt < FileCnt; cnt++)
+	{
+		for(cnt2 = 0; cnt2 < PatList[cnt]->nObj3d; cnt2++)
+		{
+			Obj3d2 = PatList[cnt]->obj3d[cnt2];
+			Obj3d = Pat3d->GetObjectFromName(Obj3d2->NodeName);
+			if(Obj3d == NULL)
+			{
+				Obj3d = new smOBJ3D(0, 0);
