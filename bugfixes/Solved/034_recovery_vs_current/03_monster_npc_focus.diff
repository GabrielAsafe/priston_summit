+char *GetWord(char *q, char *p)
+{
+
+
+	while((*p == 32) || (*p == 9) || (*p == 58))
+	{
+		p++;
+	}
+
+	while((*p != 32) && (*p != 9) && (*p != 58))
+	{
+		// MINGW_GETWORD_LINE_TERMINATOR_FIX_V1
+		if(*p == 0 || *p == '\n' || *p == '\r') break;
+		*q++ = *p++;
+	}
+	*q++ = 0;
+
+
+
+	return p;
+}
+
+char *GetString(char *q, char *p)
+{
+	// MINGW_GETSTRING_BOUNDS_FIX_V1
+	while(*p != 34)
+	{
+		if(*p == 0 || *p == '\r' || *p == '\n')
+		{
+			*q = 0;
+			return p;
+		}
+		p++;
+	}
+
+	p++;
+
+	while(*p != 34)
+	{
+		if(*p == 0 || *p == '\r' || *p == '\n')
+		{
+			*q = 0;
+			return p;
+		}
+
+		*q++ = *p++;
+	}
+
+	if(*p == 34)
+		p++;
+
+	*q = 0;
+
+	return p;
+}
