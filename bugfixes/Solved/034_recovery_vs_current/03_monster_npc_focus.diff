+
+smSTAGE3D *smReadStage(char *file, smSTAGE3D *smStagep)
+{
+	smSTAGE3D *smStage;
+	int result;
+
+	if(smStagep)
+		smStage = smStagep;
+	else
+		smStage = new smSTAGE3D;
+
+	result = smStage->LoadFile(file);
+
+	if(result == FALSE)
+	{
+		if(!smStagep)
+		{
+			smStage->Init(0, 0);
+			delete smStage;
+		}
+		return NULL;
+	}
+
+	return smStage;
+}
