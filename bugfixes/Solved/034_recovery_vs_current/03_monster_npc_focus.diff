+
+	DWORD	dwMaterialSum[MATRIAL_MAX * 2];
+	int		aseMaterialLink[MATRIAL_MAX * 2];
+	DWORD	dwSum;
+	BYTE	*lpAseMat;
+	int		nCnt, rCnt, lCnt;
