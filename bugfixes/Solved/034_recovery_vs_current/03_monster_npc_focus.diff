+		}
+
+
+
+		if(nCnt > 0 && nCnt < cnt &&
+			stricmp(aseMaterial[cnt].BITMAP[0], aseMaterial[nCnt].BITMAP[0]) == 0)
+		{
+			aseMaterialLink[cnt] = nCnt;
+			lCnt++;
+		}
+		else
+		{
