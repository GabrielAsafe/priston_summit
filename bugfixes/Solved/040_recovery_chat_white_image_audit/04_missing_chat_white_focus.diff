+static void MingwLowPetTrace(const char *fmt, ...)
+{
+	FILE *fp = fopen("lowlevelpet_trace.txt", "a");
+	if(!fp)
+		return;
+
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(fp, fmt, ap);
+	va_end(ap);
+
+	fprintf(fp, "\n");
+	fflush(fp);
+	fclose(fp);
+}
