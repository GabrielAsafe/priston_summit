+		if(HelpMsgTime > (70 * 15) || PetMessageOkButtonFlag == 2)
+		{
+			PetMessageOkButtonFlag = 0;
+			HelpMsgTime = 0;
+			HelpMsgFlag = 0;
+
+			if(lstrcmp(HelpMsgId, "*Level_Message10-2") == 0)
+			{
+				if(sinChar->Level >= 10)
