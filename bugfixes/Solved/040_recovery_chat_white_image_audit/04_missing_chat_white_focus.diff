+	MingwPetMessageTrace(
+		"[GETFILE_BEGIN] path='%s' cmdmax=%d existing_map=%u",
+		szFilePath,
+		CmdMax,
+		(unsigned)PetMsg_Map.size());
+
+	fp = fopen(szFilePath, "rb");
+
+	if(fp == NULL)
+	{
+		MingwPetMessageTrace("[GETFILE_OPEN_FAIL]");
+		return FALSE;
+	}
+
+	MingwPetMessageTrace("[GETFILE_OPEN_OK]");
+
+	CmdNum = 0;
+	int lineNum = 0;
+
+	while(!feof(fp))
+	{
+		if(CmdNum >= CmdMax)
+		{
+			MingwPetMessageTrace(
+				"[GETFILE_ALL_COMMANDS_DONE] cmd=%d line=%d",
+				CmdNum, lineNum);
+			break;
+		}
+
+		if(fgets(line, 255, fp) == NULL)
+			break;
+
+		lineNum++;
+
+		MingwPetMessageTrace(
+			"[OUTER_BEFORE_GETWORD] line=%d cmd=%d expected='%s'",
+			lineNum,
+			CmdNum,
+			szPetMessageCommand[CmdNum]);
+
+		p = GetWord(decode, line);
+
+		MingwPetMessageTrace(
+			"[OUTER_AFTER_GETWORD] line=%d cmd=%d",
+			lineNum,
+			CmdNum);
+
+		if(lstrcmp(decode, szPetMessageCommand[CmdNum]) == 0)
+		{
+			MingwPetMessageTrace(
+				"[SECTION_BEGIN] cmd=%d name='%s' line=%d",
+				CmdNum,
+				szPetMessageCommand[CmdNum],
+				lineNum);
+
+			int itemCount = 0;
+
+			while(1)
+			{
+				if(fgets(line, 255, fp) == NULL)
+				break;
+
+				lineNum++;
+
+				MingwPetMessageTrace(
+					"[ITEM_BEFORE_PARSE] cmd=%d item=%d line=%d",
+					CmdNum,
+					itemCount,
+					lineNum);
+
+				GetString(decode, line);
+
+				MingwPetMessageTrace(
+					"[ITEM_AFTER_GETSTRING] cmd=%d item=%d line=%d",
+					CmdNum,
+					itemCount,
+					lineNum);
+
+				GetWord(decode2, line);
+
+				MingwPetMessageTrace(
+					"[ITEM_AFTER_GETWORD] cmd=%d item=%d line=%d",
+					CmdNum,
+					itemCount,
+					lineNum);
+
+				if(lstrcmp(decode2, "end") == 0)
+				{
+					MingwPetMessageTrace(
+						"[SECTION_END] cmd=%d name='%s' count=%d line=%d",
+						CmdNum,
+						szPetMessageCommand[CmdNum],
+						itemCount,
+						lineNum);
+					break;
+				}
+
+				MingwPetMessageTrace(
+					"[ITEM_BEFORE_PUSH] cmd=%d item=%d",
+					CmdNum,
+					itemCount);
+
+				PetMsg_Map[szPetMessageCommand[CmdNum]].push_back(
+					new string(decode));
+
+				itemCount++;
+
+				MingwPetMessageTrace(
+					"[ITEM_AFTER_PUSH] cmd=%d count=%d",
+					CmdNum,
+					itemCount);
+			}
+
+			CmdNum++;
+		}
+	}
+
+	fclose(fp);
+
+	MingwPetMessageTrace(
+		"[GETFILE_END] cmd=%d map=%u kind=%u name=%u welcome=%u normal=%u battle=%u",
+		CmdNum,
+		(unsigned)PetMsg_Map.size(),
+		(unsigned)PetMsg_Map["*PetKind"].size(),
+		(unsigned)PetMsg_Map["*PetName"].size(),
+		(unsigned)PetMsg_Map["*Welcom_ALL"].size(),
+		(unsigned)PetMsg_Map["*Normal_Message"].size(),
+		(unsigned)PetMsg_Map["*Battle_Message"].size());
+
+	return TRUE;
+}
+
+
+int cHELPPET::PetMessage(char *Id, int Index)
+{
+
+	if(!PetKind || !PetShow)return FALSE;
+
+	if(0 == Index && lstrcmp(Id, szTempId) == 0)
+	{
+		MsgTime = 1;
+		return FALSE;
+	}
+	MessageIndex = Index;
+	strcpy_s(szTempId, Id);
+	if(Index <= (int)PetMsg_Map[Id].size() - 1)
+	{
+	#ifdef	_LANGUAGE_VEITNAM
+		wsprintf(szPetBuff, "%s :   %s", PetMsg_Map["*PetName"][PetKind - 1]->c_str(), PetMsg_Map[Id][Index]->c_str());
+	#else
+		wsprintf(szPetBuff, "%s : %s", PetMsg_Map["*PetName"][PetKind - 1]->c_str(), PetMsg_Map[Id][Index]->c_str());
+	#endif
+	}
+
+
+	if(sinChar->Level >= 80)
+	{
+		MsgFlag = 0;
+		MsgTime = 0;
+	}
+	else
+	{
+		MsgFlag = 1;
+		MsgTime = 0;
+	}
+	return TRUE;
+}
+
+int cHELPPET::DrawPetMessage()
+{
+	if(MsgFlag)
+	{
+		PetRendPoint = HoPetRenderPoint;
+		DrawCharacterMessage(PetRendPoint.x, PetRendPoint.y, szPetBuff, 30);
+
+	}
+	return TRUE;
+
+}
+
+int cHELPPET::PetMessageHelp(char *Id)
+{
+
+	if(HelpMsgFlag)
+		Message_Keep.push_back(Id);
+	else
+	{
+		HelpMsgFlag = 1;
+		strcpy_s(HelpMsgId, Id);
+	}
+	return TRUE;
+}
+
+
+int cHELPPET::CheckPetData()
+{
+	MingwPetMessageTrace(
+		"[CHECK_BEGIN] loading=%d petkind=%d level=%d job=%d",
+		LoadingPet,
+		PetKind,
+		sinChar ? sinChar->Level : -1,
+		sinChar ? sinChar->JOB_CODE : -1);
+
+	if(LoadingPet == 0)
+	{
+		LoadingPet = 1;
+		return FALSE;
+
+	}
+
+
+	if(sinChar->Level >= 10)return FALSE;
+	char szTempBuff[128];
+
+
+	MingwPetMessageTrace("[CHECK_BEFORE_GETFILE]");
+
+	if(!GetFileData())
+	{
+		MingwPetMessageTrace("[CHECK_GETFILE_FAIL]");
+		return FALSE;
+	}
+
+	MingwPetMessageTrace(
+		"[CHECK_AFTER_GETFILE] petkind=%d kind=%u name=%u welcome=%u normal=%u battle=%u",
+		PetKind,
+		(unsigned)PetMsg_Map["*PetKind"].size(),
+		(unsigned)PetMsg_Map["*PetName"].size(),
+		(unsigned)PetMsg_Map["*Welcom_ALL"].size(),
+		(unsigned)PetMsg_Map["*Normal_Message"].size(),
+		(unsigned)PetMsg_Map["*Battle_Message"].size());
+
+	if(PetMsg_Map["*PetKind"].size() < 4 ||
+	   PetMsg_Map["*PetName"].size() < 4 ||
+	   PetMsg_Map["*Welcom_ALL"].size() < 2)
+	{
+		MingwPetMessageTrace("[CHECK_REJECT_BAD_STRUCTURE]");
+		return FALSE;
+	}
+
+	if(PetKind == 0)
+	{
+		PetKind = GetRandomPos(1, 4);
+
+		MingwPetMessageTrace("[CHECK_RANDOM_KIND] petkind=%d", PetKind);
+
+		if(PetKind < 1 || PetKind > 4)
+		{
+			MingwPetMessageTrace("[CHECK_REJECT_BAD_KIND] petkind=%d", PetKind);
+			return FALSE;
+		}
+
+		MingwPetMessageTrace("[CHECK_BEFORE_WELCOME1]");
+
+		wsprintf(szTempBuff, PetMsg_Map["*Welcom_ALL"][0]->c_str(), PetMsg_Map["*PetKind"][PetKind - 1]->c_str());
+
+		MingwPetMessageTrace("[CHECK_AFTER_WELCOME1] text='%s'", szTempBuff);
+		PetMsg_Map["*Welcom_ALL"][0]->assign(szTempBuff);
+
+		MingwPetMessageTrace("[CHECK_AFTER_ASSIGN1]");
+		MingwPetMessageTrace("[CHECK_BEFORE_WELCOME2]");
+
+		wsprintf(szTempBuff, PetMsg_Map["*Welcom_ALL"][1]->c_str(), PetMsg_Map["*PetName"][PetKind - 1]->c_str());
+
+		MingwPetMessageTrace("[CHECK_AFTER_WELCOME2] text='%s'", szTempBuff);
+
+		PetMsg_Map["*Welcom_ALL"][1]->assign(szTempBuff);
+
+		MingwPetMessageTrace("[CHECK_AFTER_ASSIGN2]");
+		MingwPetMessageTrace("[CHECK_BEFORE_HELP_WELCOME]");
+
+		PetMessageHelp("*Welcom_ALL");
+
+		MingwPetMessageTrace("[CHECK_AFTER_HELP_WELCOME]");
+
+
+		if(sinChar->JOB_CODE <= 4 || sinChar->JOB_CODE == 9 )
+		{
+			PetMessageHelp("*Welcom_Tems");
+
+		}
+		else
+		{
+			PetMessageHelp("*Welcom_Mora");
+
+		}
+	}
+
+
+	int i = 0;
+	MingwPetMessageTrace(
+		"[CHECK_BEFORE_INDEX] normal=%u battle=%u",
+		(unsigned)PetMsg_Map["*Normal_Message"].size(),
+		(unsigned)PetMsg_Map["*Battle_Message"].size());
+
+	for(i = 0; i < (int)PetMsg_Map["*Normal_Message"].size(); i++)
+	{
+		NormalMsg_Index.push_back(i);
+	}
+
+	MingwPetMessageTrace("[CHECK_AFTER_NORMAL_INDEX]");
+
+	for(i = 0; i < (int)PetMsg_Map["*Battle_Message"].size(); i++)
+	{
+		BattleMsg_Index.push_back(i);
+	}
+
+	MingwPetMessageTrace("[CHECK_AFTER_BATTLE_INDEX]");
+	MingwPetMessageTrace("[CHECK_BEFORE_SHOWPET] petkind=%d", PetKind);
+
+	ShowPet();
+
+	MingwPetMessageTrace("[CHECK_AFTER_SHOWPET]");
+
+	PetShow = 1;
+
+	MingwPetMessageTrace("[CHECK_END]");
+
+	return TRUE;
+}
+
+
+DWORD dwRandomMsgTime = 0;
+int cHELPPET::PetRandomNormalMessage()
+{
+
+	if(!PetKind || !PetShow)return FALSE;
+
+
+	int RandomNum = 0;
+	int i = 0;
+	dwRandomMsgTime++;
+	if(lpCurPlayer->OnStageField >= 0 && StageField[lpCurPlayer->OnStageField]->State == FIELD_STATE_VILLAGE)
+	{
+		if(dwRandomMsgTime >= 70 * 30)
+		{
+
+			if(NormalMsg_Index.size() != 0)
+			{
+				RandomNum = GetRandomPos((int)NormalMsg_Index.front(), (int)NormalMsg_Index.back());
+				NormalMsg_Index.remove(RandomNum);
+				PetMessage("*Normal_Message", RandomNum);
+				dwRandomMsgTime = 0;
+			}
+			else
+			{
+				for(i = 0; i < (int)PetMsg_Map["*Normal_Message"].size(); i++)
+				{
+					NormalMsg_Index.push_back(i);
+				}
+			}
+		}
+	}
+	return TRUE;
+}
+int PetExpMessage[] = { 5,10,20,30,35,40,50,60,70,80,90,100 };
+int PetExpIndex = 0;
+int ExpMessageFlag = 0;
+int cHELPPET::PetRandomBattleMessage()
+{
+	int RandomNum = 0;
+	int i = 0;
+
+	if(LevelFlag)
+	{
+		PetExpIndex = 0;
+		LevelFlag = 0;
+
+	}
+	if(lpCurPlayer->MotionInfo->State == CHRMOTION_STATE_ATTACK)
+	{
+		if(sinChar->Level < 8)
+		{
+			if(cHelpPet.PetExp > PetExpMessage[PetExpIndex])
+			{
+				if(BattleMsg_Index.size() != 0)
+				{
+					RandomNum = GetRandomPos((int)BattleMsg_Index.front(), (int)BattleMsg_Index.back());
+					BattleMsg_Index.remove(RandomNum);
+					PetMessage("*Battle_Message", RandomNum);
+					PetExpIndex++;
+				}
+				else
+				{
+					for(i = 0; i < (int)PetMsg_Map["*Battle_Message"].size(); i++)
+					{
+						BattleMsg_Index.push_back(i);
+					}
+				}
+			}
+		}
+		else
+		{
+			if(sinChar->Level == 8 && cHelpPet.PetExp >= 90 && !ExpMessageFlag)
+			{
+				ExpMessageFlag = 1;
+				switch(sinChar->JOB_CODE)
+				{
+					case 1:
+					PetMessageHelp("*Special_Message8_Fighter");
+					break;
+					case 2:
+					PetMessageHelp("*Special_Message8_Mecha");
+					break;
+					case 3:
+					PetMessageHelp("*Special_Message8_Archer");
+					break;
+					case 4:
+					PetMessageHelp("*Special_Message8_Pikeman");
+					break;
+					case 5:
+					PetMessageHelp("*Special_Message8_Atalanta");
+					break;
+					case 6:
+					PetMessageHelp("*Special_Message8_Knight");
+					break;
+					case 7:
+					PetMessageHelp("*Special_Message8_Magician");
+					break;
+					case 8:
+					PetMessageHelp("*Special_Message8_Priestess");
+					break;
+				}
+
+			}
+			if(sinChar->Level == 10 && cHelpPet.PetExp >= 90 && ExpMessageFlag != 2)
+			{
+				ExpMessageFlag = 2;
+				PetMessageHelp("*Special_Message9");
+
+			}
+		}
+	}
+	return TRUE;
+}
+
+
+int cHELPPET::ShowPet()
+{
+
+	if(!PetKind || (sinChar->Level >= 10 && cHelpPet.PetShow == 0))return FALSE;
+
+	switch(PetKind)
+	{
+		case 1:
+			g_LowLevelAddPet(lpCurPlayer, HoLowLevelPet::Type::Terry);
+		break;
+		case 2:
+		g_LowLevelAddPet(lpCurPlayer, HoLowLevelPet::Type::Nepsys);
+		break;
+		case 3:
+			g_LowLevelAddPet(lpCurPlayer, HoLowLevelPet::Type::Io);
+		break;
+		case 4:
+			g_LowLevelAddPet(lpCurPlayer, HoLowLevelPet::Type::Mute);
+		break;
+	}
+
+	return TRUE;
+}
+int cHELPPET::ClosePet()
+{
+
+	PetShow = 0;
+	g_LowLevelDeletePet(lpCurPlayer);
+
+	return TRUE;
+}
+int cHELPPET::PetOnOff(char *szBuff)
+{
+	if(sinChar->Level >= 10)return FALSE;
+	if(lstrcmp(szBuff, "/�����") == 0)
+	{
+		PetShow ^= 1;
+		switch(PetShow)
+		{
+			case 0:
+			ClosePet();
+
+			break;
+			case 1:
+			ShowPet();
+			break;
+		}
+	}
+	return TRUE;
+}
+
