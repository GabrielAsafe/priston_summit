+HoLowLevelPet::HoLowLevelPet() : m_Type(HoLowLevelPet::Terry),
+m_PetMeshRes(NULL),
+m_PetBoneRes(NULL),
+m_bFsmChangeFlag(false),
+m_eCurrentFsmState(FsmState::None),
+m_eNextFsmState(FsmState::None),
+m_TargetChar(NULL),
+m_iCurrentFrame(10 * 160),
+m_bMyCharacterFlag(false)
