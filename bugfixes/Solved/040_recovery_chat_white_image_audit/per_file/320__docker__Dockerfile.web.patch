diff --git a/docker/Dockerfile.web b/docker/Dockerfile.web
index 22cec93..bb27e36 100644
--- a/docker/Dockerfile.web
+++ b/docker/Dockerfile.web
@@ -69,3 +69,17 @@ EOT
 RUN cat > /etc/php5/cli/conf.d/00-legacy-polyfills.php.ini <<'EOT'
 auto_prepend_file=/var/www/html/legacy_polyfills.php
 EOT
+
+
+# SUMMIT_ISCLANMEMBER_ALIAS_V2
+# Compatibilidade Linux/PHP para a URL Classic ASP usada pelo cliente.
+# AliasMatch aceita também as barras duplicadas do protocolo legado.
+RUN printf '%s\n' \
+    'AliasMatch "^/+ServerMain/+isClanMember\.asp$" "/var/www/html/ServerMain/isClanMember.php"' \
+    '' \
+    '<LocationMatch "^/+ServerMain/+isClanMember\.asp$">' \
+    '    SetHandler application/x-httpd-php' \
+    '</LocationMatch>' \
+    > /etc/apache2/conf-available/summit-isclanmember.conf && \
+    a2enconf summit-isclanmember
+
