        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Depois que você chegar a level 40, não terá mais que falar comigo."
      },
      {
        "line": 13,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Estou aqui para ajudar os iniciantes a viver no continente de Priston."
      },
      {
        "line": 15,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "E só você para trazer de volta as conspirações e Igolanos."
