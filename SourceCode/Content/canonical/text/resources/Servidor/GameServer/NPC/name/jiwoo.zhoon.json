        "legacy_key": "J_Name",
        "kind": "name",
        "text": "Enzo, o Restaurador de Itens"
      },
      {
        "line": 7,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Vou lhe arranjar uns bons itens se você atender meus pedidos."
      },
