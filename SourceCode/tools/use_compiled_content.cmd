@echo off
rem Usage: call tools\use_compiled_content.cmd client|server [locale]
set "SUMMIT_CONTENT_PROFILE=%~1"
if "%SUMMIT_CONTENT_PROFILE%"=="" set "SUMMIT_CONTENT_PROFILE=server"
if /I not "%SUMMIT_CONTENT_PROFILE%"=="client" if /I not "%SUMMIT_CONTENT_PROFILE%"=="server" (
  echo invalid profile: %SUMMIT_CONTENT_PROFILE% ^(expected client or server^)
  exit /b 2
)
set "SUMMIT_CONTENT_ROOT=%~dp0..\Content\packs"
set "SUMMIT_TEXT_RESOURCE_PACK=%SUMMIT_CONTENT_ROOT%\text_resources.sres"
set "SUMMIT_DEFINITION_PACK=%SUMMIT_CONTENT_ROOT%\definitions.scfg"
set "SUMMIT_LOCALIZATION_PACK=%SUMMIT_CONTENT_ROOT%\localization.sloc"
set "SUMMIT_GAMEPLAY_CONFIG_PACK=%SUMMIT_CONTENT_ROOT%\gameplay_config.sgcf"
set "SUMMIT_STAGE_SPAWN_PACK=%SUMMIT_CONTENT_ROOT%\stage_spawns.sspb"
set "SUMMIT_MAP_PACK=%SUMMIT_CONTENT_ROOT%\maps_%SUMMIT_CONTENT_PROFILE%.smap"
if "%SUMMIT_CONTENT_STRICT%"=="" set "SUMMIT_CONTENT_STRICT=1"
set "SUMMIT_TEXT_RESOURCE_STRICT=%SUMMIT_CONTENT_STRICT%"
set "SUMMIT_DEFINITION_STRICT=%SUMMIT_CONTENT_STRICT%"
set "SUMMIT_LOCALIZATION_STRICT=%SUMMIT_CONTENT_STRICT%"
set "SUMMIT_GAMEPLAY_CONFIG_STRICT=%SUMMIT_CONTENT_STRICT%"
set "SUMMIT_STAGE_SPAWN_STRICT=%SUMMIT_CONTENT_STRICT%"
set "SUMMIT_MAP_STRICT=%SUMMIT_CONTENT_STRICT%"
if not "%~2"=="" set "SUMMIT_LOCALE=%~2"
echo Summit compiled content: profile=%SUMMIT_CONTENT_PROFILE% strict=%SUMMIT_CONTENT_STRICT% packs=%SUMMIT_CONTENT_ROOT%
