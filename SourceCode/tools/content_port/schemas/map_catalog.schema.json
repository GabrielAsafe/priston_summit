{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summit.local/schemas/map_catalog.schema.json",
  "title": "Summit Map Catalog v1",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "map_count",
    "maps"
  ],
  "properties": {
    "schema": {
      "const": "summit.map-catalog/v1"
    },
    "profile": {
      "enum": [
        "client",
        "server"
      ]
    },
    "map_count": {
      "type": "integer",
      "const": 53
    },
    "maps": {
      "type": "array",
      "minItems": 53,
      "maxItems": 53,
      "items": {
        "type": "object",
        "required": [
          "schema",
          "id",
          "legacy_field_code",
          "stage",
          "environment",
          "server",
          "start_points",
          "stage_objects",
          "gates",
          "warp_gates",
          "ambient"
        ],
        "properties": {
          "schema": {
            "const": "summit.map/v1"
          },
          "id": {
            "type": "string",
            "pattern": "^map\\.[a-z0-9_.-]+$"
          },
          "legacy_field_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 52
          },
          "stage": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "legacy_dynamic_field": {
      "type": "object",
      "required": [
        "field_code",
        "strategy"
      ],
      "properties": {
        "field_code": {
          "const": 53
        },
        "strategy": {
          "const": "legacy_runtime_config_fallback"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
