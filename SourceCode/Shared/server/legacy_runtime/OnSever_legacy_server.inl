bool recordCheatLog(rsPLAYINFO *player, const std::string &log)
{
	bool result = false;

	if(player && player->lpsmSock)
	{
		std::shared_ptr<SQLConnection> db = SQLConnection::GetConnection(DATABASEID_SecurityDB);

		if(db->Open())
		{
			if(db->Prepare("INSERT INTO CheatLog ([IP], [AccountName], [Description], [Date]) VALUES (?, ?, ?, GETDATE())"))
			{
				char accountId[32] = { 0 };

				string account = player->getAccount();

				if(account.empty())
					strcpy_s(accountId, sizeof(accountId), "<unknown>");
				else
					strcpy_s(accountId, sizeof(accountId), account.c_str());

				char szLog[256] = { 0 };
				strcpy_s(szLog, sizeof(szLog), log.c_str());

				db->BindInputParameter(player->lpsmSock->szIPAddr, 1, PARAMTYPE_String);
				db->BindInputParameter(accountId, 2, PARAMTYPE_String);
				db->BindInputParameter(szLog, 3, PARAMTYPE_String);

				db->Execute();
			}
		}

		db->Close();
	}

	return result;
}


bool banAccount(rsPLAYINFO *player)
{
	bool result = false;

	if(player)
	{
		std::shared_ptr<SQLConnection> db = SQLConnection::GetConnection(DATABASEID_AccountDB);

		if(db->Open())
		{
			char query[100] = { 0 };

			wsprintfA(query, "UPDATE %cGameUser SET BlockChk=1 WHERE userid=?", toupper(player->getAccount()[0]));

			if(db->Prepare(query))
			{
				char accountId[32] = { 0 };

				string account = player->getAccount();

				if(account.empty())
					strcpy_s(accountId, sizeof(accountId), "<unknown>");
				else
					strcpy_s(accountId, sizeof(accountId), account.c_str());

				db->BindInputParameter(accountId, 1, PARAMTYPE_String);

				db->Execute();
			}
		}

		db->Close();
	}

	return result;
}

void BannedIP(rsPLAYINFO* lpPlayInfo)
