					ZeroMemory(&tier5Sync, sizeof(tier5Sync));
					tier5Sync.code = OpCode::OPCODE_TIER5_LIVE_SYNC;
					tier5Sync.size = sizeof(tier5Sync);
					tier5Sync.WParam = CHARACTER_RANK5;
					tier5Sync.LParam = freeTier5Points;
					tier5Sync.SParam =
