INT SetupDefWindow()
{
	WNDCLASS windowClass = {};
	windowClass.lpfnWndProc = (WNDPROC)WndProc;
	windowClass.lpszClassName = szAppName;

	if(!RegisterClass(&windowClass))
	{
		std::cout << "Falha ao registrar window class" << std::endl;
		return FALSE;
	}

	hwnd = CreateWindow(szAppName, 0, 0, 0, 0, 0, 0, HWND_MESSAGE, 0, 0, 0);

	if(!hwnd)
	{
		std::cout << "Falha ao criar janela de message-only." << std::endl;
		return FALSE;
	}

	ServerMode = TRUE;
	szServer_DebugString[0] = 0;

	cout << "Lendo configuracoes do mundo..." << endl;
	rsRefreshConfig();

	cout << "Carregando CoinShop..." << endl;
	cCoinShop.LoadItems();

	cout << "Carregando TimeShop..." << endl;
	cCoinShop_T.LoadItems();

	cout << "Inicializando pacotes de conexao" << endl;
	InitGameSocket(TRUE);

	fprintf(stderr, "[MAIN] ANTES InitAll\n");
	fflush(stderr);

	int ret = InitAll();

	fprintf(stderr, "[MAIN] DEPOIS InitAll ret=%d\n", ret);
	fflush(stderr);

	if(!ret)
	{
		fprintf(stderr, "[MAIN] InitAll failed; socket will not be opened\n");
		return FALSE;
	}

	InitBindSock(SERVER_TCP_PORT);
	cout << "Servidor pronto para receber conexoes" << endl;

	cout << "Todos os sistemas foram inicializados com sucesso.!" << endl;
	cout << "O servidor estara pronto em segundos..." << endl;

	//temp change
	fprintf(stderr, "[SETUP] inicializacao concluida; retornando TRUE\n");
	fflush(stderr);

	Sleep(4 * 1000);
	// system("cls");

	return TRUE;
}

