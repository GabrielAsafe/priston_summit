STG_AREA	*StageArea;
int StageAreaCount = 0;


struct T5_CRY_PICKUP_TOKEN
{
	DWORD dwOwnerCode;
	DWORD dwItemCode;
	DWORD dwHead;
	DWORD dwChecksum;
	DWORD dwExpireTime;
};

static T5_CRY_PICKUP_TOKEN g_T5CryPickupToken[CONNECTMAX] = {};
static DWORD g_T5CrySpawnOwner[CONNECTMAX] = {};
static DWORD g_T5CryNextSpawn[CONNECTMAX] = {};

static int GetT5PlayInfoIndex(rsPLAYINFO* lpPlayInfo)
{
	if(!lpPlayInfo || lpPlayInfo < &rsPlayInfo[0] || lpPlayInfo >= &rsPlayInfo[CONNECTMAX])
		return -1;
	return (int)(lpPlayInfo - &rsPlayInfo[0]);
}

static void RegisterT5CryPickupToken(rsPLAYINFO* lpPlayInfo, const sITEMINFO* lpItem)
{
	int index = GetT5PlayInfoIndex(lpPlayInfo);
	if(index < 0 || !lpItem)
		return;

	g_T5CryPickupToken[index].dwOwnerCode = lpPlayInfo->dwObjectSerial;
	g_T5CryPickupToken[index].dwItemCode = lpItem->CODE;
	g_T5CryPickupToken[index].dwHead = lpItem->ItemHeader.Head;
	g_T5CryPickupToken[index].dwChecksum = lpItem->ItemHeader.dwChkSum;
	g_T5CryPickupToken[index].dwExpireTime = dwPlayServTime + (10 * 60 * 1000);
}

static bool IsT5CryPickupToken(rsPLAYINFO* lpPlayInfo, DWORD dwCode, DWORD dwHead, DWORD dwChecksum)
{
	int index = GetT5PlayInfoIndex(lpPlayInfo);
	if(index < 0)
		return false;

	T5_CRY_PICKUP_TOKEN& token = g_T5CryPickupToken[index];
	if(token.dwOwnerCode != lpPlayInfo->dwObjectSerial || token.dwExpireTime < dwPlayServTime)
		return false;

	return token.dwItemCode == dwCode && token.dwHead == dwHead && token.dwChecksum == dwChecksum;
}

static void ClearT5CryPickupToken(rsPLAYINFO* lpPlayInfo)
{
	int index = GetT5PlayInfoIndex(lpPlayInfo);
	if(index >= 0)
		ZeroMemory(&g_T5CryPickupToken[index], sizeof(T5_CRY_PICKUP_TOKEN));
}

static bool HasT5CryDropForOwner(STG_AREA* lpStgArea, DWORD dwOwnerCode)
{
	if(!lpStgArea || !dwOwnerCode)
		return false;

	for(int i = 0; i < STG_ITEM_MAX; i++)
	{
		STG_ITEMS* lpItem = &lpStgArea->StgItems[i];
		if(lpItem->state && lpItem->dwExclusiveOwnerCode == dwOwnerCode && lpItem->Item.ItemInfo.CODE == sinQT136)
			return true;
	}
	return false;
}

static bool SpawnT5CryDrop(rsPLAYINFO* lpPlayInfo)
{
	static const int sPosition[10][3] =
	{
		{ 11847, 689, -11369 }, { 12656, 680, -11186 }, { 12292, 666, -11969 },
		{ 12710, 704, -12841 }, { 12490, 750, -13400 }, { 12050, 772, -12850 },
		{ 11476, 674, -12603 }, { 11022, 680, -12027 }, { 11034, 683, -11426 },
		{ 11492, 685, -10823 }
	};

	if(!lpPlayInfo || !StageArea || lpPlayInfo->Position.Area != 10 || !StageArea[10].lpStage)
		return false;

	psITEM item = {};
	bool found = false;
	for(int i = 0; i < DefaultItemCount; i++)
	{
		if(DefaultItems[i].Item.CODE == sinQT136 && !DefaultItems[i].Item.UniqueItem)
		{
			CreateDefItem(&item.ItemInfo, &DefaultItems[i]);
			item.state = TRUE;
			found = true;
			break;
		}
	}
	if(!found)
		return false;

	int pos = rand() % 10;
	STG_ITEMS* lpStgItem = StageArea[10].AddItem(&item, sPosition[pos][0], sPosition[pos][1], sPosition[pos][2], TRUE);
	if(!lpStgItem)
		return false;

	lpStgItem->dwExclusiveOwnerCode = lpPlayInfo->dwObjectSerial;
	lpStgItem->dwLoseTime = dwPlayServTime + (10 * 60 * 1000);
	StageArea[10].SendStgItem(lpPlayInfo, lpStgItem);
	return true;
}

static void UpdateT5CryMeARiver()
{
	if(!StageArea || !StageArea[10].lpStage)
		return;

	DWORD hour = GetGameTimeHour();
	if(!(hour >= 18 || hour <= 4))
		return;

	for(int i = 0; i < CONNECTMAX; i++)
	{
		rsPLAYINFO* lpPlayInfo = &rsPlayInfo[i];
		if(!lpPlayInfo->lpsmSock || !lpPlayInfo->dwObjectSerial || lpPlayInfo->Position.Area != 10)
			continue;

		if(g_T5CrySpawnOwner[i] != lpPlayInfo->dwObjectSerial)
		{
			g_T5CrySpawnOwner[i] = lpPlayInfo->dwObjectSerial;
			g_T5CryNextSpawn[i] = 0;
			ClearT5CryPickupToken(lpPlayInfo);
		}

		if(!gameplay::quests::legacy::ServerLegacyQuestObjectiveService().IsInProgress(gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lpPlayInfo), gameplay::QuestId(QUESTID_T5_CRY_ME_A_RIVER)) ||
			!gameplay::quests::legacy::ServerLegacyQuestObjectiveService().HasPendingObjectives(gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lpPlayInfo), gameplay::QuestId(QUESTID_T5_CRY_ME_A_RIVER)))
			continue;

		if(g_T5CryNextSpawn[i] && (int)(dwPlayServTime - g_T5CryNextSpawn[i]) < 0)
			continue;

		if(HasT5CryDropForOwner(&StageArea[10], lpPlayInfo->dwObjectSerial))
			continue;

		if(SpawnT5CryDrop(lpPlayInfo))
			g_T5CryNextSpawn[i] = dwPlayServTime + (10 * 60 * 1000);
		else
			g_T5CryNextSpawn[i] = dwPlayServTime + 30000;
	}
}


