				cnt2 = (rsServerConfig.Event_NineFox * 80) / 100;
			}
		}

		if(rnd < cnt2)
		{

			if((rand() % 2) == 0)
				dwCode = (sinGF1 | sin03);
			else
				dwCode = (sinGF1 | sin04);

			if(dwCode)
			{

				for(cnt2 = 0; cnt2 < DefaultItemCount; cnt2++)
				{
					if(DefaultItems[cnt2].Item.CODE == dwCode && !DefaultItems[cnt2].Item.UniqueItem)
