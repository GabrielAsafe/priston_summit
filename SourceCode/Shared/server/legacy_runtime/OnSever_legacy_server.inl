int nStartUserLevel = 1;
vector<sStartUserItems> vStartUserItems;
vector<sStartUserExtraItems> vStartUserExtraItems;

void StartUser_PresentItem_Init()
{
	sStartUserItems items;
	sStartUserExtraItems eitems;

	std::shared_ptr<SQLConnection> db = SQLConnection::GetConnection(DATABASEID_StartUserDB);

	if (db->Open())
	{
		vStartUserItems.clear();
		vStartUserExtraItems.clear();

		if (db->Prepare("SELECT * FROM Level"))
		{
			if (db->Execute())
			{
				db->GetData(&nStartUserLevel, 0, 1, PARAMTYPE_Integer);
			}
		}

		if (db->Prepare("SELECT Classe, Weapon, Aging1, Mix1, Armor, Aging2, Mix2, Boots, Aging3, Mix3, Gloves, Aging4, Mix4, Bracelet, Aging5, Mix5, NULL AS Shield, 0 AS Aging6, 0 AS Mix6 FROM Items"))
		{
			if (db->Execute())
			{
				for (int i = 0; i < 11; i++)
				{
					ZeroMemory(&items, sizeof(sStartUserItems));

					db->GetData(&items.JobCode, 0, 1, PARAMTYPE_Integer);

					db->GetData(&items.Weapon, 32, 2, PARAMTYPE_String);
					db->GetData(&items.Aging1, 0, 3, PARAMTYPE_Integer);
					db->GetData(&items.Mix1, 0, 4, PARAMTYPE_Integer);

					db->GetData(&items.Armor, 32, 5, PARAMTYPE_String);
					db->GetData(&items.Aging2, 0, 6, PARAMTYPE_Integer);
					db->GetData(&items.Mix2, 0, 7, PARAMTYPE_Integer);

					db->GetData(&items.Boots, 32, 8, PARAMTYPE_String);
					db->GetData(&items.Aging3, 0, 9, PARAMTYPE_Integer);
					db->GetData(&items.Mix3, 0, 10, PARAMTYPE_Integer);

					db->GetData(&items.Gloves, 32, 11, PARAMTYPE_String);
					db->GetData(&items.Aging4, 0, 12, PARAMTYPE_Integer);
					db->GetData(&items.Mix4, 0, 13, PARAMTYPE_Integer);

					db->GetData(&items.Bracelet, 32, 14, PARAMTYPE_String);
					db->GetData(&items.Aging5, 0, 15, PARAMTYPE_Integer);
					db->GetData(&items.Mix5, 0, 16, PARAMTYPE_Integer);

					db->GetData(&items.Shield, 32, 17, PARAMTYPE_String);
					db->GetData(&items.Aging6, 0, 18, PARAMTYPE_Integer);
					db->GetData(&items.Mix6, 0, 19, PARAMTYPE_Integer);

					vStartUserItems.push_back(items);

					if (!db->NextRow())
						break;
				}
			}
		}

		if (db->Prepare("SELECT ItemCode FROM ExtraItems"))
		{
			if (db->Execute())
			{
				do
				{
					ZeroMemory(&eitems, sizeof(sStartUserExtraItems));
					eitems.Flag = 1;
					db->GetData(eitems.szItem, 32, 1, PARAMTYPE_String);
					vStartUserExtraItems.push_back(eitems);
				} while (db->NextRow());
			}
		}

		db->Close();
	}
}

