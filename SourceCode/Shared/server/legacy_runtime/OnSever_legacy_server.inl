		lpChar->SetMotionFromCode(CHRMOTION_STATE_WALK);
		lpChar->TargetMoveCount = 2;

		AddMonTable(lpChar);

		if(lprsFixedPoint)
			lpChar->ReopenCount = REOPEN_COUNT_NUM * 32;
