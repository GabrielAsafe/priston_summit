int RecvCommand(rsPLAYINFO *lpPlayInfo, char *szChatCommand)
{
	int cnt = 0;
	char *lpBuff = nullptr, *lpBuff2 = nullptr, *lpBuff3 = nullptr;
	char szCmdBuff[256] = { 0 };
	char szTempBuff[256] = { 0 };
	psITEM *lpsItem = nullptr;
	STG_AREA *lpStgArea = nullptr;
	TRANS_CHATMESSAGE TransChatMessage;
	rsPLAYINFO *lpPlayInfo2 = nullptr;
	smTRANS_COMMAND smTransCommand;
	smTRANS_CHAR_COMMAND smTransCharCommand;
	int Level1 = 0, Level2 = 0;
	int x = 0, z = 0;
	smCHAR *lpChar = nullptr;
	rsRECORD_DBASE *lpRecordBase = nullptr;


// =============================================================================
// AREA 04.1 - COMANDOS DE PLAYER
// TIPO: rede + gameplay
// FUNCIONAMENTO: Comandos normais de jogador; inclui interacoes de gathering/mining e utilitarios expostos pelo chat.
// FRONTEIRA: RED congelado; nao adicionar feature nova aqui.
// REGRA: manter ordem, fall-through, timers, efeitos colaterais e protocolo.
// =============================================================================

#pragma region Player Commands


	if(RouteModernChatIngress(lpPlayInfo, szChatCommand))
		return TRUE;

	int len = 0;

	len = rsCompString("/ativar", szChatCommand);

	if(len)
	{
		lpBuff = szChatCommand + len;
		lpBuff = rsGetWord(szCmdBuff, lpBuff);

		if(!szCmdBuff[0])
		{
			return FALSE;
		}

		AccountTypes security = handleSecurityCommand(lpPlayInfo, szCmdBuff);

		if(security != AccountTypes::SEC_PLAYER)
		{
			// Se o player já está com o POWER USER ativado e digitar o comando de ativação novamente, desativar.
			if(lpPlayInfo->getSecurity() > AccountTypes::SEC_PLAYER)
			{
				security = AccountTypes::SEC_PLAYER;
			}

			lpPlayInfo->AdminMode = static_cast<int>(security);

			smTransCommand.code = OpCode::OPCODE_AUTH_ADMIN_MODE;
			smTransCommand.size = sizeof(smTRANS_COMMAND);
			smTransCommand.WParam = (int)security;
			smTransCommand.LParam = 0;
			smTransCommand.SParam = 0;

			SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char *)&smTransCommand, smTransCommand.size);

			sprintf_s(szTempBuff, sizeof(szTempBuff), "GameMode Ativado! [nivel %d]", static_cast<int>(security));
			SendQuickMessage(lpPlayInfo, szTempBuff);
		}

		return TRUE;
	}

	len = rsCompString("/void", szChatCommand);
	if (len)
	{
		lpBuff = szChatCommand + len;

		lpBuff = rsGetWord(szCmdBuff, lpBuff);	//ID о
		if (!szCmdBuff[0])
			return FALSE;

		if (CreateCommandItem(lpPlayInfo, lpPlayInfo, szCmdBuff) == TRUE)
		{
			wsprintf(TransChatMessage.szMessage, "!", szCmdBuff);
			TransChatMessage.code = OpCode::OPCODE_WHISPERMESSAGE;
			TransChatMessage.size = 32 + lstrlen(TransChatMessage.szMessage);
			TransChatMessage.dwIP = 0;
			TransChatMessage.dwObjectSerial = 0;
			SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char*)&TransChatMessage, TransChatMessage.size);
		}
	}

	len = rsCompString("/T>", szChatCommand);

	if (len)
	{

		for (cnt = len; cnt < 100; cnt++)
		{
			if (szChatCommand[cnt] == 0)
				return TRUE;

			if (szChatCommand[cnt] != ' ')
			{
				len = cnt;
				break;
			}
		}

		wsprintf(lpPlayInfo->szChatMessage, srMsg_0110, lpPlayInfo->smCharInfo.szName, szChatCommand + len);
		lpPlayInfo->ChatMsgMode = 7;
		return -1;
	}


	len = rsCompString("//party", szChatCommand);

