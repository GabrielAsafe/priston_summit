		else
		{
			const int tier5QuestIDs[] =
			{
				QUESTID_T5_A_MATTER_OF_STRENGTH,
				QUESTID_T5_CRY_ME_A_RIVER,
				QUESTID_T5_THE_LAST_STAGE,
				QUESTID_T5_QUEST_ARENA
			};

