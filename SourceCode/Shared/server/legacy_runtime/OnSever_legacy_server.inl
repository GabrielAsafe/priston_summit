int SetMixItem(sITEMINFO* pItem, int mixNum)
{
	int MixNum = mixNum - 1;

	if (MixNum < 0) return FALSE;

	for (int i = 0; i < 8; i++)
	{
		if ((sCraftItem_Info[MixNum].MainItemCode[i] & sinITEM_MASK2) ==
			(pItem->CODE & sinITEM_MASK2))
		{
			for (int n = 0; n < 14; n++)
			{
				if (sCraftItem_Info[MixNum].AddItem[n])
					pItem->ItemAgingNum[0] = n + 1;
			}

			for (int j = 0; j < 9; j++)
			{
				if (sCraftItem_Info[MixNum].PlusElementCode[j])
				{
					switch (sCraftItem_Info[MixNum].PlusElementCode[j])
					{
					case SIN_ADD_FIRE:
						pItem->Resistance[sITEMINFO_FIRE] += (int)sCraftItem_Info[MixNum].AddElement[j];
						pItem->ItemKindMask |= SIN_ADD_FIRE;

						break;
					case SIN_ADD_ICE:
						pItem->Resistance[sITEMINFO_ICE] += (int)sCraftItem_Info[MixNum].AddElement[j];
						pItem->ItemKindMask |= SIN_ADD_ICE;
						break;
					case SIN_ADD_LIGHTNING:
						pItem->Resistance[sITEMINFO_LIGHTING] += (int)sCraftItem_Info[MixNum].AddElement[j];
						pItem->ItemKindMask |= SIN_ADD_LIGHTNING;
						break;

					case SIN_ADD_POISON:
						pItem->Resistance[sITEMINFO_POISON] += (int)sCraftItem_Info[MixNum].AddElement[j];
						pItem->ItemKindMask |= SIN_ADD_POISON;
						break;
					case SIN_ADD_BIO:
						pItem->Resistance[sITEMINFO_BIONIC] += (int)sCraftItem_Info[MixNum].AddElement[j];
						pItem->ItemKindMask |= SIN_ADD_BIO;
						break;
					case SIN_ADD_CRITICAL:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->Critical_Hit += (int)sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->Critical_Hit += (pItem->Critical_Hit * ((int)sCraftItem_Info[MixNum].AddElement[j])) / 100;

						pItem->ItemKindMask |= SIN_ADD_CRITICAL;
						break;
					case SIN_ADD_ATTACK_RATE:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->Attack_Rating += (int)sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->Attack_Rating += (pItem->Attack_Rating * ((int)sCraftItem_Info[MixNum].AddElement[j])) / 100;

						pItem->ItemKindMask |= SIN_ADD_ATTACK_RATE;
						break;
					case SIN_ADD_DAMAGE_MIN:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->Damage[0] += (int)sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->Damage[0] += (pItem->Damage[0] * ((int)sCraftItem_Info[MixNum].AddElement[j])) / 100;

						pItem->ItemKindMask |= SIN_ADD_DAMAGE_MIN;
						break;

					case SIN_ADD_DAMAGE_MAX:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->Damage[1] += (int)sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->Damage[1] += (pItem->Damage[1] * ((int)sCraftItem_Info[MixNum].AddElement[j])) / 100;

						pItem->ItemKindMask |= SIN_ADD_DAMAGE_MAX;
						break;
					case SIN_ADD_ATTACK_SPEED:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->Attack_Speed += (int)sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->Attack_Speed += (pItem->Attack_Speed * ((int)sCraftItem_Info[MixNum].AddElement[j])) / 100;

						pItem->ItemKindMask |= SIN_ADD_ATTACK_SPEED;
						break;
					case SIN_ADD_ABSORB:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fAbsorb += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fAbsorb += (GetItemAbsorb(pItem) * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_ABSORB;
						break;
					case SIN_ADD_DEFENCE:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->Defence += (int)sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->Defence += (pItem->Defence * ((int)sCraftItem_Info[MixNum].AddElement[j])) / 100;

						pItem->ItemKindMask |= SIN_ADD_DEFENCE;
						break;
					case SIN_ADD_BLOCK_RATE:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fBlock_Rating += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fBlock_Rating += (pItem->fBlock_Rating * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_BLOCK_RATE;
						break;
					case SIN_ADD_MOVE_SPEED:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fSpeed += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fSpeed += (pItem->fSpeed * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_MOVE_SPEED;
						break;

					case SIN_ADD_LIFE:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fIncrease_Life += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fIncrease_Life += (pItem->fIncrease_Life * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_LIFE;
						break;

					case SIN_ADD_MANA:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fIncrease_Mana += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fIncrease_Mana += (pItem->fIncrease_Mana * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_MANA;
						break;
					case SIN_ADD_STAMINA:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fIncrease_Stamina += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fIncrease_Stamina += (pItem->fIncrease_Stamina * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_STAMINA;
						break;
					case SIN_ADD_LIFEREGEN:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fLife_Regen += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fLife_Regen += (pItem->fLife_Regen * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_LIFEREGEN;
						break;
					case SIN_ADD_MANAREGEN:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fMana_Regen += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fMana_Regen += (pItem->fMana_Regen * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_MANAREGEN;

						break;
					case SIN_ADD_STAMINAREGEN:
						if (sCraftItem_Info[MixNum].ElementKind[j] == SIN_ADD_NUM)
							pItem->fStamina_Regen += sCraftItem_Info[MixNum].AddElement[j];
						else
							pItem->fStamina_Regen += (pItem->fStamina_Regen * (sCraftItem_Info[MixNum].AddElement[j] / 100));
						pItem->ItemKindMask |= SIN_ADD_STAMINAREGEN;

						break;

}
				}
			}

			ReformItem(pItem);

			if (!CheckMixItem(pItem))
			{
				SendSetHackUser(50);
				return FALSE;
			}

			pItem->ItemKindCode = ITEM_KIND_CRAFT;
			ReformMixItem(pItem);
			return TRUE;
		}
	}

	return FALSE;
}

#ifdef _XIGNCODE_SERVER

int rsXignCode_resultCode_Verify(rsPLAYINFO *lpPlayInfo, XIGNCODE_PACKET *packet)
{
	if(ZSWAVE_Verify(lpPlayInfo->Xigncode_tempdata.xigncode_handle, (CPACKETDATA)packet->data, sizeof(packet->data)) != TRUE)
	{

		char szReport[128];
		int result_data = ZSWAVE_VerifyEx(lpPlayInfo->Xigncode_tempdata.xigncode_handle, (char *)packet->data, sizeof(packet->data), szReport, sizeof(szReport));

		switch(result_data)
		{
		case Z_RTN_NONCLIENT:
			rsXignCode_recordLog(lpPlayInfo, 8930, Z_RTN_NONCLIENT, szReport);
			lpPlayInfo->dwHopeDisconnectTime = dwPlayServTime + 5000;
			break;

		case Z_RTN_BLACK_CODE:
			rsXignCode_recordLog(lpPlayInfo, 8930, Z_RTN_BLACK_CODE, szReport);
			lpPlayInfo->dwHopeDisconnectTime = dwPlayServTime + 5000;
			break;

		case Z_RTN_SUSPICIOUS:


			break;

		case Z_RTN_USERDEFINED:


			break;

		case Z_RTN_RESEND:
			lpPlayInfo->Xigncode_tempdata.m_ceComplete = FALSE;
			rsXignCode_recordLog(lpPlayInfo, 8930, Z_RTN_RESEND, szReport);
			break;

		default:
			break;
		}
	}


	ZSWAVE_Close(lpPlayInfo->Xigncode_tempdata.xigncode_handle);
	lpPlayInfo->Xigncode_tempdata.xigncode_handle = NULL;

	return TRUE;
}


int rsXignCode_recordLog(rsPLAYINFO *lpPlayInfo, int msg_num, int result_data, char *szReport)
{
	char *return_value[6] = {
			"0"
			"Z_RTN_NONCLIENT",
			"Z_RTN_BLACK_CODE",
			"Z_RTN_SUSPICIOUS",
			"Z_RTN_USERDEFINED",
			"Z_RTN_RESEND"
	};

	smTRANS_COMMAND		smTransCommand;
	smTransCommand.WParam = msg_num;
	smTransCommand.LParam = (DWORD)return_value[result_data - 1];
	smTransCommand.SParam = (DWORD)szReport;
	smTransCommand.EParam = result_data;
	RecordHackLogFile(lpPlayInfo, &smTransCommand);

	return TRUE;
}





int rsXignCode_selected_code_SendPacket(rsPLAYINFO *lpPlayInfo)
{
	XIGNCODE_PACKET pkt;
	memset(&pkt, 0, sizeof(pkt));
	int scan_Type = lpPlayInfo->Xigncode_tempdata.m_type;

	if(lpPlayInfo->Xigncode_tempdata.dwWaitTime_NC < dwPlayServTime + 1)
	{
		switch(scan_Type)
		{
		case 1:
			lpPlayInfo->Xigncode_tempdata.xigncode_handle = ZSWAVE_Open(PACKET_SIZE, Z_SCAN_TYPE_ANTI_CHEAT_ENGINE);
			lpPlayInfo->Xigncode_tempdata.m_pcount = ZSWAVE_GetDataCount(lpPlayInfo->Xigncode_tempdata.xigncode_handle);
			break;
		case 2:
			lpPlayInfo->Xigncode_tempdata.xigncode_handle = ZSWAVE_Open(PACKET_SIZE, Z_SCAN_TYPE_ANTI_NONECLIENTBOT);
			lpPlayInfo->Xigncode_tempdata.m_pcount = ZSWAVE_GetDataCount(lpPlayInfo->Xigncode_tempdata.xigncode_handle);
			break;
		default:
			break;
		}

		for(int i = 0; i < lpPlayInfo->Xigncode_tempdata.m_pcount; i++)
		{
			if(ZSWAVE_GetDataAt(lpPlayInfo->Xigncode_tempdata.xigncode_handle, i, (char *)pkt.data) != TRUE)
			{
				return FALSE;
			}

			pkt.code = OpCode::OPCODE_XIGNCODE_PACKET;
			pkt.size = sizeof(pkt);
			SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char *)&pkt, pkt.size);

			if(lpPlayInfo->Xigncode_tempdata.m_ceComplete == TRUE && scan_Type == Z_SCAN_TYPE_ANTI_CHEAT_ENGINE)
			{
				lpPlayInfo->CE_code_count++;
				break;
			}
		}

		if(scan_Type == Z_SCAN_TYPE_ANTI_CHEAT_ENGINE)
		{
			lpPlayInfo->Xigncode_tempdata.m_ceComplete = TRUE;
		}

		lpPlayInfo->Xigncode_tempdata.dwWaitTime_NC = lpPlayInfo->Xigncode_tempdata.dwWaitTime_NC + (1000 * 60);

		if(lpPlayInfo->Xigncode_tempdata.m_type == 2)
		{
			lpPlayInfo->Xigncode_tempdata.m_type = 1;
		}
		else if(lpPlayInfo->Xigncode_tempdata.m_type == 1 && lpPlayInfo->CE_code_count == 10)
		{
			lpPlayInfo->CE_code_count = 0;
			lpPlayInfo->Xigncode_tempdata.m_type = 2;
		}

	}

	return TRUE;
}

