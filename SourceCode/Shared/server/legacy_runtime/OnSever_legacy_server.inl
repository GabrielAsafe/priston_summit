int AtualizaTopPVP(rsPLAYINFO* ReiPVP) {
	rsPLAYINFO* player = nullptr;
	smTRANS_COMMAND smTransCommand;
	int iCountPlayerTopLevel = 0;
	int top = 0;


	std::shared_ptr<SQLConnection> db = SQLConnection::GetConnection(DATABASEID_ServerDB);

	if (db->Open())
	{
		if (db->Prepare("SELECT TOP 1 * FROM PVP WHERE Class=?  ORDER BY Lvl DESC"))
		{
			char szString1[32] = { 0 };

			db->BindInputParameter(&ReiPVP->smCharInfo.JOB_CODE, 1, PARAMTYPE_Integer);
			if (db->Execute()) {

				db->GetData(szString1, 32, 2, PARAMTYPE_String);


				if (strcmp(ReiPVP->getName(), szString1) == 0) {
					smTransCommand.code = OpCode::PLAYER_TOP_LEVEL;
					smTransCommand.size = sizeof(smTRANS_COMMAND);
					smTransCommand.SParam = 1;
					ReiPVP->topLevelFlag = true;
					SendOnServerLegacySocket(ReiPVP->lpsmSock, (char*)&smTransCommand, smTransCommand.size);
				}


				smTransCommand.code = OpCode::PLAYER_TOP_LEVEL;
				smTransCommand.size = sizeof(smTRANS_COMMAND);
				smTransCommand.SParam = 0;

				for (int i = 0; i < CONNECTMAX; i++) {
					if (rsPlayInfo[i].lpsmSock && strcmp(rsPlayInfo[i].smCharInfo.szName, szString1) != 0) {
						SendOnServerLegacySocket(rsPlayInfo[i].lpsmSock, (char*)&smTransCommand, smTransCommand.size);
					}
				}

			}
			db->Close();
		}
	}

	return 0;
}

