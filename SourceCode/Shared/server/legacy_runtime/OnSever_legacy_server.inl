int InitItems()
{
	const int ItemCodeMapCount =
		InitializeServerItemCodeMap();

	fprintf(
		stderr,
		"[STARTUP][ITEM_CODE_MAP] populated=%d\n",
		ItemCodeMapCount);
	fflush(stderr);

	HANDLE hFindHandle;
	WIN32_FIND_DATA	fd;
	char	szFindPath[64];
	char	szFilePath[64];
	sDEF_ITEMINFO	DefItem;

	FILE *fpItemAudit = fopen("server_startup_items.log", "wt");

	fprintf(stderr, "[STARTUP][ITEMS] BEGIN\n");
	fflush(stderr);

	if(fpItemAudit)
	{
		fprintf(fpItemAudit, "=== ITEM LOAD BEGIN ===\n");
		fprintf(fpItemAudit, "ItemPath=%s\n", ItemPath);
	}

	DefaultItemCount = 0;

	fprintf(stderr, "[CONTENT][DEFINITION] pack=%s\n", summit::content::definition::DefinitionPackPath());
	fflush(stderr);

	bool summitCompiledItems=false;
	if(summit::content::definition::CompiledDefinitionsEnabled())
	{
		std::vector<summit::content::definition::DefinitionEntry> entries;
		if(summit::content::definition::ListCompiledDefinitions(ItemPath, ".txt", true, entries, summit::content::definition::DefinitionKindOpenItem))
		{
			summitCompiledItems=true;
			if(fpItemAudit) fprintf(fpItemAudit, "Source=SCFG count=%u\n\n", (unsigned)entries.size());
			for(std::size_t index=0; index<entries.size() && DefaultItemCount<DEF_ITEM_MAX; ++index)
			{
				strcpy_s(szFilePath, entries[index].logicalPath.c_str());
				if(fpItemAudit) fprintf(fpItemAudit, "[BEFORE] INDEX=%d FILE=%s ID=%s\n", DefaultItemCount, szFilePath, entries[index].contentId.c_str());
				if(!DecodeItemInfo(szFilePath, &DefaultItems[DefaultItemCount])) { fprintf(stderr,"[STARTUP][ITEMS] DECODE_FAIL path=%s id=%s\n",szFilePath,entries[index].contentId.c_str());fflush(stderr); if(summit::content::definition::DefinitionStrictMode()) { if(fpItemAudit) fclose(fpItemAudit); return FALSE; } else continue; }
				if(fpItemAudit) fprintf(fpItemAudit, "[AFTER ] INDEX=%d CODE=0x%08lX NAME=\"%s\" ITEM_INDEX=%d UNIQUE=0x%08lX PRICE=%d LEVEL=%d\n", DefaultItemCount,(unsigned long)DefaultItems[DefaultItemCount].Item.CODE,DefaultItems[DefaultItemCount].Item.ItemName,DefaultItems[DefaultItemCount].Item.Index,(unsigned long)DefaultItems[DefaultItemCount].Item.UniqueItem,DefaultItems[DefaultItemCount].Item.Price,DefaultItems[DefaultItemCount].Item.Level);
				memcpy(&DefItem,&DefaultItems[DefaultItemCount],sizeof(sDEF_ITEMINFO)); SetLowerItem(&DefItem); DefItem.Item.BackUpKey=0; DefItem.Item.BackUpChkSum=0; DefItem.Item.dwCreateTime=0;
				DefaultItems[DefaultItemCount].DefCompressDataLen=EecodeCompress((BYTE *)&DefItem.Item,(BYTE *)DefaultItems[DefaultItemCount].DefCompressData,sizeof(sITEMINFO),sizeof(DefaultItems[DefaultItemCount].DefCompressData));
				if(fpItemAudit) fprintf(fpItemAudit, "[COMP  ] INDEX=%d LEN=%d\n\n",DefaultItemCount,DefaultItems[DefaultItemCount].DefCompressDataLen); DefaultItemCount++;
			}
		}
		else if(summit::content::definition::DefinitionStrictMode()) { const summit::content::definition::CompiledDefinitionSource *source=summit::content::definition::ActiveDefinitionSource(); fprintf(stderr,"[CONTENT][DEFINITION] LIST_FAIL error=%s\n",source?source->LastError().c_str():"source unavailable");fflush(stderr); if(fpItemAudit) fclose(fpItemAudit); return FALSE; }
	}
	if(!summitCompiledItems)
	{
	strcpy_s(szFindPath, ItemPath);
	lstrcat(szFindPath, "*.txt");

	if(fpItemAudit)
		fprintf(fpItemAudit, "SearchPattern=%s\n\n", szFindPath);

	hFindHandle = FindFirstFile(szFindPath, &fd);

	if(hFindHandle == INVALID_HANDLE_VALUE)
	{
		fprintf(stderr,
			"[STARTUP][ITEMS] WARNING: FindFirstFile failed for %s error=%lu\n",
			szFindPath,
			(unsigned long)GetLastError());
		fflush(stderr);

		if(fpItemAudit)
		{
			fprintf(fpItemAudit,
				"FIND_FIRST_FILE_FAILED error=%lu\n",
				(unsigned long)GetLastError());
		}
	}
	else
	{
		while(1)
		{
			strcpy_s(szFilePath, ItemPath);
			lstrcat(szFilePath, fd.cFileName);

			if(fpItemAudit)
			{
				fprintf(fpItemAudit,
					"[BEFORE] INDEX=%d FILE=%s\n",
					DefaultItemCount,
					szFilePath);
			}

			DecodeItemInfo(
				szFilePath,
				&DefaultItems[DefaultItemCount]);

			if(fpItemAudit)
			{
				fprintf(fpItemAudit,
					"[AFTER ] INDEX=%d CODE=0x%08lX NAME=\"%s\" "
					"ITEM_INDEX=%d UNIQUE=0x%08lX PRICE=%d LEVEL=%d\n",
					DefaultItemCount,
					(unsigned long)DefaultItems[DefaultItemCount].Item.CODE,
					DefaultItems[DefaultItemCount].Item.ItemName,
					DefaultItems[DefaultItemCount].Item.Index,
					(unsigned long)DefaultItems[DefaultItemCount].Item.UniqueItem,
					DefaultItems[DefaultItemCount].Item.Price,
					DefaultItems[DefaultItemCount].Item.Level);
			}

			memcpy(
				&DefItem,
				&DefaultItems[DefaultItemCount],
				sizeof(sDEF_ITEMINFO));

			SetLowerItem(&DefItem);

			DefItem.Item.BackUpKey = 0;
			DefItem.Item.BackUpChkSum = 0;
			DefItem.Item.dwCreateTime = 0;

			DefaultItems[DefaultItemCount].DefCompressDataLen =
				EecodeCompress(
					(BYTE *)&DefItem.Item,
					(BYTE *)DefaultItems[DefaultItemCount].DefCompressData,
					sizeof(sITEMINFO),
					sizeof(DefaultItems[DefaultItemCount].DefCompressData));

			if(fpItemAudit)
			{
				fprintf(fpItemAudit,
					"[COMP  ] INDEX=%d LEN=%d\n\n",
					DefaultItemCount,
					DefaultItems[DefaultItemCount].DefCompressDataLen);
			}

			DefaultItemCount++;

			if(FindNextFile(hFindHandle, &fd) == FALSE)
				break;

			if(DefaultItemCount >= DEF_ITEM_MAX)
			{
				fprintf(stderr,
					"[STARTUP][ITEMS] WARNING: DEF_ITEM_MAX reached (%d)\n",
					DefaultItemCount);
				fflush(stderr);

				if(fpItemAudit)
					fprintf(fpItemAudit,
						"DEF_ITEM_MAX_REACHED=%d\n",
						DefaultItemCount);

				break;
			}
		}

		FindClose(hFindHandle);
	}

	}

	if(fpItemAudit)
	{
		fprintf(fpItemAudit, "\n=== ITEM LOAD SUMMARY ===\n");
		fprintf(fpItemAudit, "DEFAULT_ITEM_COUNT=%d\n", DefaultItemCount);
		fprintf(fpItemAudit, "=== ITEM LOAD END ===\n");
		fclose(fpItemAudit);
	}

	fprintf(stderr,
		"[STARTUP][ITEMS] END count=%d\n",
		DefaultItemCount);
	fflush(stderr);

	return TRUE;
}


char *SetFieldInfoPath(char *SaveBuff, char *szFieldPath, char *InfoExt)
{
	int cnt;
	int len;
	char *szFile;

	len = lstrlen(szFieldPath);
	cnt = len - 1;

	szFile = szFieldPath;

	while(cnt > 0)
	{
		if(szFieldPath[cnt] == '/' || szFieldPath[cnt] == '\\') // BUGFIX_002_NPC_FIELD_PATH
		{
			szFile = &szFieldPath[cnt + 1];
			break;
		}
		cnt--;
	}

	wsprintf(SaveBuff, "%s%s.%s", szFieldInfoPath, szFile, InfoExt);

	return SaveBuff;
}


