// Companion V43: server-authoritative ground pickup bridge.  Keep this path
// deliberately aligned with the legacy OPCODE_PUTITEM handling: the owner
// receives the same TRANS_ITEMINFO/security code and the normal client path
// either stores the item or throws it back to the field when it cannot fit.
// The companion never owns a second inventory.
int rsCompanionPickupStageItem(rsPLAYINFO *lpPlayInfo, STG_AREA *lpStgArea, STG_ITEMS *lpStgItem)
{
    if(!lpPlayInfo || !lpPlayInfo->lpsmSock || !lpStgArea || !lpStgItem || !lpStgItem->state)
        return FALSE;

    if(lpStgItem->dwExclusiveOwnerCode &&
       lpStgItem->dwExclusiveOwnerCode != lpPlayInfo->dwObjectSerial)
        return FALSE;

    // Preserve special SoD catch semantics instead of turning the event token
    // into a normal inventory item.
    if((lpStgItem->Item.ItemInfo.CODE & sinITEM_MASK2) == sinSD2)
    {
        rsSoD_CatchItem(lpStgItem->Item.ItemInfo.CODE, lpPlayInfo);
        lpStgArea->DeleteItem(lpStgItem);
        return TRUE;
    }

    // Party gold has its own authoritative splitter and must not be converted
    // into a private owner pickup by the companion.
    if(lpPlayInfo->dwPartyInfo &&
       lpStgItem->Item.ItemInfo.CODE == (sinGG1 | sin01) &&
       lpStgItem->Item.ItemInfo.Money < 10000)
    {
        if(!lpPlayInfo->lpPartyMaster ||
           lpPlayInfo->lpPartyMaster->GetPartyMoney(&lpStgItem->Item.ItemInfo, lpPlayInfo) == FALSE)
        {
            SummitOnServerClearPartyMembership(lpPlayInfo);
        }
        lpStgArea->DeleteItem(lpStgItem);
        return TRUE;
    }

    TRANS_ITEMINFO transItemInfo;
    ZeroMemory(&transItemInfo, sizeof(transItemInfo));
    transItemInfo.code = OpCode::OPCODE_PUTITEM;
    transItemInfo.size = sizeof(TRANS_ITEMINFO);
    memcpy(&transItemInfo.Item, &lpStgItem->Item.ItemInfo, sizeof(sITEMINFO));

    if(lpStgItem->Item.ItemInfo.CODE == (sinGG1 | sin01))
    {
        lpPlayInfo->spMoney_Out += lpStgItem->Item.ItemInfo.Money;
        transItemInfo.x = dwPlayServTime;
        transItemInfo.y = transItemInfo.Item.ItemHeader.dwChkSum;
        transItemInfo.z = lpPlayInfo->spMoney_Out ^ (transItemInfo.x + transItemInfo.y);
    }

    if(lpStgItem->Item.ItemInfo.CODE == (sinGG1 | sin05))
        (void)SummitOnServerCreditCoins(lpPlayInfo, lpStgItem->Item.ItemInfo.Money, gameplay::commerce::CoinReason::Pickup);

    if(lpStgItem->dwExclusiveOwnerCode == lpPlayInfo->dwObjectSerial &&
       lpStgItem->Item.ItemInfo.CODE == sinQT136)
        RegisterT5CryPickupToken(lpPlayInfo, &lpStgItem->Item.ItemInfo);

    rsRegist_ItemSecCode(lpPlayInfo, &transItemInfo, lpStgItem->BeginMode);
    SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char *)&transItemInfo, transItemInfo.size);

    if((lpStgItem->Item.ItemInfo.CODE & sinITEM_MASK3) >= sin09 ||
       ((lpStgItem->Item.ItemInfo.CODE & sinITEM_MASK2) == sinOS1 &&
        (lpStgItem->Item.ItemInfo.CODE & sinITEM_MASK3) >= sin05))
        RecordGetHighItem(lpPlayInfo, lpStgItem);

    if(lpStgItem->BeginMode)
    {
        TRANS_CHATMESSAGE transChatMessage;
        ZeroMemory(&transChatMessage, sizeof(transChatMessage));
        wsprintf(transChatMessage.szMessage, srMsg_037,
            lpPlayInfo->smCharInfo.szName, lpStgItem->Item.ItemInfo.ItemName);
        if(lpPlayInfo->dwPartyInfo && rsServerConfig.Enable_PartyItem && lpPlayInfo->lpPartyMaster)
            lpPlayInfo->lpPartyMaster->SendPartyMessage(transChatMessage.szMessage, 9);
        else
            lpPlayInfo->SendPartyMessage(transChatMessage.szMessage, 9);
    }

    // Delete only after the secure owner packet has been queued.  If the
    // client's grid/weight check cannot accept it, sinSetInvenItem follows the
    // established legacy path and throws the same item back to the field.
    lpStgArea->DeleteItem(lpStgItem);
    return TRUE;
}


int STG_AREA::SendStgItems()
{
	int cnt;

	for(cnt = 0; cnt < CONNECTMAX; cnt++)
	{
		if(rsPlayInfo[cnt].lpsmSock && rsPlayInfo[cnt].dwObjectSerial && (dwPlayServTime - rsPlayInfo[cnt].dwLastRecvTime) < OVER_TRANS_TIME)
		{

			SendStgItem(&rsPlayInfo[cnt]);
		}
	}

	return TRUE;
}




int STG_AREA::SendStartPos(rsPLAYINFO *lpPlayInfo)
{
	smTRANS_ITEMS	TransItems;
	int cnt, scnt;
	int dx, dz, dist;

	cnt = 0;
	scnt = 0;

	StartPointActiveCount = 0;
	StartPointOpenCount = 0;

	while(1)
	{
		if(scnt >= TRANS_ITEM_MAX) break;
		if(cnt >= STG_START_POINT_MAX) break;

		if(StartPoint[cnt].state)
		{
			dx = StartPoint[cnt].x - (lpPlayInfo->Position.x >> FLOATNS);
			dz = StartPoint[cnt].z - (lpPlayInfo->Position.z >> FLOATNS);

			dist = dx*dx + dz*dz;

			if(dist < DIST_TRANSLEVEL_CONNECT && abs(dx) < TRANS_VIEW_LIMIT && abs(dz) < TRANS_VIEW_LIMIT)
			{

				StartPointNearPlay[cnt] ++;

				if(lpPlayInfo->getSecurity() >= AccountTypes::SEC_ADMINISTRATOR)
				{
					TransItems.Items[scnt].state = StartPoint[cnt].state;
					TransItems.Items[scnt].x = StartPoint[cnt].x << FLOATNS;
					TransItems.Items[scnt].y = 0;
					TransItems.Items[scnt].z = StartPoint[cnt].z << FLOATNS;
					TransItems.Items[scnt].ItemCode = 0;
					TransItems.Items[scnt].lpStgArea = (void *)this;


#ifdef _LANGUAGE_KOREAN
					wsprintf(TransItems.Items[scnt].szName, szMonsterFlagMsg, cnt, StartPointMonCount[cnt]);
#else
					strcpy_s(TransItems.Items[scnt].szName, szMonsterFlagMsg);
#endif
					scnt++;
				}
			}

			if(StartPointNearPlay[cnt])	StartPointActiveCount++;
			StartPointOpenCount++;

		}


		cnt++;
	}

	if(lpPlayInfo->getSecurity() >= AccountTypes::SEC_ADMINISTRATOR)
	{
		TransItems.code = OpCode::OPCODE_PLAYITEM;
		TransItems.size = sizeof(TRANS_ITEM)*scnt + 16;
		TransItems.state = 1;
		TransItems.Count = scnt;

		if(scnt > 0 && lpPlayInfo && lpPlayInfo->lpsmSock)
			return SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char *)&TransItems, TransItems.size);
	}
	return TRUE;
}

int STG_AREA::LoadStartPoint(char *szFile)
{
	if(!szFile) return FALSE;
	ZeroMemory(StartPoint, sizeof(StartPoint));

	static const std::string fieldPackPath = summit::content::runtime::ResolveRuntimePackPath("field_runtime.sfld");
	summit::content::field_runtime::CompiledFieldRuntimeSource source(fieldPackPath.c_str());
	summit::content::field_runtime::StageStartPointSet points;
	std::string fieldError;
	if(!source.IsValid() || !source.LoadStartPoints(szFile, points, &fieldError))
		return FALSE;

	for(std::size_t i=0; i<points.points.size(); ++i)
	{
		const summit::content::field_runtime::StageStartPointPlacement &src = points.points[i];
		if(src.slot >= STG_START_POINT_MAX || src.state == 0) return FALSE;
		StartPoint[src.slot].state = src.state;
		StartPoint[src.slot].x = src.x;
		StartPoint[src.slot].z = src.z;
	}
	dwActiveMode |= 1;
	return TRUE;
}

int STG_AREA::SaveStartPoint(char *szFile)
{
	// Legacy .spp persistence is intentionally disabled after the field pack port.
	(void)szFile;
	return FALSE;
}


int	STG_AREA::FindEmptyMonTable()
{
	int cnt;

	for(cnt = 0; cnt < STG_MONSTER_MAX; cnt++)
	{
		if(lpCharMonster[cnt] == 0) return cnt;
	}

	return -1;
}


int	STG_AREA::AddMonTable(smCHAR *lpChar)
{
	int	cnt;
	int mtab;


	StartPointMonCount[lpChar->OpenStartPostion] ++;

	mtab = FindEmptyMonTable();
	if(mtab >= 0)
	{
		lpCharMonster[mtab] = lpChar;
		lpChar->lpExt4 = this;

		MonsterLastPoint = mtab;
		for(cnt = mtab; cnt < STG_MONSTER_MAX; cnt++)
		{
			if(lpCharMonster[cnt])
				MonsterLastPoint = cnt + 1;
		}
		return TRUE;
	}

	return FALSE;
}


int	STG_AREA::DeleteMonTable(smCHAR *lpChar)
{
	int cnt;



	if(StartPointMonCount[lpChar->OpenStartPostion] > 0)
		StartPointMonCount[lpChar->OpenStartPostion] --;

	for(cnt = 0; cnt < MonsterLastPoint; cnt++)
	{
		if(lpCharMonster[cnt] == lpChar)
		{
			lpCharMonster[cnt] = NULL;
			return TRUE;
		}
	}

	return FALSE;
}


smCHAR *STG_AREA::OpenMonster(STG_CHAR_INFO *lpStgCharInfo, int gGroup)
{

	smCHAR *lpChar;
	int dist;
	int x, y, z;
	int cnt;



	lpChar = srFindEmptyChar();
	if(!lpChar) return NULL;


	if(SetStartPosChar(lpChar) == TRUE)
	{
		MonsterCount++;
		lpChar->lpExt1 = (void *)&Head;
		lpChar->dwObjectSerial = GetNewObjectSerial();
		lpChar->ActionPattern = 5;
		memcpy(&lpChar->smCharInfo, &lpStgCharInfo->smCharInfo, sizeof(smCHAR_INFO));
		memcpy(&lpChar->smMonsterInfo, lpStgCharInfo->smCharInfo.lpMonInfo, sizeof(smCHAR_MONSTER_INFO));
