bool recordAttack(rsPLAYINFO* player, const std::string& log)
{
	bool result = false;

	if (player && player->lpsmSock)
	{
		std::shared_ptr<SQLConnection> db = SQLConnection::GetConnection(DATABASEID_SecurityDB);

		if (db->Open())
		{
			if (db->Prepare("INSERT INTO Security ([AccountId], [IP], [Date], [Protocol]) VALUES (?, ?, GETDATE(), ?)"))
			{
				char* buffer = new char[log.size() + 1];

				strcpy_s(buffer, log.size(), log.c_str());

				buffer[log.size()] = 0;

				char szString[32] = { 0 };

				strcpy_s(szString, sizeof(szString), player->getAccount());

				db->BindInputParameter(szString, 1, PARAMTYPE_String);
				db->BindInputParameter(player->lpsmSock->szIPAddr, 2, PARAMTYPE_String);
				db->BindInputParameter(buffer, 3, PARAMTYPE_String);


				db->Execute();

				if (buffer)
				{
					delete[] buffer;
					buffer = nullptr;
				}

				result = true;
			}
			else
			{
				result = false;
			}

			db->Close();
		}
	}

