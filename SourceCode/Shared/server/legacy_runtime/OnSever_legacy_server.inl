static void SummitApplyFixedNpcIdentity(
	smCHAR_INFO &target,
	const smCHAR_INFO &decoded,
	const smCHAR_MONSTER_INFO &decodedMonster)
{
	// Fixed-NPC packets are materialized before OpenNpc() decodes the definition
	// into a live character. Preserve the safe identity fields required by
	// client interaction/UI, including localized names and quest class codes.
	// Never copy decoded.lpMonInfo: it can point at the temporary monster record.
	if(decodedMonster.szName[0])
		strcpy_s(target.szName, decodedMonster.szName);
	else if(decoded.szName[0])
		strcpy_s(target.szName, decoded.szName);

	if(decoded.szModelName[0])
		strcpy_s(target.szModelName, decoded.szModelName);
	target.ModelNameCode2 = decoded.ModelNameCode2;
	target.ClassClan = decoded.ClassClan;
	target.SizeLevel = decoded.SizeLevel;
	target.dwCharSoundCode = decoded.dwCharSoundCode;
	target.JOB_CODE = decoded.JOB_CODE;
	target.Level = decoded.Level;
	target.Brood = decoded.Brood;
	target.ChangeJob = decoded.ChangeJob;
	target.JobBitMask = decoded.JobBitMask;
	target.wPlayClass[0] = decoded.wPlayClass[0];
	target.wPlayClass[1] = decoded.wPlayClass[1];
}

static void SummitApplyFixedNpcLocalizedName(smCHAR_INFO &target, const std::string &npcId)
{
	if(npcId.empty()) return;
	std::string localized;
	const std::string key = npcId + ".name";
	if(summit::content::localization::GetLocalizationLegacyValue(key.c_str(), localized) &&
		!localized.empty() && localized.size() < sizeof(target.szName))
		std::memcpy(target.szName, localized.c_str(), localized.size() + 1);
}

int STG_AREA::LoadCharInfoFixed(char *szFile)
{
	if(!szFile) return FALSE;
	ZeroMemory(TransCharFixed, sizeof(TransCharFixed));

	static const std::string fieldPackPath = summit::content::runtime::ResolveRuntimePackPath("field_runtime.sfld");
	summit::content::field_runtime::CompiledFieldRuntimeSource source(fieldPackPath.c_str());
	summit::content::field_runtime::FixedNpcSet placements;
	std::string fieldError;
	if(!source.IsValid() || !source.LoadFixedNpcs(szFile, placements, &fieldError))
		return FALSE;

	for(std::size_t i=0; i<placements.npcs.size(); ++i)
	{
		const summit::content::field_runtime::FixedNpcPlacement &src = placements.npcs[i];
		if(src.slot >= FIX_CHAR_MAX || src.definitionPath.empty() || src.definitionPath.size() >= sizeof(TransCharFixed[0].smCharInfo.szModelName2))
			return FALSE;

		smTRNAS_PLAYERINFO &dst = TransCharFixed[src.slot];
		ZeroMemory(&dst, sizeof(dst));
		dst.size = sizeof(smTRNAS_PLAYERINFO);
		// Match the packet marker used by the legacy SPC records.  The loader only
		// needs a non-zero value to open the slot, but keeping the canonical opcode
		// avoids changing legacy semantics for code that inspects the fixed record.
		dst.code = smTRANSCODE_ADD_NPC;
		dst.x = src.x; dst.y = src.y; dst.z = src.z;
		dst.ax = src.ax; dst.ay = src.ay; dst.az = src.az; dst.state = src.state;

		// A legacy SPC stores a pre-materialized smCHAR_INFO snapshot.  NPC
		// definitions usually do not contain a Life directive, so zeroing the whole
		// record made the reconstructed NPC arrive at the client with Life=0.  The
		// client rejects mouse interaction with any character whose current life is
		// non-positive.  Seed the historical neutral-NPC baseline before smCharDecode;
		// an explicit definition directive still overrides these values.
		dst.smCharInfo.State = smCHAR_STATE_NPC;
		dst.smCharInfo.Life[0] = 100;
		dst.smCharInfo.Life[1] = 100;
		std::memcpy(dst.smCharInfo.szModelName2, src.definitionPath.c_str(), src.definitionPath.size() + 1);

		// Preserve the one pre-open field still consulted by legacy day/night logic.
		smCHAR_INFO decodedInfo = {};
		smCHAR_MONSTER_INFO decodedMonster = {};
		char decodedDialog[256] = {0};
		if(!smCharDecode(dst.smCharInfo.szModelName2, &decodedInfo, &decodedMonster, decodedDialog, sizeof(decodedDialog)))
			return FALSE;
		SummitApplyFixedNpcIdentity(dst.smCharInfo, decodedInfo, decodedMonster);
		SummitApplyFixedNpcLocalizedName(dst.smCharInfo, src.npcId);
	}

	// PATCH 185: Amanda is an instructor (class 1014), not the Enzo restorer.
	// The field-runtime canonical placement family was dropped from the final
	// integration bundle even though this loader still consumes field_runtime.sfld.
	// Keep Pillai playable by adding the canonical Amanda placement as a narrow
	// runtime overlay until fixed_npcs authoring is materialized again. Never
	// overwrite a packed slot: use the first free fixed-NPC slot.
	const char *fieldBase = szFile;
	for(const char *scan = szFile; *scan; ++scan)
		if(*scan == '/' || *scan == '\\') fieldBase = scan + 1;
	if(_stricmp(fieldBase, "pilai.ase.spc") == 0 || _stricmp(fieldBase, "pillai.ase.spc") == 0)
	{
		int amandaSlot = -1;
		bool amandaPresent = false;
		for(int slot = 0; slot < FIX_CHAR_MAX; ++slot)
		{
			if(TransCharFixed[slot].code == 0 && amandaSlot < 0) amandaSlot = slot;
			if(TransCharFixed[slot].code &&
				_stricmp(TransCharFixed[slot].smCharInfo.szModelName2, "GameServer/NPC/ji_woo.npc") == 0)
				amandaPresent = true;
		}

		if(!amandaPresent && amandaSlot >= 0)
		{
			smTRNAS_PLAYERINFO &dst = TransCharFixed[amandaSlot];
			ZeroMemory(&dst, sizeof(dst));
			dst.size = sizeof(smTRNAS_PLAYERINFO);
			dst.code = smTRANSCODE_ADD_NPC;
			// 32 stage units west of the existing Pillai service-NPC cluster.
			dst.x = 260757; dst.y = 167424; dst.z = 19485184;
			dst.ax = 0; dst.ay = 1579; dst.az = 0; dst.state = 0;
			dst.smCharInfo.State = smCHAR_STATE_NPC;
			dst.smCharInfo.Life[0] = 100;
			dst.smCharInfo.Life[1] = 100;
			const char *definitionPath = "GameServer/NPC/ji_woo.npc";
			std::memcpy(dst.smCharInfo.szModelName2, definitionPath, std::strlen(definitionPath) + 1);

			smCHAR_INFO decodedInfo = {};
			smCHAR_MONSTER_INFO decodedMonster = {};
			char decodedDialog[256] = {0};
			if(!smCharDecode(dst.smCharInfo.szModelName2, &decodedInfo, &decodedMonster, decodedDialog, sizeof(decodedDialog)))
				return FALSE;
			SummitApplyFixedNpcIdentity(dst.smCharInfo, decodedInfo, decodedMonster);
			SummitApplyFixedNpcLocalizedName(dst.smCharInfo, "npc.ji_woo");
		}
	}
	return TRUE;
}


