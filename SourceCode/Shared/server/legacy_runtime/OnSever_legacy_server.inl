static bool IsT5ArenaTimeReached(DWORD dwTime)
{
	return (int)(dwPlayServTime - dwTime) >= 0;
}

static smCHAR_INFO* FindT5ArenaMonsterInfo(const char* pszName)
{
	if(!pszName || !pszName[0])
		return NULL;

	for(int i = 0; i < chrMonsterCnt; i++)
	{
		if(lstrcmpi(chrMonsterList[i].szName, pszName) == 0)
			return &chrMonsterList[i];
	}

	return NULL;
}

static smCHAR* OpenT5ArenaUnit(const char* pszName, int x, int z, DWORD dwOwnerCode)
{
	if(!StageArea || !StageArea[QUEST_ARENA_FIELD].lpStage)
		return NULL;

	smCHAR_INFO* lpInfo = FindT5ArenaMonsterInfo(pszName);
	if(!lpInfo || !lpInfo->lpMonInfo)
		return NULL;

	STG_CHAR_INFO stgInfo = {};
	stgInfo.PosiState = smCHAR_STATE_ENEMY;
	memcpy(&stgInfo.smCharInfo, lpInfo, sizeof(smCHAR_INFO));

	STG_AREA* lpArea = &StageArea[QUEST_ARENA_FIELD];
	lpArea->EvnMonster = TRUE;

	smCHAR* lpChar = lpArea->OpenMonster(&stgInfo, 0);
	if(!lpChar)
		return NULL;

	lpChar->SetPosi(x, 0, z, 0, 0, 0);
	lpChar->DistAroundDbl = DIST_AROUND_MIDDLE;
	lpChar->dwLinkObjectCode = dwOwnerCode;
	lpChar->smMonsterInfo.FallItemCount = 0;
	lpChar->smCharInfo.Exp = 0;
	lpChar->SetMotionFromCode(CHRMOTION_STATE_STAND);
	lpChar->TargetMoveCount = 0;
	lpChar->ReopenCount = REOPEN_COUNT_NUM * 32;

	return lpChar;
}

static smCHAR* FindT5ArenaUnit(DWORD dwObjectCode, DWORD dwOwnerCode)
{
	if(!dwObjectCode || !StageArea || !StageArea[QUEST_ARENA_FIELD].lpStage)
		return NULL;

	STG_AREA* lpArea = &StageArea[QUEST_ARENA_FIELD];
	for(int i = 0; i < lpArea->MonsterLastPoint; i++)
	{
		smCHAR* lpChar = lpArea->lpCharMonster[i];
		if(lpChar && lpChar->Flag && lpChar->dwObjectSerial == dwObjectCode &&
			lpChar->dwLinkObjectCode == dwOwnerCode)
			return lpChar;
	}

	return NULL;
}

static bool TrackT5ArenaUnit(T5_ARENA_STATE& state, smCHAR* lpChar)
{
	if(!lpChar || state.iUnitCount < 0 || state.iUnitCount >= T5_ARENA_TRACK_MAX)
		return false;

	state.dwUnitCode[state.iUnitCount++] = lpChar->dwObjectSerial;
	return true;
}

static void KillT5ArenaUnits(T5_ARENA_STATE& state, bool bIncludeTower)
{
	if(!state.dwOwnerCode)
		return;

	for(int i = 0; i < state.iUnitCount && i < T5_ARENA_TRACK_MAX; i++)
	{
		DWORD dwObjectCode = state.dwUnitCode[i];
		if(!dwObjectCode)
			continue;

		if(!bIncludeTower && dwObjectCode == state.dwTowerCode)
			continue;

		smCHAR* lpChar = FindT5ArenaUnit(dwObjectCode, state.dwOwnerCode);
		if(!lpChar)
			continue;

		lpChar->smMonsterInfo.FallItemCount = 0;
		if(lpChar->smCharInfo.Life[0] > 0)
		{
			(void)gameplay::combat::legacy::ServerLegacyLifeAdapter().ConsumeLethal(
				gameplay::EntityId(static_cast<std::uint32_t>(lpChar->dwObjectSerial)),
				lpChar->smCharInfo.Life[0]);
		}
	}

	if(!bIncludeTower && state.dwTowerCode)
	{
		ZeroMemory(state.dwUnitCode, sizeof(state.dwUnitCode));
		state.dwUnitCode[0] = state.dwTowerCode;
		state.iUnitCount = 1;
	}
	else
	{
		ZeroMemory(state.dwUnitCode, sizeof(state.dwUnitCode));
		state.iUnitCount = 0;
	}
}

static void SendT5ArenaWarp(rsPLAYINFO* lpPlayInfo, int iField, int x, int z)
{
	if(!lpPlayInfo || !lpPlayInfo->lpsmSock)
		return;

	smTRANS_COMMAND packet = {};
	packet.code = OpCode::OPCODE_WARPFIELD;
	packet.size = sizeof(smTRANS_COMMAND);
	packet.WParam = iField;
	packet.SParam = x * fONE;
	packet.LParam = z * fONE;
	SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char*)&packet, packet.size);
}

static void WarpT5ArenaExit(rsPLAYINFO* lpPlayInfo)
{
	if(!lpPlayInfo)
		return;

	int field = START_FIELD_NUM;
	if(gameplay::classes::DefaultClassService().IsInBrood(
		lpPlayInfo->smCharInfo.JOB_CODE, gameplay::classes::brood::Morayion))
	{
		field = START_FIELD_MORYON;
	}

	if(field < 0 || field >= FIELD_MAX || sField[field].StartPointCnt <= 0)
		return;

	SendT5ArenaWarp(lpPlayInfo, field, sField[field].StartPoint[0].x, sField[field].StartPoint[0].y);
}

static int GetT5ArenaHPMultiplier(int iLevel)
{
	if(iLevel >= 125)
		return 5;
	if(iLevel >= 120)
		return 4;
	if(iLevel >= 115)
		return 3;
	if(iLevel >= 110)
		return 2;
	return 1;
}

static smCHAR* SpawnT5ArenaTower(rsPLAYINFO* lpPlayInfo)
{
	if(!lpPlayInfo)
		return NULL;

	smCHAR* lpTower = OpenT5ArenaUnit(
		"Crystal Tower",
		QUEST_ARENA_NPC_POS_X,
		QUEST_ARENA_NPC_POS_Z,
		lpPlayInfo->dwObjectSerial);

	if(!lpTower)
		return NULL;

	lpTower->smCharInfo.Attack_Damage[0] = 0;
	lpTower->smCharInfo.Attack_Damage[1] = 0;
	lpTower->smMonsterInfo.SkillDamage[0] = 0;
	lpTower->smMonsterInfo.SkillDamage[1] = 0;
	lpTower->smCharInfo.Absorption = 0;
	lpTower->smCharInfo.Move_Speed = 0;
	lpTower->smCharInfo.Life[0] = 30000;
	lpTower->smCharInfo.Life[1] = 30000;
	lpTower->DontMoveFlag = 2;
	lpTower->TargetMoveCount = 0;
	lpTower->lpTargetPlayInfo = NULL;
	lpTower->lpTargetChar = NULL;
	lpTower->dwUpdateCharInfoTime = dwPlayServTime + T5_ARENA_TIME_START +
		(T5_ARENA_TIME_ROUND * T5_ARENA_MAX_ROUND) + 60000;

	return lpTower;
}

static bool SpawnT5ArenaWave(rsPLAYINFO* lpPlayInfo, T5_ARENA_STATE& state)
{
	if(!lpPlayInfo || state.iRound < 1 || state.iRound > T5_ARENA_MAX_ROUND)
		return false;

	smCHAR* lpTower = FindT5ArenaUnit(state.dwTowerCode, state.dwOwnerCode);
	if(!lpTower || lpTower->smCharInfo.Life[0] <= 0)
		return false;

	int hp = g_T5ArenaRoundHP[state.iRound - 1] * GetT5ArenaHPMultiplier(lpPlayInfo->smCharInfo.Level);
	int spawned = 0;

	for(int i = 0; i < T5_ARENA_SPAWN_COUNT; i++)
	{
		int x = QUEST_ARENA_NPC_POS_X + (g_T5ArenaSpawnOffset[i][0] * fONE);
		int z = QUEST_ARENA_NPC_POS_Z + (g_T5ArenaSpawnOffset[i][1] * fONE);

		smCHAR* lpHopy = OpenT5ArenaUnit("Hopy", x, z, state.dwOwnerCode);
		if(!lpHopy)
			continue;

		lpHopy->smCharInfo.Attack_Damage[0] = 50;
		lpHopy->smCharInfo.Attack_Damage[1] = 50;
		lpHopy->smCharInfo.Life[0] = hp;
		lpHopy->smCharInfo.Life[1] = hp;
		lpHopy->lpTargetPlayInfo = NULL;
		lpHopy->lpTargetChar = lpTower;
		lpHopy->SetNextTarget(lpTower->pX, lpTower->pY, lpTower->pZ);
		lpHopy->dwUpdateCharInfoTime = state.dwRoundEndTime + 5000;

		if(!TrackT5ArenaUnit(state, lpHopy))
		{
			lpHopy->smMonsterInfo.FallItemCount = 0;
			(void)gameplay::combat::legacy::ServerLegacyLifeAdapter().ConsumeLethal(
				gameplay::EntityId(static_cast<std::uint32_t>(lpHopy->dwObjectSerial)),
				lpHopy->smCharInfo.Life[0]);
			continue;
		}

		spawned++;
	}

	return spawned == T5_ARENA_SPAWN_COUNT;
}

static void UpdateT5ArenaTargets(const T5_ARENA_STATE& state)
{
	smCHAR* lpTower = FindT5ArenaUnit(state.dwTowerCode, state.dwOwnerCode);
	if(!lpTower || lpTower->smCharInfo.Life[0] <= 0)
		return;

	for(int i = 0; i < state.iUnitCount && i < T5_ARENA_TRACK_MAX; i++)
	{
		DWORD dwObjectCode = state.dwUnitCode[i];
		if(!dwObjectCode || dwObjectCode == state.dwTowerCode)
			continue;

		smCHAR* lpChar = FindT5ArenaUnit(dwObjectCode, state.dwOwnerCode);
		if(!lpChar || lpChar->smCharInfo.Life[0] <= 0)
			continue;

		lpChar->lpTargetPlayInfo = NULL;
		lpChar->lpTargetChar = lpTower;
		lpChar->SetNextTarget(lpTower->pX, lpTower->pY, lpTower->pZ);
	}
}

bool IsTier5ArenaQuestActive(rsPLAYINFO* lpPlayInfo)
{
	int index = GetT5PlayInfoIndex(lpPlayInfo);
	if(index < 0)
		return false;

	T5_ARENA_STATE& state = g_T5ArenaState[index];
	return state.bActive && state.dwOwnerCode == lpPlayInfo->dwObjectSerial;
}

void StopTier5ArenaQuest(rsPLAYINFO* lpPlayInfo, bool bWarpOut)
{
	int index = GetT5PlayInfoIndex(lpPlayInfo);
	if(index < 0)
		return;

	T5_ARENA_STATE state = g_T5ArenaState[index];
	if(!state.bActive || state.dwOwnerCode != lpPlayInfo->dwObjectSerial)
		return;

	KillT5ArenaUnits(state, true);
	ZeroMemory(&g_T5ArenaState[index], sizeof(T5_ARENA_STATE));

	if(bWarpOut && lpPlayInfo->Position.Area == QUEST_ARENA_FIELD)
		WarpT5ArenaExit(lpPlayInfo);
}

bool StartTier5ArenaQuest(rsPLAYINFO* lpPlayInfo)
{
	int index = GetT5PlayInfoIndex(lpPlayInfo);
	if(index < 0 || !lpPlayInfo->lpsmSock || !lpPlayInfo->dwObjectSerial)
		return false;

	if(!StageArea || !StageArea[QUEST_ARENA_FIELD].lpStage)
	{
		rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena indisponivel: field 32 nao carregado.");
		return false;
	}

	if(!FindT5ArenaMonsterInfo("Hopy") || !FindT5ArenaMonsterInfo("Crystal Tower"))
	{
		rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena indisponivel: Hopy/Crystal Tower ausente no catalogo de monstros.");
		return false;
	}

	T5_ARENA_STATE& state = g_T5ArenaState[index];
	if(state.bActive && state.dwOwnerCode == lpPlayInfo->dwObjectSerial)
		return true;

	if(state.bActive && state.dwOwnerCode)
		KillT5ArenaUnits(state, true);

	ZeroMemory(&state, sizeof(T5_ARENA_STATE));
	state.dwOwnerCode = lpPlayInfo->dwObjectSerial;
	state.bActive = TRUE;

	SendT5ArenaWarp(lpPlayInfo, QUEST_ARENA_FIELD,
		QUEST_ARENA_NPC_POS_X / fONE, QUEST_ARENA_NPC_POS_Z / fONE);
	rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena: preparando instancia exclusiva.");

	return true;
}

static void FailT5ArenaQuest(rsPLAYINFO* lpPlayInfo, T5_ARENA_STATE& state, const char* pszReason)
{
	if(lpPlayInfo && lpPlayInfo->lpsmSock)
	{
		if(pszReason && pszReason[0])
			rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena falhou: %s", (char*)pszReason);
		else
			rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena falhou.");

		rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> A quest continua ativa; cancele/reinicie para tentar novamente.");
	}

	KillT5ArenaUnits(state, true);
	ZeroMemory(&state, sizeof(T5_ARENA_STATE));

	if(lpPlayInfo && lpPlayInfo->lpsmSock && lpPlayInfo->Position.Area == QUEST_ARENA_FIELD)
		WarpT5ArenaExit(lpPlayInfo);
}

static void FinishT5ArenaQuest(rsPLAYINFO* lpPlayInfo, T5_ARENA_STATE& state)
{
	if(!lpPlayInfo)
		return;

	if(!gameplay::quests::legacy::ServerLegacyQuestObjectiveService().CompleteObjectives(gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lpPlayInfo), gameplay::QuestId(QUESTID_T5_QUEST_ARENA)))
	{
		FailT5ArenaQuest(lpPlayInfo, state, "QuestDB nao confirmou o objetivo final");
		return;
	}

	KillT5ArenaUnits(state, true);
	ZeroMemory(&state, sizeof(T5_ARENA_STATE));

	rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena concluida. Resgate a recompensa da quest para promover ao Rank 5.");
	gameplay::quests::legacy::ServerLegacyQuestQueryIngressAdapter().SendSpoilerInfo(gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lpPlayInfo), 9);
	if(lpPlayInfo->Position.Area == QUEST_ARENA_FIELD)
		WarpT5ArenaExit(lpPlayInfo);
}

static void UpdateT5ArenaQuest()
{
	for(int i = 0; i < CONNECTMAX; i++)
	{
		T5_ARENA_STATE& state = g_T5ArenaState[i];
		if(!state.bActive || !state.dwOwnerCode)
			continue;

		rsPLAYINFO* lpPlayInfo = &rsPlayInfo[i];

		if(lpPlayInfo->dwObjectSerial != state.dwOwnerCode || !lpPlayInfo->lpsmSock)
		{
			KillT5ArenaUnits(state, true);

			if(lpPlayInfo->dwObjectSerial == state.dwOwnerCode)
				gameplay::quests::legacy::ServerLegacyQuestObjectiveService().CancelProgress(gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lpPlayInfo), gameplay::QuestId(QUESTID_T5_QUEST_ARENA));

			ZeroMemory(&state, sizeof(T5_ARENA_STATE));
			continue;
		}

		if(!gameplay::quests::legacy::ServerLegacyQuestObjectiveService().IsInProgress(gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lpPlayInfo), gameplay::QuestId(QUESTID_T5_QUEST_ARENA)))
		{
			KillT5ArenaUnits(state, true);
			ZeroMemory(&state, sizeof(T5_ARENA_STATE));
			continue;
		}

		if(!state.bEntered)
		{
			if(lpPlayInfo->Position.Area == QUEST_ARENA_FIELD)
			{
				state.bEntered = TRUE;
				state.iRound = 0;
				state.dwRoundEndTime = dwPlayServTime + T5_ARENA_TIME_START;
				state.dwNextSpawnTime = 0;
				rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena: a batalha comeca em 20 segundos.");
			}
			continue;
		}

		if(lpPlayInfo->Position.Area != QUEST_ARENA_FIELD)
		{
			KillT5ArenaUnits(state, true);
			gameplay::quests::legacy::ServerLegacyQuestObjectiveService().CancelProgress(gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lpPlayInfo), gameplay::QuestId(QUESTID_T5_QUEST_ARENA));
			ZeroMemory(&state, sizeof(T5_ARENA_STATE));
			continue;
		}

		if(state.iRound == 0)
		{
			if(!IsT5ArenaTimeReached(state.dwRoundEndTime))
				continue;

			state.iRound = 1;
			state.dwRoundEndTime = dwPlayServTime + T5_ARENA_TIME_ROUND;
			state.dwNextSpawnTime = dwPlayServTime + T5_ARENA_TIME_SPAWN;

			smCHAR* lpTower = SpawnT5ArenaTower(lpPlayInfo);
			if(!lpTower)
			{
				FailT5ArenaQuest(lpPlayInfo, state, "Crystal Tower nao pode ser criada");
				continue;
			}

			state.dwTowerCode = lpTower->dwObjectSerial;
			if(!TrackT5ArenaUnit(state, lpTower))
			{
				FailT5ArenaQuest(lpPlayInfo, state, "limite interno de unidades atingido");
				continue;
			}

			if(!SpawnT5ArenaWave(lpPlayInfo, state))
			{
				FailT5ArenaQuest(lpPlayInfo, state, "wave inicial incompleta");
				continue;
			}

			rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena: Round %d/%d.", state.iRound, T5_ARENA_MAX_ROUND);
			continue;
		}

		smCHAR* lpTower = FindT5ArenaUnit(state.dwTowerCode, state.dwOwnerCode);
		if(!lpTower || lpTower->smCharInfo.Life[0] <= 0)
		{
			FailT5ArenaQuest(lpPlayInfo, state, "Crystal Tower destruida");
			continue;
		}

		UpdateT5ArenaTargets(state);

		if(IsT5ArenaTimeReached(state.dwRoundEndTime))
		{
			if(state.iRound >= T5_ARENA_MAX_ROUND)
			{
				FinishT5ArenaQuest(lpPlayInfo, state);
				continue;
			}

			KillT5ArenaUnits(state, false);
			state.iRound++;
			state.dwRoundEndTime = dwPlayServTime + T5_ARENA_TIME_ROUND;
			state.dwNextSpawnTime = dwPlayServTime + T5_ARENA_TIME_SPAWN;

			if(!SpawnT5ArenaWave(lpPlayInfo, state))
			{
				FailT5ArenaQuest(lpPlayInfo, state, "wave de round incompleta");
				continue;
			}

			rsSendServerChatMessageToUser1(lpPlayInfo, 3, "> Tier 5 Arena: Round %d/%d.", state.iRound, T5_ARENA_MAX_ROUND);
			continue;
		}

		if(IsT5ArenaTimeReached(state.dwNextSpawnTime))
		{
			if(!SpawnT5ArenaWave(lpPlayInfo, state))
			{
				FailT5ArenaQuest(lpPlayInfo, state, "wave periodica incompleta");
				continue;
			}
			state.dwNextSpawnTime = dwPlayServTime + T5_ARENA_TIME_SPAWN;
		}
	}
}



int OpenEventMonster(smCHAR_INFO *lpCharInfo, STG_AREA *lpStgArea)
{
	int cnt;
	int MonCnt;


	if(lpCharInfo->dwCharSoundCode == snCHAR_SOUND_HOPT)
	{
		if((rand() % 100) > 30) return FALSE;

		MonCnt = 0;
		for(cnt = 0; cnt < STG_MONSTER_MAX; cnt++)
		{
			if(lpStgArea->lpCharMonster[cnt])
			{
				if(lpStgArea->lpCharMonster[cnt]->smCharInfo.dwCharSoundCode == snCHAR_SOUND_HOPYKING)
				{
					MonCnt++;
				}
			}
		}
		if(MonCnt >= 40) return FALSE;

		for(cnt = 0; cnt < chrMonsterCnt; cnt++)
		{
			if(chrMonsterList[cnt].dwCharSoundCode == snCHAR_SOUND_HOPYKING)
			{
				memcpy(lpCharInfo, &chrMonsterList[cnt], sizeof(smCHAR_INFO));
				break;
			}
		}
	}


	return TRUE;
}

