static int rsCompString(char *src1, char *src2)
{
	int cnt;
	int len1, len2;
	int len;

	len1 = lstrlen(src1);
	len2 = lstrlen(src2);

	if(len1 < len2) len = len1;
	else len = len2;

	if(!len) return NULL;

	for(cnt = 0; cnt < len1; cnt++)
	{
		if(src1[cnt] == 0) break;
		if(src1[cnt] != src2[cnt]) return NULL;
	}

	return cnt;
}

char *rsGetWord(char *q, char *p)
{


	if(*p == 0)
	{
		*q = 0; return p;
	}

	while((*p == 32) || (*p == 9) || (*p == 58))
	{
		p++;
	}

	while((*p != 32) && (*p != 9) && (*p != 58) && (*p != 0))
	{
		if(*p == '\n' || *p == '\r') break;
		*q++ = *p++;
	}
	*q++ = 0;



	return p;
}


