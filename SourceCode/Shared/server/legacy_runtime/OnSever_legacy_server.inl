	TransChatMessage.size = lstrlen(TransChatMessage.szMessage) + 32;
	TransChatMessage.code = OpCode::OPCODE_REC_ADMIN_COMMAND;

	return rsSendDataServer(lpPlayInfo->lpsmSock, &TransChatMessage);
