		}

		if(wLastCheckMin == 29 && st.wMinute == 30 &&
			st.wDayOfWeek == rsServerConfig.sBlessCastle_StartTime[0] &&
			st.wHour == rsServerConfig.sBlessCastle_StartTime[1] - 1)
		{

			rsSetNoticeMessage(srBlessCastle_LeagueMsg_04);
		}
