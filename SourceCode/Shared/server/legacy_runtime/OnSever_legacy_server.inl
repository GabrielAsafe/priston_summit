AccountTypes handleSecurityCommand(rsPLAYINFO *playInfo, char buffer[])
{
	AccountTypes result = AccountTypes::SEC_PLAYER;

	try
	{
		if(playInfo)
		{
			int length = strlen(buffer);

			if(length <= 30)
			{
				std::string accountId(playInfo->getAccount());
				std::string password(buffer);

				result = GameMasters::getInstance()->getGameMaster(accountId, password);
			}
		}
	}
	catch(std::exception &e)
	{
		cout << "[handleSecurityCommand] Error: " << e.what() << endl;
	}


	return result;
}

