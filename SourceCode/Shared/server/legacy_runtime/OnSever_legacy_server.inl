// PATCH 231: authoritative wallet reconciliation after the legacy action ACK.
// The server never accepts a wallet amount from the client as authority.
static int SummitSendWalletSnapshot(rsPLAYINFO* player)
{
    if(!player || !player->lpsmSock || player->ServerMoney < 0 || player->ServerMoney > 1000000000)
        return FALSE;
    smTRANS_COMMAND response = {};
    response.code = OpCode::OPCODE_SUMMIT_WALLET_SNAPSHOT;
    response.size = sizeof(response);
    response.WParam = player->ServerMoney;
    response.LParam = 1000000000; // exact protocol cap; safety check on client
    response.EParam = static_cast<int>(player->dwObjectSerial);
    return SendOnServerLegacySocket(player->lpsmSock, (char*)&response, response.size);
}

// SUMMIT_PATCH_218_NPC_SHOP_DECISION_TRACE
// Diagnostic only: opt-in, one log line per purchase boundary event.
// No account names, item grants, wallet updates, or network changes.
static void SummitNpcShopPurchaseTrace(const char* phase, const rsPLAYINFO* player,
                                       const TRANS_BUY_SHOPITEM* packet,
                                       int transactionCode = -1, long long charged = -1)
{
    char enabled[8] = {0};
    if(GetEnvironmentVariableA("SUMMIT_NPC_SHOP_TRACE", enabled, sizeof(enabled)) == 0 || enabled[0] != '1')
        return;
    CreateDirectoryA("LOGS", NULL);
    FILE* fp = fopen("LOGS/npc_shop_purchase_server.log", "ab");
    if(!fp)
        return;
    const sITEMINFO* item = packet ? &packet->sItem.sItemInfo : NULL;
    fprintf(fp, "phase=%s code=0x%08X count=%d unitPrice=%d wallet=%d inventoryMode=%d createTime=%lu reqLevel=%d playerLevel=%d status=%d charged=%lld\n",
            phase ? phase : "?", item ? (unsigned int)item->CODE : 0U,
            packet ? packet->ItemCount : 0, item ? item->Price : 0,
            player ? player->ServerMoney : -1, (int)rsServerConfig.ServerInventoryMode,
            item ? (unsigned long)item->dwCreateTime : 0UL,
            item ? item->Level : -1, player ? player->smCharInfo.Level : -1,
            transactionCode, charged);
    fclose(fp);
}

// SUMMIT_PATCH_226_REAL_SOURCE: merchant purchase does not require equip stats.

static int SummitNpcShopReject(rsPLAYINFO* player, TRANS_BUY_SHOPITEM* request,
                              gameplay::commerce::NpcShopRejection reason)
{
    if(player && player->lpsmSock && request)
    {
        // Reuse the existing opcode and packet size. The negative count cannot
        // be mistaken for a successful grant; netplay handles it before inventory.
        TRANS_BUY_SHOPITEM response = *request;
        response.code = OpCode::OPCODE_SHOPTITEM;
        response.size = sizeof(TRANS_BUY_SHOPITEM);
        response.ItemCount = gameplay::commerce::EncodeNpcShopRejection(reason);
        SendOnServerLegacySocket(player->lpsmSock, (char*)&response, response.size);
        (void)SummitSendWalletSnapshot(player);
    }
    return FALSE;
}

int rsRecvBuyShopItem(rsPLAYINFO *lpPlayInfo, TRANS_BUY_SHOPITEM *lpTransBuyShopItem)
{
	int money;

	if(!lpPlayInfo || !lpTransBuyShopItem || !lpPlayInfo->lpsmSock)
	{
		SummitNpcShopPurchaseTrace("invalid-session", lpPlayInfo, lpTransBuyShopItem);
		return FALSE;
	}
	SummitNpcShopPurchaseTrace("request", lpPlayInfo, lpTransBuyShopItem);
	if(lpTransBuyShopItem->ItemCount <= 0 || lpTransBuyShopItem->sItem.sItemInfo.Price < 0)
	{
		SummitNpcShopPurchaseTrace("invalid-count-or-price", lpPlayInfo, lpTransBuyShopItem);
        return SummitNpcShopReject(lpPlayInfo, lpTransBuyShopItem,
            gameplay::commerce::NpcShopRejection::InvalidRequest);
	}

	// SUMMIT_PATCH_226_REAL_SOURCE: equipment requirements are enforced when
	// equipping, not purchasing. All wallet/form/inventory checks stay active.
	// PATCH 216: never synthesize or reset currency during a merchant purchase.
	// Wallet balance is initialized from persisted ServerMoney at player load.
	// Both inventory modes must validate the *actual* wallet balance.

	const bool summitShopValidForm = CheckItemForm(&lpTransBuyShopItem->sItem.sItemInfo) == TRUE;
	if(summitShopValidForm &&
		lpTransBuyShopItem->sItem.sItemInfo.dwCreateTime == 0)
	{
		const bool isPotionPurchase =
			lpTransBuyShopItem->ItemCount > 0 &&
			(lpTransBuyShopItem->sItem.sItemInfo.CODE&sinITEM_MASK1) == (sinPM1&sinITEM_MASK1);
		const int purchaseQuantity = isPotionPurchase ? lpTransBuyShopItem->ItemCount : 1;
		const gameplay::PlayerId playerId(static_cast<std::uint32_t>(lpPlayInfo->dwObjectSerial));
		const gameplay::commerce::CurrencyAmount unitPrice =
			static_cast<gameplay::commerce::CurrencyAmount>(lpTransBuyShopItem->sItem.sItemInfo.Price);

		ReformItem(&lpTransBuyShopItem->sItem.sItemInfo);

		gameplay::commerce::CurrencyAmount purchaseBefore = 0;
		gameplay::commerce::CurrencyAmount purchaseTotal = unitPrice;
		bool purchased = false;
		int summitShopTransactionCode = -1;
        gameplay::commerce::NpcShopRejection shopRejection =
            gameplay::commerce::NpcShopRejection::TransactionRejected;

		if(isPotionPurchase)
		{
			const gameplay::commerce::ShopPotionPurchaseResult purchase =
				gameplay::commerce::legacy::ServerLegacyShopAdapter().PurchasePotion(
					gameplay::commerce::ShopPotionPurchaseRequest(
						playerId,
						gameplay::ItemId(static_cast<std::uint32_t>(lpTransBuyShopItem->sItem.sItemInfo.CODE)),
						unitPrice,
						static_cast<gameplay::inventory::PotionQuantity>(purchaseQuantity)));
			purchased = purchase.Purchased();
			summitShopTransactionCode = static_cast<int>(purchase.code);
            if(purchase.code == gameplay::commerce::ShopPotionPurchaseCode::InsufficientFunds)
                shopRejection = gameplay::commerce::NpcShopRejection::InsufficientFunds;
            else if(purchase.code == gameplay::commerce::ShopPotionPurchaseCode::PotionRejected)
                shopRejection = gameplay::commerce::NpcShopRejection::InventoryRejected;
			purchaseBefore = purchase.before;
			purchaseTotal = purchase.total;
		}
		else if(rsServerConfig.ServerInventoryMode)
		{
			const gameplay::inventory::ItemInstanceId item(
				gameplay::ItemId(static_cast<std::uint32_t>(lpTransBuyShopItem->sItem.sItemInfo.CODE)),
				static_cast<std::uint32_t>(lpTransBuyShopItem->sItem.sItemInfo.ItemHeader.Head),
				static_cast<std::uint32_t>(lpTransBuyShopItem->sItem.sItemInfo.ItemHeader.dwChkSum));
			const gameplay::commerce::ShopItemPurchaseResult purchase =
				gameplay::commerce::legacy::ServerLegacyShopAdapter().PurchaseItem(
					gameplay::commerce::ShopItemPurchaseRequest(playerId, item, unitPrice));
			purchased = purchase.Purchased();
			summitShopTransactionCode = static_cast<int>(purchase.code);
            if(purchase.code == gameplay::commerce::ShopItemPurchaseCode::InsufficientFunds)
                shopRejection = gameplay::commerce::NpcShopRejection::InsufficientFunds;
            else if(purchase.code == gameplay::commerce::ShopItemPurchaseCode::InventoryRejected)
                shopRejection = gameplay::commerce::NpcShopRejection::InventoryRejected;
			purchaseBefore = purchase.before;
			purchaseTotal = purchase.price;
		}
		else
		{
			const gameplay::commerce::ShopPurchaseResult purchase =
				gameplay::commerce::legacy::ServerLegacyShopAdapter().Purchase(
					gameplay::commerce::ShopPurchaseRequest(
						playerId, unitPrice, purchaseQuantity, gameplay::commerce::ShopPurchaseKind::Item));
			purchased = purchase.Purchased();
			summitShopTransactionCode = static_cast<int>(purchase.code);
            if(purchase.code == gameplay::commerce::ShopPurchaseCode::InsufficientFunds)
                shopRejection = gameplay::commerce::NpcShopRejection::InsufficientFunds;
			purchaseBefore = purchase.before;
			purchaseTotal = purchase.total;
		}

		if(!purchased)
		{
			SummitNpcShopPurchaseTrace("transaction-rejected", lpPlayInfo, lpTransBuyShopItem,
				summitShopTransactionCode, static_cast<long long>(purchaseTotal));
			smTRANS_COMMAND smTransCommand;
			smTransCommand.WParam = 8010;
			smTransCommand.LParam = 10;
			smTransCommand.SParam = static_cast<int>(purchaseBefore);
			smTransCommand.EParam = lpTransBuyShopItem->sItem.sItemInfo.Price;
			RecordHackLogFile(lpPlayInfo, &smTransCommand);
            return SummitNpcShopReject(lpPlayInfo, lpTransBuyShopItem, shopRejection);
		}

		rsRecord_ItemLog(lpPlayInfo,
			lpTransBuyShopItem->sItem.sItemInfo.CODE,
			lpTransBuyShopItem->sItem.sItemInfo.ItemHeader.Head,
			lpTransBuyShopItem->sItem.sItemInfo.ItemHeader.dwChkSum,
			ITEMLOG_BUYSHOP);

		if(isPotionPurchase)
		{
			money = static_cast<int>(purchaseTotal);

			switch((lpTransBuyShopItem->sItem.sItemInfo.CODE&sinITEM_MASK2))
			{
			case sinPL1:
				CurrencyLog.int64_ShopPotionMoney[0] += money;
				break;
			case sinPM1:
				CurrencyLog.int64_ShopPotionMoney[1] += money;
				break;
			case sinPS1:
				CurrencyLog.int64_ShopPotionMoney[2] += money;
				break;
			}
		}
		else
		{
			CurrencyLog.int64_ShopMoney += lpTransBuyShopItem->sItem.sItemInfo.Price;
		}

		SummitNpcShopPurchaseTrace("accepted", lpPlayInfo, lpTransBuyShopItem,
			summitShopTransactionCode, static_cast<long long>(purchaseTotal));
        const int sent = SendOnServerLegacySocket(lpPlayInfo->lpsmSock,
            (char *)lpTransBuyShopItem, lpTransBuyShopItem->size);
        if(sent) (void)SummitSendWalletSnapshot(lpPlayInfo);
        return sent;
	}

	SummitNpcShopPurchaseTrace(summitShopValidForm ? "create-time-rejected" : "validation-rejected",
		lpPlayInfo, lpTransBuyShopItem);
    return SummitNpcShopReject(lpPlayInfo, lpTransBuyShopItem,
        gameplay::commerce::NpcShopRejection::InvalidItem);
}


int rsRecvSellShopItem(rsPLAYINFO *lpPlayInfo, TRANS_ITEMINFO *lpTransItemInfo)
{
	smTRANS_COMMAND		smTransCommand;
	smTRANS_COMMAND_EX	smTransCommandEx;

	float Dur[2];
	float Price;
	int	  Price2, PriceMax;
	int	  PriceDiv;

	if((lpTransItemInfo->Item.CODE&sinITEM_MASK1) == (sinPM1&sinITEM_MASK1) || lpTransItemInfo->Item.CODE == (sinGF1 | sin01))
	{
		return FALSE;
	}

	if(CheckItemForm(&lpTransItemInfo->Item) == FALSE)
	{
		smTransCommandEx.WParam = 8830;
		smTransCommandEx.LParam = lpTransItemInfo->Item.CODE;
		smTransCommandEx.SParam = lpTransItemInfo->Item.Price;
		smTransCommandEx.EParam = 0;
		RecordHackLogFile(lpPlayInfo, &smTransCommandEx);
		return FALSE;
	}

	Dur[0] = lpTransItemInfo->Item.Durability[0];
	Dur[1] = lpTransItemInfo->Item.Durability[1];
	Price = (float)lpTransItemInfo->Item.Price;

	if(Dur[0] == 0)Dur[0] = 1;
	if(Dur[1] == 0)Dur[1] = 1;

	PriceDiv = 5;

	Price2 = (int)((Price*(Dur[0] / Dur[1])) + (Price - (Price*(Dur[0] / Dur[1])))*0.25);
	Price2 = Price2 / PriceDiv;
	PriceMax = lpTransItemInfo->Item.Price / PriceDiv;

	smTransCommand.code = OpCode::OPCODE_SHOP_SELLITEM;
	smTransCommand.size = sizeof(smTRANS_COMMAND);
	smTransCommand.WParam = lpTransItemInfo->Item.CODE;
	smTransCommand.LParam = lpTransItemInfo->Item.ItemHeader.Head;
	smTransCommand.SParam = lpTransItemInfo->Item.ItemHeader.dwChkSum;

	if(PriceMax < Price2)
		smTransCommand.EParam = PriceMax;
	else
		smTransCommand.EParam = Price2;

	if ((lpTransItemInfo->Item.CODE & sinITEM_MASK2) == sinGB1) {
		smTransCommand.EParam = (int)Price;
	}

	// Artisan Tier II+: equipment sold through the authoritative blacksmith
	// path receives the data-driven vendor value modifier. Apply this after
	// all legacy durability/cap calculations so the Covenant bonus is not
	// accidentally clipped by PriceMax. The server remains authoritative.
	if(smTransCommand.EParam > 0 && lpPlayInfo->getName())
	{
		const double covenantSellValue = gameplay::progression::ApplyServerCovenantModifierValue(
			lpPlayInfo->getName(), "vendor.blacksmith_sell_value", "blacksmith",
			static_cast<double>(smTransCommand.EParam));
		if(covenantSellValue > 0.0)
		{
			const double maxServerMoneyDelta = 2147483647.0;
			smTransCommand.EParam = static_cast<int>(
				covenantSellValue > maxServerMoneyDelta ? maxServerMoneyDelta : covenantSellValue);
		}
	}

	const gameplay::PlayerId sellerId(static_cast<std::uint32_t>(lpPlayInfo->dwObjectSerial));
	const gameplay::inventory::ItemInstanceId soldItem(
		gameplay::ItemId(static_cast<std::uint32_t>(lpTransItemInfo->Item.CODE)),
		static_cast<std::uint32_t>(lpTransItemInfo->Item.ItemHeader.Head),
		static_cast<std::uint32_t>(lpTransItemInfo->Item.ItemHeader.dwChkSum));
	const gameplay::commerce::ShopItemSaleResult sale =
		gameplay::commerce::legacy::ServerLegacyShopAdapter().SellItem(
			gameplay::commerce::ShopItemSaleRequest(
				sellerId,
				soldItem,
				static_cast<gameplay::commerce::CurrencyAmount>(smTransCommand.EParam)));

	if(!sale.Sold())
	{
		if(sale.code == gameplay::commerce::ShopItemSaleCode::ItemNotFound)
		{
			smTransCommandEx.WParam = 8000;
			smTransCommandEx.WxParam = 10;
			smTransCommandEx.LxParam = (int)lpTransItemInfo->Item.ItemName;
			smTransCommandEx.LParam = lpTransItemInfo->Item.CODE;
			smTransCommandEx.SParam = lpTransItemInfo->Item.ItemHeader.Head;
			smTransCommandEx.EParam = lpTransItemInfo->Item.ItemHeader.dwChkSum;
			RecordHackLogFile(lpPlayInfo, &smTransCommandEx);
			return TRUE;
		}

		smTransCommandEx.WParam = sale.code == gameplay::commerce::ShopItemSaleCode::RollbackFailed ? 8000 : 8010;
		smTransCommandEx.WxParam = sale.code == gameplay::commerce::ShopItemSaleCode::RollbackFailed ? 12 : 11;
		smTransCommandEx.LParam = lpTransItemInfo->Item.CODE;
		smTransCommandEx.SParam = static_cast<int>(sale.before);
		smTransCommandEx.EParam = smTransCommand.EParam;
		RecordHackLogFile(lpPlayInfo, &smTransCommandEx);
		return FALSE;
	}

	if(lpPlayInfo->lpsmSock)
	{
        SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char *)&smTransCommand, smTransCommand.size);
        (void)SummitSendWalletSnapshot(lpPlayInfo);
	}

	lpPlayInfo->UnsaveMoney = lpTransItemInfo->y - smTransCommand.EParam;

	SaveThrowItem(lpPlayInfo, lpTransItemInfo->Item.CODE,
		lpTransItemInfo->Item.ItemHeader.Head,
		lpTransItemInfo->Item.ItemHeader.dwChkSum);

	rsRecord_ItemLog(lpPlayInfo,
		lpTransItemInfo->Item.CODE,
		lpTransItemInfo->Item.ItemHeader.Head,
		lpTransItemInfo->Item.ItemHeader.dwChkSum,
		ITEMLOG_SELLSHOP);

	char accountIdLog[32] = { 0 };
	char nameLog[32] = { 0 };
	sprintf_s(accountIdLog, sizeof(accountIdLog), lpPlayInfo->getAccount());
	sprintf_s(nameLog, sizeof(nameLog), lpPlayInfo->getName());

	RecordLog("LogFerreiro", FormatString("Login[%s],NickName[%s],NomeItem[%s],Code[%d],Checksum[%d]", accountIdLog, nameLog, lpTransItemInfo->Item.ItemName, lpTransItemInfo->Item.CODE, lpTransItemInfo->Item.ItemHeader.dwChkSum));

	return TRUE;
}


int	rsCompareItems(sITEMINFO	*lpItem1, sITEMINFO	*lpItem2)
{
	if(lpItem1->CODE && lpItem1->CODE == lpItem2->CODE)
	{
		if(lpItem1->ItemHeader.dwTime == lpItem2->ItemHeader.dwTime &&
			lpItem1->ItemHeader.dwChkSum == lpItem2->ItemHeader.dwChkSum &&
			lpItem1->ItemHeader.Head == lpItem2->ItemHeader.Head)
		{

			return TRUE;
		}

		if(lpItem1->ItemHeader.dwChkSum == lpItem2->BackUpChkSum &&
			lpItem1->ItemHeader.Head == lpItem2->BackUpKey)
		{

			return TRUE;
		}

		if(lpItem2->ItemHeader.dwChkSum == lpItem1->BackUpChkSum &&
			lpItem2->ItemHeader.Head == lpItem1->BackUpKey)
		{

			return TRUE;
		}

		if(lpItem1->BackUpChkSum && lpItem1->BackUpKey &&
			lpItem2->BackUpChkSum == lpItem1->BackUpChkSum &&
			lpItem2->BackUpKey == lpItem1->BackUpKey)
		{

			return TRUE;
		}
	}

	return FALSE;
}


int rsCheckStgAreaItem(STG_AREA *lpStgArea, sITEMINFO	*lpItem)
{
	int cnt;

	if(lpItem->CODE < sinPM1 && (lpItem->CODE&sinITEM_MASK3) >= sin08)
	{

		for(cnt = 0; cnt < STG_ITEM_MAX; cnt++)
		{
			if(lpStgArea->StgItems[cnt].state)
			{
				if(rsCompareItems(lpItem, &lpStgArea->StgItems[cnt].Item.ItemInfo) == TRUE)
				{
					lpStgArea->StgItems[cnt].state = 0;
					return FALSE;
				}
			}
		}

	}

	return TRUE;
}


