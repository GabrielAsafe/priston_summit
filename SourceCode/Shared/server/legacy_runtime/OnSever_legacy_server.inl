/* R21 server-local gameplay entitlement cache.
 * This stays outside rsPLAYINFO so no shared legacy packet/structure layout is
 * changed.  Each slot is reset when allocated/disconnected and populated once
 * authentication succeeds. */
static volatile LONG g_LocalPCBangGameplayEntitlement[CONNECTMAX] = {};

static int GetLocalPCBangGameplayEntitlementIndex(const rsPLAYINFO *lpPlayInfo)
{
	if(!lpPlayInfo || lpPlayInfo < &rsPlayInfo[0] || lpPlayInfo >= &rsPlayInfo[CONNECTMAX])
		return -1;
	return (int)(lpPlayInfo - &rsPlayInfo[0]);
}

bool rsHasLocalPCBangGameplayEntitlement(const rsPLAYINFO *lpPlayInfo)
{
	int index = GetLocalPCBangGameplayEntitlementIndex(lpPlayInfo);
	if(index < 0)
		return false;

	return InterlockedCompareExchange(
		&g_LocalPCBangGameplayEntitlement[index], 0, 0) != 0;
}

void rsSetLocalPCBangGameplayEntitlement(rsPLAYINFO *lpPlayInfo, bool enabled)
{
	int index = GetLocalPCBangGameplayEntitlementIndex(lpPlayInfo);
	if(index < 0)
		return;

	InterlockedExchange(&g_LocalPCBangGameplayEntitlement[index], enabled ? 1 : 0);
}

