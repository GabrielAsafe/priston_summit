int rsProcessSkillPartyUser(rsPLAYINFO *lpPlayInfo, TRANS_PARTY_SKILL *lpTransPartySkill)
{
	int point = lpTransPartySkill->Point - 1;

	if(point < 0 || point >= 10)
	{
		return FALSE;
	}

	switch(lpTransPartySkill->dwSkillCode)
	{
	case SKILL_PLAY_T51:
		// EU treats Holy Body, Holy Valor and Holy Conviction as one replacement group.
		lpPlayInfo->dwSkill_HolyBody_Time = 0;
		lpPlayInfo->dwSkill_HolyBody_Param = 0;
		lpPlayInfo->dwSkill_HolyValor_Time = 0;
		lpPlayInfo->dwSkill_HolyValor_Param = 0;
		lpPlayInfo->dwSkill_HolyConviction_Time = dwPlayServTime + (Knight_T5_HolyConviction_Duration[point] * 1000);
		lpPlayInfo->dwSkill_HolyConviction_Param = Knight_T5_HolyConviction_UndeadBoost[point];
		return TRUE;

	case SKILL_PLAY_T54:
		lpPlayInfo->dwSkill_PriestessConsecration_Time = dwPlayServTime + 300000;
		lpPlayInfo->dwSkill_PriestessConsecration_Point = point;
		return TRUE;

	case SKILL_PLAY_HOLY_VALOR:

		lpPlayInfo->dwSkill_HolyBody_Time = 0;
		lpPlayInfo->dwSkill_HolyBody_Param = 0;
		lpPlayInfo->dwSkill_HolyConviction_Time = 0;
		lpPlayInfo->dwSkill_HolyConviction_Param = 0;
		lpPlayInfo->dwSkill_HolyValor_Time = dwPlayServTime + (Holy_Valor_Time[point] * 1000);
		lpPlayInfo->dwSkill_HolyValor_Param = Holy_Valor_Damage[point];
		return TRUE;

	}


	return FALSE;
}


int	rsRecvSkillPartyUser(rsPLAYINFO *playInfo, TRANS_PARTY_SKILL *lpTransPartySkill)
{
	if(lpTransPartySkill->size < 40
	   || lpTransPartySkill->size > 60
	   || (lpTransPartySkill->dwSkillCode != SKILL_PLAY_HOLY_VALOR && lpTransPartySkill->dwSkillCode != SKILL_PLAY_T51 && lpTransPartySkill->dwSkillCode != SKILL_PLAY_T54)
	   || lpTransPartySkill->PartyCount < 0  // Min player party
	   || lpTransPartySkill->PartyCount > 6  // Max player party
	   || lpTransPartySkill->Point < 0 // Skill level
	   || lpTransPartySkill->Point > 10) // Skill level

	{
		recordAttack(playInfo, "Party Skill OverFlow");
		//banFirewall(playInfo);

		cout << "Party Skill OverFlow";

		if(playInfo && playInfo->lpsmSock)
			DisconnectUser(playInfo->lpsmSock);

		return FALSE;
	}

	if(lpTransPartySkill->dwSkillCode == SKILL_PLAY_T51)
	{
		int point = lpTransPartySkill->Point - 1;
		if(!playInfo || playInfo->smCharInfo.JOB_CODE != JOBCODE_KNIGHT ||
		   rsCheckSkillLevel(playInfo, SKILL_PLAY_T51) == FALSE ||
		   rsCheckTier5SkillAuthority(playInfo, SKILL_PLAY_T51, point) == FALSE)
			return FALSE;
	}
	else if(lpTransPartySkill->dwSkillCode == SKILL_PLAY_T54)
	{
		int point = lpTransPartySkill->Point - 1;
		if(!playInfo || playInfo->smCharInfo.JOB_CODE != JOBCODE_PRIESTESS ||
		   rsCheckSkillLevel(playInfo, SKILL_PLAY_T54) == FALSE ||
		   rsCheckTier5SkillAuthority(playInfo, SKILL_PLAY_T54, point) == FALSE)
			return FALSE;
	}

	for(int cnt = 0; cnt < lpTransPartySkill->PartyCount; cnt++)
	{
		rsPLAYINFO *lpPlayInfo = srFindUserFromSerial(lpTransPartySkill->dwPartyUser[cnt]);
		if(lpPlayInfo && lpPlayInfo->lpsmSock)
		{
			if(rsProcessSkillPartyUser(lpPlayInfo, lpTransPartySkill) == TRUE)
			{
				SendOnServerLegacySocket(lpPlayInfo->lpsmSock, (char *)lpTransPartySkill, lpTransPartySkill->size);
			}
		}
	}

	return TRUE;
}


smCHAR *rsOpenTier5SummonFromCanonicalName(const char *szCanonicalName, int x, int y, int z, rsPLAYINFO *lpPlayInfo)
{
	if(!szCanonicalName || !szCanonicalName[0])
		return NULL;

	// First keep the legacy behaviour for servers whose runtime monster name was not localized.
	smCHAR *lpChar = OpenMonsterFromName((char *)szCanonicalName, x, y, z, lpPlayInfo);
	if(lpChar)
		return lpChar;

	// Under _LANGUAGE_BRAZIL, ConvertMonsterNames() replaces chrMonsterList[].szName
	// with *J_NAME. InitMonster() computes dwAutoCharCode from the canonical name
	// before that conversion, so use it only as an alias to the same loaded template.
	const DWORD dwCanonicalCode = GetSpeedSum(szCanonicalName);
	for(int cnt = 0; cnt < chrMonsterCnt; cnt++)
	{
		if(chrMonInfoList[cnt].dwAutoCharCode != dwCanonicalCode)
			continue;
		if(!chrMonsterList[cnt].szName[0])
			continue;

		return OpenMonsterFromName(chrMonsterList[cnt].szName, x, y, z, lpPlayInfo);
	}

	return NULL;
}

static bool SummitMonsterIgnoresVanish(const smCHAR *lpChar)
{
	if(!lpChar) return true;

	const DWORD soundCode = lpChar->smCharInfo.dwCharSoundCode;
	return soundCode == snCHAR_SOUND_BABEL ||
		soundCode == snCHAR_SOUND_DEATHKNIGHT ||
		soundCode == snCHAR_SOUND_KELVEZU ||
		soundCode == snCHAR_SOUND_MOKOVA;
}

// Legacy Vanish changes the acquisition radius during the periodic target scan,
// but an already acquired lpTargetPlayInfo bypasses that scan and keeps attacking.
// Release normal monsters at cast time so Vanish applies immediately. Bosses that
// are explicitly immune in the legacy sight rule and active Compulsion targets
// intentionally keep their target.
static void SummitReleaseTargetsForVanish(rsPLAYINFO *lpPlayInfo)
{
	if(!lpPlayInfo) return;

	STG_AREA *lpStgArea = FindStageField(lpPlayInfo->Position.x, lpPlayInfo->Position.z);
	if(!lpStgArea) return;

	for(int cnt = 0; cnt < lpStgArea->MonsterLastPoint; cnt++)
	{
		smCHAR *lpMonster = lpStgArea->lpCharMonster[cnt];
		if(!lpMonster || !lpMonster->Flag || lpMonster->smCharInfo.Life[0] <= 0)
			continue;
		if(lpMonster->lpTargetPlayInfo != lpPlayInfo)
			continue;
		if(SummitMonsterIgnoresVanish(lpMonster))
			continue;

		// Compulsion is an explicit forced-target mechanic and must outrank stealth.
		if(lpMonster->dwCompulsionTime > dwPlayServTime &&
			lpMonster->lpCompulsionPlayInfo == lpPlayInfo)
			continue;

		(void)gameplay::combat::legacy::ServerLegacyTargetingAdapter().ClearPlayerTarget(
			gameplay::EntityId(static_cast<std::uint32_t>(lpMonster->dwObjectSerial)));
		lpMonster->dwTargetLockTime = 0;
		lpMonster->TragetTraceMode = 0;
		lpMonster->TargetMoveCount = 0;
	}
}

int rsRecvProcessSkill(rsPLAYINFO *lpPlayInfo, smTRANS_COMMAND *lpTransCommand)
{
	DWORD dwSkillCode;
	int point;
	rsPLAYINFO *lpPlayInfo2;
	smTRANS_COMMAND_EX	TransCommandEx;
	int	lv;
	smCHAR	*lpChar;
	int cnt, x, y, z, dist, size;

	dwSkillCode = lpTransCommand->WParam & 0xFF;
	point = (lpTransCommand->WParam >> 8) & 0xF;
	point -= 1;

	if(point < 0) point = lpTransCommand->LParam - 1;

	if(point < 0 || point >= 10) return FALSE;


	if(rsCheckSkillLevel(lpPlayInfo, dwSkillCode) == FALSE)
	{
		if(lpPlayInfo->WarningCount < 5 && dwSkillCode != SKILL_PLAY_RESURRECTION)
		{


			TransCommandEx.size = sizeof(smTRANS_COMMAND);
			TransCommandEx.code = OpCode::OPCODE_SET_BLACKLIST;
			TransCommandEx.WParam = 8850;
			TransCommandEx.LParam = lpPlayInfo->smCharInfo.Level;
			TransCommandEx.SParam = dwSkillCode;
			TransCommandEx.EParam = point;
			rsSendDataServer(lpPlayInfo->lpsmSock, &TransCommandEx);
			lpPlayInfo->WarningCount++;
		}
		return FALSE;
	}


	if(rsCheckTier5SkillAuthority(lpPlayInfo, dwSkillCode, point) == FALSE)
		return FALSE;

	switch(dwSkillCode)
	{
	case SKILL_PLAY_T51:
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_ATALANTA)
		{
			lpChar = rsOpenTier5SummonFromCanonicalName("Summon Tiger", lpPlayInfo->Position.x, lpPlayInfo->Position.y, lpPlayInfo->Position.z, lpPlayInfo);
			if(!lpChar) return FALSE;

			lpChar->dwUpdateCharInfoTime = dwPlayServTime + (DWORD)Atalanta_T5_SummonTiger_Duration[point] * 1000;
			lpChar->smCharInfo.Attack_Damage[0] = Atalanta_T5_SummonTiger_AttackPower[point];
			lpChar->smCharInfo.Attack_Damage[1] = Atalanta_T5_SummonTiger_AttackPower[point];
			lpChar->smCharInfo.Attack_Rating = Atalanta_T5_SummonTiger_AttackRating[point];
			lpChar->smCharInfo.Life[0] = Atalanta_T5_SummonTiger_Life[point];
			lpChar->smCharInfo.Life[1] = lpChar->smCharInfo.Life[0];
			lpChar->sMoveStepCount[0] = 1;
			lpChar->sMoveStepCount[1] = 2;
			lpChar->smCharInfo.wPlayClass[1] = fONE + point * 15;
			lpChar->HoSkillCode = SKILL_PLAY_T51;
			lpChar->HoSkillMode = 1;
			lpPlayInfo->lpLinkChar = lpChar;
			lpPlayInfo->dwLinkCharCode = lpChar->dwObjectSerial;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_PRIESTESS)
		{
			lpChar = rsOpenTier5SummonFromCanonicalName("Ice Elemental", lpPlayInfo->Position.x, lpPlayInfo->Position.y, lpPlayInfo->Position.z, lpPlayInfo);
			if(!lpChar) return FALSE;

			lpChar->dwUpdateCharInfoTime = dwPlayServTime + (DWORD)Priestess_T5_IceElemental_Duration[point] * 1000;
			lpChar->smCharInfo.Attack_Damage[0] = Priestess_T5_IceElemental_AttackPower[point];
			lpChar->smCharInfo.Attack_Damage[1] = Priestess_T5_IceElemental_AttackPower[point];
			lpChar->smCharInfo.Attack_Rating = Priestess_T5_IceElemental_AttackRating[point];
			lpChar->smCharInfo.Life[0] = Priestess_T5_IceElemental_Life[point];
			lpChar->smCharInfo.Life[1] = lpChar->smCharInfo.Life[0];
			lpChar->sMoveStepCount[0] = 1;
			lpChar->sMoveStepCount[1] = 2;
			lpChar->smCharInfo.wPlayClass[1] = fONE + (point + 1) * 15;
			lpChar->HoSkillCode = SKILL_PLAY_T51;
			lpChar->HoSkillMode = 1;
			lpPlayInfo->lpLinkChar = lpChar;
			lpPlayInfo->dwLinkCharCode = lpChar->dwObjectSerial;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_MAGICIAN)
		{
			// Wizard Trance duration/stat effects are represented by the client ContinueSkill state;
			// server still validates Tier-5 authority and accepts the process packet.
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE != JOBCODE_ARCHER) return FALSE;
		lpPlayInfo->dwSkill_ArcherLethal_Time = dwPlayServTime + 300000;
		lpPlayInfo->dwSkill_ArcherLethal_Point = point;
		break;

	case SKILL_PLAY_T52:
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_MAGICIAN)
		{
			if(Magician_T5_StoneSkin_ImmortalWindow[point] <= 0) return FALSE;
			lpPlayInfo->dwSkill_MagicianStoneSkin_Time = dwPlayServTime + (DWORD)Magician_T5_StoneSkin_ImmortalWindow[point] * 1000;
			lpPlayInfo->dwSkill_MagicianStoneSkin_Point = point;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE != JOBCODE_PIKEMAN) return FALSE;
		lpPlayInfo->dwSkill_PikeFocus_Time = dwPlayServTime + 300000;
		lpPlayInfo->dwSkill_PikeFocus_Point = point;
		break;

	case SKILL_PLAY_T53:
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_PIKEMAN)
		{
			lpPlayInfo->dwSkill_PikeDeathMaster_Time = dwPlayServTime + 300000;
			lpPlayInfo->dwSkill_PikeDeathMaster_Point = point;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_MECHANICIAN)
		{
			if(Hardening_Shield_Time[point] <= 0 || Hardening_Shield_DamageReduction[point] <= 0) return FALSE;
			lpPlayInfo->dwSkill_HardeningShield_Time = dwPlayServTime + (DWORD)Hardening_Shield_Time[point] * 1000;
			lpPlayInfo->dwSkill_HardeningShield_Point = point;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_FIGHTER)
		{
			lpPlayInfo->dwSkill_Ruthless_Active = 1;
			lpPlayInfo->dwSkill_Ruthless_Point = point;
			lpPlayInfo->dwSkill_Ruthless_HitCount = 0;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_KNIGHT)
		{
			if(Knight_T5_GloriousShield_Duration[point] <= 0 || Knight_T5_GloriousShield_DefenseBoost[point] <= 0) return FALSE;
			lpPlayInfo->dwSkill_KnightGloriousShield_Time = dwPlayServTime + (DWORD)Knight_T5_GloriousShield_Duration[point] * 1000;
			lpPlayInfo->dwSkill_KnightGloriousShield_Point = point;
			break;
		}
		return FALSE;

	case SKILL_PLAY_T54:
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_ARCHER)
		{
			if(Archer_T5_Bombard_Duration[point] <= 0 || Archer_T5_Bombard_MPDrain[point] <= 0 || Archer_T5_Bombard_SPDrain[point] <= 0) return FALSE;
			lpPlayInfo->dwSkill_ArcherBombard_EndTime = dwPlayServTime + (DWORD)Archer_T5_Bombard_Duration[point] * 1000;
			lpPlayInfo->dwSkill_ArcherBombard_NextTick = dwPlayServTime;
			lpPlayInfo->dwSkill_ArcherBombard_Point = point;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_MAGICIAN)
		{
			if(Magician_T5_Cataclysm_Duration[point] <= 0 || Magician_T5_Cataclysm_MPDrain[point] <= 0 || Magician_T5_Cataclysm_SPDrain[point] <= 0) return FALSE;
			lpPlayInfo->dwSkill_MagicianCataclysm_EndTime = dwPlayServTime + (DWORD)Magician_T5_Cataclysm_Duration[point] * 1000;
			lpPlayInfo->dwSkill_MagicianCataclysm_NextTick = dwPlayServTime;
			lpPlayInfo->dwSkill_MagicianCataclysm_Point = point;
			break;
		}
		if(lpPlayInfo->smCharInfo.JOB_CODE != JOBCODE_FIGHTER) return FALSE;
		if(Fighter_T5_Whirlwind_Duration[point] <= 0 || Fighter_T5_Whirlwind_MPDrain[point] <= 0 ||
		   Fighter_T5_Whirlwind_SPDrain[point] <= 0) return FALSE;
		lpPlayInfo->dwSkill_Whirlwind_EndTime = dwPlayServTime + (DWORD)Fighter_T5_Whirlwind_Duration[point] * 1000;
		lpPlayInfo->dwSkill_Whirlwind_NextTick = dwPlayServTime;
		lpPlayInfo->dwSkill_Whirlwind_Point = point;
		break;

	case SKILL_PLAY_HOLY_REFLECTION:
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_PRIESTESS)
		{

			lpPlayInfo->dwSkill_HolyReflection_Time = dwPlayServTime + Holy_Reflection_Time[point] * 1000;
			lpPlayInfo->dwSkill_HolyReflection_Param = Holy_Reflection_Return_Damage[point];
		}
		break;

	case SKILL_PLAY_ENCHANT_WEAPON:
		if(lpPlayInfo->smCharInfo.JOB_CODE == JOBCODE_MAGICIAN)
		{

			lpPlayInfo2 = srFindUserFromSerial(lpTransCommand->SParam);
			if(lpPlayInfo2 && lpPlayInfo2->lpsmSock)
			{
				lpPlayInfo2->dwSkill_EnchantWeapon_Time = dwPlayServTime + Enchant_Weapon_Time[point] * 1000;
				lpPlayInfo2->dwSkill_EnchantWeapon_Param = (point + 1) | (lpTransCommand->EParam << 8);
				if(lpPlayInfo2 != lpPlayInfo)
