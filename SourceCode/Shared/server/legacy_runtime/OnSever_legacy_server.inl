bool handlePlayerLoginOpcode(smTHREADSOCK* SockInfo)
{
	{
		FILE *fp = fopen("LOGS\\mingw_login_handshake_server.txt", "a");
		if(fp)
		{
			fprintf(fp, "[LOGIN_HANDLER_ENTER] sockInfo=%p\n", (void *)SockInfo);
			fflush(fp);
			fclose(fp);
		}
	}

	try
	{
		if (SockInfo)
		{
			smWINSOCK* lpsmSock = SockInfo->smMySock;

			if (lpsmSock)
			{
				rsPLAYINFO* playInfo = (rsPLAYINFO*)lpsmSock->ExtData1;

				if (playInfo)
				{
					bool recordAttack(rsPLAYINFO * player, const std::string & log);

					LoginPacket* command = (LoginPacket*)SockInfo->Buff;
					authentication::v2::legacy::ServerLegacyLoginSessionRegistry().BeginHandshake(playInfo);

				{
					FILE *fp = fopen("LOGS\\mingw_login_handshake_server.txt", "a");
					if(fp)
					{
						fprintf(fp,
							"[LOGIN_HANDLER_PACKET] playInfo=%p command=%p size=%d code=0x%08X accountLen=%u hashLen=%u\n",
							(void *)playInfo,
							(void *)command,
							command ? command->size : -1,
							command ? (unsigned)command->code : 0u,
							command ? (unsigned)strnlen(command->account, ACCOUNT_SIZE) : 0u,
							command ? (unsigned)strnlen(command->hash, sizeof(command->hash)) : 0u);
						fflush(fp);
						fclose(fp);
					}
				}

                    {
                        FILE *fpProbe =
                            SummitServerRuntimeTraceFile("LOGS\\mingw_real_server_login.txt");

                        if(fpProbe)
                        {
                            /* MINGW_LOGIN_VALIDATION_PROBE_V1 */
                            size_t probeAccountLen = 0;
                            size_t probePasswordLen = 0;
                            size_t probeHashLen = 0;
                            size_t probeMacLen = 0;

                            if(command)
                            {
                                probeAccountLen =
                                    strnlen(command->account, ACCOUNT_SIZE);

                                probePasswordLen =
                                    strnlen(command->password, PASSWORD_SIZE);

                                probeHashLen =
                                    strnlen(command->hash, sizeof(command->hash));

                                probeMacLen =
                                    strnlen(command->mac, sizeof(command->mac));
                            }

                            fprintf(
                                fpProbe,
                                "[HANDLER] command=%p size=%d code=0x%08X "
                                "account=[%.*s] accountLen=%u passwordLen=%u "
                                "hashLen=%u macLen=%u player=%p\n",
                                (void *)command,
                                command ? command->size : -1,
                                command ?
                                    (unsigned int)command->code : 0,
                                command ? ACCOUNT_SIZE : 0,
                                command ? command->account : "",
                                (unsigned int)probeAccountLen,
                                (unsigned int)probePasswordLen,
                                (unsigned int)probeHashLen,
                                (unsigned int)probeMacLen,
                                (void *)playInfo
                            );

                            fflush(fpProbe);
                            fclose(fpProbe);
                        }
                    }

					authentication::v2::LoginRequestValidationService loginValidationService;
					const authentication::v2::LoginRequestValidationResult validation =
						loginValidationService.Validate(authentication::v2::LoginRequestView(
							command->account, sizeof(command->account),
							command->password, sizeof(command->password),
							command->hash, sizeof(command->hash),
							command->mac, sizeof(command->mac)));


					if (!validation.Accepted())
					{
                        /* MINGW_LOGIN_VALIDATION_ERROR_PROBE_V1 */
                        {
                            FILE *fpProbe =
                                SummitServerRuntimeTraceFile("LOGS\\mingw_real_server_login.txt");

                            if(fpProbe)
                            {
                                fprintf(
                                    fpProbe,
                                    "[VALIDATION_ERROR] %s\\n",
                                    validation.Description()
                                );

                                fflush(fpProbe);
                                fclose(fpProbe);
                            }
                        }

						security::v2::SecurityFinding finding;
						finding.code = security::v2::SecurityFindingCode::MalformedLoginRequest;
						finding.category = security::v2::SecurityFindingCategory::InputValidation;
						finding.severity = security::v2::SecurityFindingSeverity::Critical;
						finding.source = security::v2::SecurityFindingSource::Authentication;
						finding.sessionId = authentication::v2::legacy::LegacyLoginSessionRegistry::IdOf(playInfo).value;
						finding.evidenceCode = static_cast<std::uint32_t>(validation.code);
						finding.evidenceValue = static_cast<std::uint64_t>(validation.observedLength);
						finding.occurredAt = static_cast<std::uint64_t>(dwPlayServTime);

						const security::v2::LegacyEquivalentSecurityPolicy securityPolicy;
						const security::v2::SecurityEnforcementAction enforcement = securityPolicy.Evaluate(finding);

						(void)security::v2::legacy::ServerLegacySecurityEnforcementAdapter().Apply(
							playInfo, enforcement,
							"Login Crash [ " + std::string(validation.Description()) + "]");

						cout << "Login Crash";

						return false;
					}

					size_t username_length = strlen(command->account);
					size_t password_length = strlen(command->password);
					size_t hash_length = strlen(command->hash);
					size_t mac_length = strlen(command->mac);

					/*	if(id_length < 4 || id_length > 32 || password_length != 32)
						{
							throw 1;
						}*/


					playInfo->setAccount(command->account);
					playInfo->setPassword(command->password);

					playInfo->dwCode_ID = GetSpeedSum(playInfo->getAccount());

					/* MINGW_AUTH_DIRECT_TRACE_V1 */
                        {
                            FILE *fpAuth = SummitServerRuntimeTraceFile("LOGS\\mingw_auth_direct.txt");
                            if(fpAuth)
                            {
                                fprintf(
                                    fpAuth,
                                    "[HANDLER_BEFORE_RSLOG] account=%s Server_SqlReady=%d sock=%p\n",
                                    command->account,
                                    Server_SqlReady,
                                    (void *)playInfo->lpsmSock);
                                fflush(fpAuth);
                                fclose(fpAuth);
                            }
                        }

						bool request_login = rsLogAccount(playInfo, command->account, command->password, command->mac, command->szPath, command->szPCName);

						{
							FILE *fp = fopen("LOGS\\mingw_login_handshake_server.txt", "a");
							if(fp)
							{
								fprintf(fp,
									"[AUTH_RESULT] requestLogin=%d sqlReady=%d\n",
									request_login ? 1 : 0,
									Server_SqlReady);
								fflush(fp);
								fclose(fp);
							}
						}

                        {
                            FILE *fpAuth = SummitServerRuntimeTraceFile("LOGS\\mingw_auth_direct.txt");
                            if(fpAuth)
                            {
                                fprintf(
                                    fpAuth,
                                    "[HANDLER_AFTER_RSLOG] account=%s request_login=%d Server_SqlReady=%d\n",
                                    command->account,
                                    request_login ? 1 : 0,
                                    Server_SqlReady);
                                fflush(fpAuth);
                                fclose(fpAuth);
                            }
                        }

					if (Server_SqlReady && !request_login)
					{
						smTRANS_COMMAND smTransCommand;
						smTransCommand.code = OpCode::OPCODE_FAILCONNECT;
						smTransCommand.size = sizeof(smTRANS_COMMAND);
						smTransCommand.WParam = (DWORD)0;
						smTransCommand.LParam = 0;
						smTransCommand.EParam = 1;
						SendOnServerLegacySocket(lpsmSock, (char*)&smTransCommand, smTransCommand.size);
						srLogFailedCount++;
					}

					return true;
				}
			}
		}
	}
	catch (...)
	{
		//LOG(LOG_SERVER, "[handlePlayerLoginOpcode] Error: ");
	}

	return false;
}

