			else
			{

				if(lpChar->PartyFlag != rsHARDCORE_EVENT_FLAG || (lpsItem->ItemInfo.CODE != (sinGG1 | sin01) && (lpsItem->ItemInfo.CODE&sinITEM_MASK1) != (sinPM1&sinITEM_MASK1)))
				{
					ALERTAHANDLER->AddItemLog(lprsPlayInfo, lpChar, &lpsItem->ItemInfo);

					if (lpChar->smCharInfo.wPlayClass[0] == MONSTER_CLASS_BOSS && (lpsItem->ItemInfo.CODE != (sinGG1 | sin01) && (lpsItem->ItemInfo.CODE & sinITEM_MASK1) != (sinPM1 & sinITEM_MASK1) && (lpsItem->ItemInfo.CODE & sinITEM_MASK1) != (sinPS1 & sinITEM_MASK1) && (lpsItem->ItemInfo.CODE & sinITEM_MASK1) != (sinPL1 & sinITEM_MASK1)))
					{
						vector<DWORD> vSerials;
						for (int i = 0; i < 15; i++)
						{
							if (lpChar->DropDamageList[i].dwUserCode)
							{
								vSerials.push_back(lpChar->DropDamageList[i].dwUserCode);
							}
						}

						ROLLHANDLER->CreateRoll(lpsItem, vSerials, lpChar->pX >> FLOATNS, lpChar->pY >> FLOATNS, lpChar->pZ >> FLOATNS, (STG_AREA*)lpChar->lpExt1);
					}
					else
						if ((lprsPlayInfo->dwTime_PrimeItem_GoldLooter && lpsItem->ItemInfo.CODE == (sinGG1 | sin01)) || (VIPHANDLER->returnVip(lprsPlayInfo) && lpsItem->ItemInfo.CODE == (sinGG1 | sin01)))
						{
							if (lpsItem->ItemInfo.CODE == (sinGG1 | sin01))
							{
								lpsItem->ItemInfo.Money -= (lpsItem->ItemInfo.Money * 20) / 100;
								ReformItem(&lpsItem->ItemInfo);
							}
							rsPutItem2(lprsPlayInfo, &lpsItem->ItemInfo);
						}
					else

					{
						lpsItem->state = TRUE;
						lpStgItem = ((STG_AREA *)lpChar->lpExt1)->AddItem(lpsItem, lpChar->pX >> FLOATNS, lpChar->pY >> FLOATNS, lpChar->pZ >> FLOATNS, TRUE);


						if (lpStgItem)
						{
							if (lpChar->smMonsterInfo.AllSeeItem)
							{
								((STG_AREA *)lpChar->lpExt1)->SendStgItemToNearUsers(lpStgItem);
							}
							else
							{
								bool sended = false;
								for (int i = 0; i < 15; i++)
								{
									if (lpChar->DropDamageList[i].dwUserCode)
									{
										rsPLAYINFO* dropInfo = FindUserFromCode(lpChar->DropDamageList[i].dwUserCode);
										if (dropInfo)
										{
											sended = true;
											((STG_AREA*)lpChar->lpExt1)->SendStgItem(dropInfo, lpStgItem);
										}
									}
								}

								if (!sended && DmgPlayUse)
								{

									for (cnt2 = 0; cnt2 < 6; cnt2++)
									{
										if (lpDamagePlayInfo[cnt2])
										{
											((STG_AREA*)lpChar->lpExt1)->SendStgItem(lpDamagePlayInfo[cnt2], lpStgItem);
										}
									}
								}
								else
									((STG_AREA*)lpChar->lpExt1)->SendStgItem(lprsPlayInfo, lpStgItem);


								lpStgItem->dwCreateTime += 5000;
							}
						}
					}
				}
			}
		}
	}


	if(lprsPlayInfo->BadPlayer)
	{

		cnt = lprsPlayInfo->MonsterKillCounter;
		if(cnt > 45) cnt = 45;
		cnt = (lpChar->smMonsterInfo.GetExp*cnt) / 50;
		lpChar->smMonsterInfo.GetExp -= cnt;
	}

	int	ExpBack = 0;


	if (rsServerConfig.Event_ExpUp)
	{
		ExpBack = lpChar->smMonsterInfo.GetExp;

#ifdef	_LANGUAGE_PHILIPIN
		int ExpBackup;



		if (lprsPlayInfo->smCharInfo.Level < 25) ExpBackup = 400;

		else
		{
			if (rsServerConfig.Event_ExpUp >= 100 && rsServerConfig.Event_ExpUp < 200)
				lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 100) / 100;
			else if (rsServerConfig.Event_ExpUp >= 200 && rsServerConfig.Event_ExpUp < 300)
				lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 200) / 100;
			else if (rsServerConfig.Event_ExpUp >= 300 && rsServerConfig.Event_ExpUp < 400)
				lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 300) / 100;
			else if (rsServerConfig.Event_ExpUp >= 400)
				lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 400) / 100;


			else
				lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 100) / 100;

		}

#else
		if (rsServerConfig.Event_ExpUp >= 100 && rsServerConfig.Event_ExpUp < 200)
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 100) / 100;
		else if (rsServerConfig.Event_ExpUp >= 200 && rsServerConfig.Event_ExpUp < 300)
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 200) / 100;
		else if (rsServerConfig.Event_ExpUp >= 300 && rsServerConfig.Event_ExpUp < 400)
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 300) / 100;
		else if (rsServerConfig.Event_ExpUp >= 400)
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 400) / 100;
		else
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 100) / 100;

#endif

	}

#ifdef _LANGUAGE_ARGENTINA
	if (rsServerConfig.Event_ExpUp_latin)
	{
		ExpBack = lpChar->smMonsterInfo.GetExp;

		if (lprsPlayInfo->smCharInfo.Level <= 20)
		{
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 200) / 100;
		}
		else if (lprsPlayInfo->smCharInfo.Level > 20 && lprsPlayInfo->smCharInfo.Level <= 30)
		{
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 100) / 100;
		}
		else if (lprsPlayInfo->smCharInfo.Level > 80 && lprsPlayInfo->smCharInfo.Level <= 90)
		{
			lpChar->smMonsterInfo.GetExp += (lpChar->smMonsterInfo.GetExp * 100) / 100;
		}
		else
		{
			lpChar->smMonsterInfo.GetExp;
		}
	}
#endif



	if(lprsPlayInfo->dwPartyInfo)
	{

		if(!lprsPlayInfo->lpPartyMaster || lprsPlayInfo->lpPartyMaster->GetPartyExp(lpChar, lprsPlayInfo) == FALSE)
		{

			SummitOnServerClearPartyMembership(lprsPlayInfo);
		}
	}
	else
	{
		gameplay::events::legacy::ServerLegacyGameplayEventAdapter().PublishMonsterKilled(lprsPlayInfo, lpChar, false);

		INT64 PlayerEXP = srGetTotalExp(lpChar->smMonsterInfo.GetExp, lpChar->smCharInfo.Level - lprsPlayInfo->smCharInfo.Level, lprsPlayInfo);

		const gameplay::PlayerId companionOwnerId =
			gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lprsPlayInfo);
		int companionCount = static_cast<int>(
			gameplay::companions::legacy::ServerLegacyCompanionQueryAdapter().ActiveCount(companionOwnerId));
		float companionPartyRate = 0.0f;
		if(companionCount > 0)
		{
			LoadPartyExpTable();
			int effectivePartyCount = 1 + companionCount;
			if(effectivePartyCount > 8) effectivePartyCount = 8;
			PlayerEXP = static_cast<INT64>(
				PlayerEXP * PartyExpTable[effectivePartyCount - 1][0]);
			companionPartyRate = PartyExpTable[effectivePartyCount - 1][1];
		}

		if(companionPartyRate > 0.0f)
		{
			gameplay::companions::AwardExperience(
				lprsPlayInfo, lpChar, companionPartyRate);
		}

		if (PlayerEXP)
		{

			int ExpUp = 0;

			if(lprsPlayInfo->dwTime_PrimeItem_ExpUp > 0)
			{
				switch(lprsPlayInfo->dwPrimeItem_PackageCode)
				{
				case PRIME_ITEM_PACKAGE_NONE:					ExpUp += 30;					break;
				case PRIME_ITEM_PACKAGE_BRONZE:					ExpUp += 10;					break;
				case PRIME_ITEM_PACKAGE_SILVER:					ExpUp += 20;					break;
				case PRIME_ITEM_PACKAGE_GOLD:					ExpUp += 30;					break;
				case PRIME_ITEM_PACKAGE_ULTRA:					ExpUp += 40;					break;
				case PRIME_ITEM_PACKAGE_NONE_50_EXPUP:			ExpUp += 50;					break;
				case PRIME_ITEM_PACKAGE_NONE_100_EXPUP:			ExpUp += 100;					break;
				}


			}
			int	FallRandom = 0;

			if (lprsPlayInfo->ModoPvP_Drop > 0)
			    ExpUp += 10;

			if (rsHasPCBangGameplayEntitlement(lprsPlayInfo))
			{
				ExpUp += 20;
			}

			if (lprsPlayInfo->dwTime_PrimeItem_PhenixPet > 0)
			{
				ExpUp += 10;
			}

			if (VIPHANDLER->returnVip(lprsPlayInfo))
				ExpUp += 15;

			if (rsServerConfig.ExpGameTimeMode)
			{
				PlayerEXP = (PlayerEXP * rsGetExp_GameTime(lprsPlayInfo)) / 100;
			}

			if (ExpUp)
			{
				PlayerEXP += (PlayerEXP * ExpUp) / 100;
			}

			// Covenant XP affects monster experience only. Keeping this here, rather
			// than inside AddExp(), prevents it from altering quest/admin rewards.
			{
				const double covenantExp = gameplay::progression::ApplyServerCovenantModifierValue(
					lprsPlayInfo->getName() ? lprsPlayInfo->getName() : "",
					"xp.monster_gain", "monster", static_cast<double>(PlayerEXP), true,
					lpChar->dwObjectSerial);
				PlayerEXP = covenantExp > 0.0 ? static_cast<INT64>(covenantExp) : 0;
			}

			lprsPlayInfo->spEXP_Out += PlayerEXP;

			//lprsPlayInfo->ExpFlag++;

			(void)gameplay::progression::PlayerExperienceService::Grant(
				gameplay::progression::legacy::ServerLegacyPlayerExperienceAdapter(),
				gameplay::progression::PlayerExperienceGrantRequest(
					gameplay::player::legacy::ServerLegacyOnlinePlayerRegistry().IdOf(lprsPlayInfo),
					static_cast<gameplay::progression::PlayerExperienceAmount>(PlayerEXP),
					gameplay::EntityId(static_cast<std::uint32_t>(lpChar->dwObjectSerial)), false,
					gameplay::progression::PlayerExperienceSource::MonsterSolo));
		}
	}

	if (ExpBack)
	{
		lpChar->smMonsterInfo.GetExp = ExpBack;
	}


	//add xp monstros PASSE de batalha
	if ((lprsPlayInfo->smCharInfo.Level - lpChar->smCharInfo.Level) <= 20) {
		BattlePass::GetInstance()->AddExpBattlePass(lprsPlayInfo, 1);
		BattlePass::GetInstance()->SendBPInfoToGame(lprsPlayInfo);
	}


	//pega info das JOBS para comp
	int VTNClvl;
	int Job;
	char szQuery[512];


	SQL::GetInstance()->EnterSqlSection();
	wsprintf(szQuery, "SELECT * FROM [JOBS].[dbo].[Jobs_Info] WHERE [ID]='%s'", lprsPlayInfo->getAccount());
	if (SQL::GetInstance()->Execute(szQuery))
	{
		if (SQL::GetInstance()->Fetch())
		{
			SQL::GetInstance()->GetDataValue(3, &Job);
			SQL::GetInstance()->GetDataValue(4, &VTNClvl);
		}
	}
	SQL::GetInstance()->LeaveSqlSection();


	//add JOBS
	int Chancedrop = GetRandomPos(1, 100);
	if (strcmp(lpChar->smCharInfo.szName, "Hopi") == 0) {

		JOBS::GetInstance()->AddExpJOBS(lprsPlayInfo, 1);
		if (VTNClvl >= 5)
		{
			if (Chancedrop <= 30)
			{
				if (VTNClvl >= 15 && Job == 5)
				{
					JOBS::GetInstance()->AddminJOBS(lprsPlayInfo, 2, Job);
				}
				else
				{
					JOBS::GetInstance()->AddminJOBS(lprsPlayInfo, 1, Job);
				}
			}
		}
		else
		{
			if (Chancedrop <= 20)
			{
				if (VTNClvl >= 15 && Job == 5)
				{
					JOBS::GetInstance()->AddminJOBS(lprsPlayInfo, 2, Job);
				}
				else
				{
					JOBS::GetInstance()->AddminJOBS(lprsPlayInfo, 1, Job);
				}
			}
		}
		JOBS::GetInstance()->SendJOBInfoToGame(lprsPlayInfo);
	}

	lprsPlayInfo->MonsterKillCounter++;

	rsMonHuntCount++;

	return TRUE;
}


int rsOpen_MonsterItemExp(rsKILL_MONSTER_INFO *lpKillMonInfo)
{
	rsPLAYINFO *lprsPlayInfo;
	smCHAR	smChar;
	int		cnt;

	for(cnt = 0; cnt < chrMonsterCnt; cnt++)
	{
		if(chrMonInfoList[cnt].dwAutoCharCode == lpKillMonInfo->dwAutoCharCode &&
			chrMonsterList[cnt].dwCharSoundCode == lpKillMonInfo->dwCharSoundCode)
		{

			memcpy(&smChar.smCharInfo, &chrMonsterList[cnt], sizeof(smCHAR_INFO));
			memcpy(&smChar.smMonsterInfo, &chrMonInfoList[cnt], sizeof(smCHAR_MONSTER_INFO));
			break;
		}
	}
	if(cnt >= chrMonsterCnt) return FALSE;
	if(!StageArea || lpKillMonInfo->Area < 0 || lpKillMonInfo->Area >= StageAreaCount) return FALSE;

	if(lpKillMonInfo->PartyFlag == rsHARDCORE_EVENT_FLAG && lpKillMonInfo->dwParam[0] >= sinPM1)
	{


		CreatePresentItem(lpKillMonInfo->dwParam[0], &StageArea[lpKillMonInfo->Area], lpKillMonInfo->x, lpKillMonInfo->y, lpKillMonInfo->z, 3);
		return TRUE;
	}

	lprsPlayInfo = srFindUserFromSerial(lpKillMonInfo->dwUserObjectSerial);
	if(!lprsPlayInfo) return FALSE;

	smChar.pX = lpKillMonInfo->x;
	smChar.pY = lpKillMonInfo->y;
	smChar.pZ = lpKillMonInfo->z;
	smChar.dwObjectSerial = lpKillMonInfo->dwMonObjectSerial;
	smChar.PartyFlag = lpKillMonInfo->PartyFlag;
	smChar.lpExt1 = &StageArea[lpKillMonInfo->Area];
	smChar.lpExt2 = 0;
	smChar.lpExt3 = 0;
	smChar.lpExt4 = 0;

	return rsOpen_MonsterItemExp(&smChar, lprsPlayInfo);
}

// The localized skill contract says Vanish makes the Pikeman invisible to
// monsters for its duration. The old acquisition code only reduced Sight by
// Vanish_Range, which still allowed nearby monsters to acquire the player.
// Keep the four legacy boss immunities, but hide the player completely from
// normal monster acquisition while the buff is active.
static bool SummitVanishHidesPlayerFromMonster(const smCHAR *lpChar, const rsPLAYINFO *lpPlayInfo)
{
	if(!lpChar || !lpPlayInfo || !lpPlayInfo->dwSkill_Vanish_Time ||
		lpPlayInfo->dwSkill_Vanish_Time < dwPlayServTime)
		return false;

	const DWORD soundCode = lpChar->smCharInfo.dwCharSoundCode;
	return soundCode != snCHAR_SOUND_BABEL &&
		soundCode != snCHAR_SOUND_DEATHKNIGHT &&
		soundCode != snCHAR_SOUND_KELVEZU &&
		soundCode != snCHAR_SOUND_MOKOVA;
}

//Eventos Chat
int srAutoCharMain(smCHAR *lpChar)
{

#ifdef _W_SERVER

	int pX, pZ, pY;
	int rX, rZ, rY;
	int dist, dist2;
	int MinDist;
	rsPLAYINFO	*lprsPlayInfo;
