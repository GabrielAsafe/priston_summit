int NumLineComa64(INT64 Num, char *pBuff)
{

	int i = 0;
	char strBuff[128];
	wsprintf(strBuff, "%I64i", Num);
	int cnt = 0;
	int cnt2 = 0;
	int cnt3 = 0;

	int len = lstrlen(strBuff);
	while (1)
	{
		if (strBuff[cnt])
		{
			pBuff[cnt + cnt2] = strBuff[cnt];
			cnt3 = (len - 1) - cnt;
			if ((cnt3 % 3) == 0 && cnt3 != 0)
			{
				cnt2++;
				pBuff[cnt + cnt2] = ',';
			}
			cnt++;

		}
		else break;
	}

	return TRUE;
}

