		if (lpChar->MotionInfo->State == CHRMOTION_STATE_DEAD)
		{

			if (lpChar->lpAttackDamageList)
			{
				ZeroMemory(&lpChar->DropDamageList, sizeof(ATTACK_DAMAGE_LIST) * 15);

				int percent = 5;

				if (percent > 0)
				{
					int dropcount = 0;
					while (dropcount <= 0 && percent >= 0)
					{
						for (int i = 0; i < ATTACK_DAMAGE_LIST_MAX; i++)
						{
							if (lpChar->lpAttackDamageList[i].dwUserCode)
							{
								float dmg = lpChar->smCharInfo.Life[1] * ((float)percent / 100.f);
								if (lpChar->lpAttackDamageList[i].DamageCount >= dmg)
								{
									lpChar->DropDamageList[dropcount].dwUserCode = lpChar->lpAttackDamageList[i].dwUserCode;
									lpChar->DropDamageList[dropcount].Count = lpChar->lpAttackDamageList[i].Count;
									lpChar->DropDamageList[dropcount].DamageCount = lpChar->lpAttackDamageList[i].DamageCount;

									dropcount++;
								}
							}

							if (dropcount > 14)
								break;
						}

						if (dropcount == 0)
							percent--;
						if (dropcount > 0)
							break;
					}
				}


				if (lpChar->smCharInfo.dwCharSoundCode != snCHAR_SOUND_CASTLE_TOWER_B)
				{

					SelectDamageTop10(lpChar, &rsUserListDamageTop10);
				}

				delete lpChar->lpAttackDamageList;
				lpChar->lpAttackDamageList = 0;
			}


			if(lpChar->lpExt2 && lpChar->FrameCounter > 128 && !lpChar->lpMasterPlayInfo)
			{
