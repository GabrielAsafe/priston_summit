	}
	return true;
}

DWORD RewardTime_logado = 0;
BOOL First_Run_Logado = TRUE;
int LogadoPremiado()
{
	SYSTEMTIME	st;
	TRANS_CHATMESSAGE smTransChatMessage;
	std::shared_ptr<SQLConnection> db = SQLConnection::GetConnection(DATABASEID_ServerDB);

	if (!db)
		return FALSE;

	GetLocalTime(&st);

	if (RewardTime_logado < dwPlayServTime && PlayerCount)
	{
		RewardTime_logado = dwPlayServTime + (1000 * 60 * LogadoDelay);
		if (First_Run_Logado)
			return First_Run_Logado = FALSE;

		int cnt, cnt2;
		std::vector<rsPLAYINFO*> Logados;

		for (cnt = 0; cnt < CONNECTMAX; cnt++) {
			if (rsPlayInfo[cnt].lpsmSock && lstrlenA(rsPlayInfo[cnt].getAccount()) && lstrlenA(rsPlayInfo[cnt].getName()))
				Logados.push_back(&rsPlayInfo[cnt]);
		}

		if (!Logados.size())
			return FALSE;

		cnt = rand() % Logados.size();

		if (db->Open()) {
			if (db->Prepare("SELECT ItemCode FROM [LogadoPremiado].[dbo].[ItemList]")) {
				if (db->Execute()) {
					char szItem[50][16];
					int ItemCount = 0;
					while (db->NextRow()) {
						db->GetData(&szItem[ItemCount], 16, 1, PARAMTYPE_String);
						ItemCount++;
					}

					if (ItemCount > 0) {
						cnt2 = rand() % ItemCount;

						psITEM* lpsItem = new psITEM;
						TRANS_ITEMINFO	TransItemInfo;

						if (srSetItemFromCode(lpsItem, szItem[cnt2]))
						{
							TransItemInfo.code = OpCode::OPCODE_PUTITEM;
							TransItemInfo.size = sizeof(TRANS_ITEMINFO);
							memcpy(&TransItemInfo.Item, &lpsItem->ItemInfo, sizeof(sITEMINFO));

							rsRegist_ItemSecCode(Logados[cnt], &TransItemInfo, 1);

							SendOnServerLegacySocket(Logados[cnt]->lpsmSock, (char*)&TransItemInfo, TransItemInfo.size);

							smTransChatMessage.size = sizeof(TRANS_CHATMESSAGE);
							smTransChatMessage.code = OpCode::OPCODE_WHISPERMESSAGE;
							smTransChatMessage.dwIP = 5;
							smTransChatMessage.dwObjectSerial = 0;
							wsprintf(smTransChatMessage.szMessage, "Logado Premiado> %s acaba de ganhar: %s!", Logados[cnt]->getName(), lpsItem->ItemInfo.ItemName);
							SendToAll((char*)&smTransChatMessage, smTransChatMessage.size);
						}
					}
				}
			}
			db->Close();
		}
	}

	return TRUE;
}

