+static void LogSQLiteLocalAuthStage(const char *userID, const char *stage, const char *detail)
+{
+	FILE *fp = fopen("LOGS\\mingw_sqlite_local_auth.txt", "a");
+	if(!fp)
+		return;
+	fprintf(
+		fp,
+		"[SQLITE_LOCAL_AUTH] user=%s stage=%s%s%s\n",
+		userID ? userID : "",
+		stage ? stage : "",
+		(detail && detail[0]) ? " detail=" : "",
+		(detail && detail[0]) ? detail : "");
+	fflush(fp);
+	fclose(fp);
+}
