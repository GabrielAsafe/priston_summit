+static BOOL TrySQLiteLocalSiegeMoneyTax(
+    const char *clanMarkNum,
+    INT64 mixing,
+    INT64 aging,
+    INT64 shop,
+    INT64 poison1,
+    INT64 poison2,
+    INT64 poison3,
+    INT64 force,
+    INT64 warpgate,
+    INT64 skill,
+    INT64 total,
+    INT64 tax,
+    BOOL *outResult)
+{
+    if(!outResult)
+        return FALSE;
+
+    *outResult = FALSE;
+
+    if(total == 0)
+        return TRUE;
+
+    if(!clanMarkNum)
+        return TRUE;
+
+    const size_t markLength = strlen(clanMarkNum);
+    if(markLength < 9)
+        return TRUE;
+
+    const char *idxText = clanMarkNum + (markLength - 6);
+    for(const char *p = idxText; *p; ++p)
+    {
+        if(*p < '0' || *p > '9')
+            return TRUE;
+    }
+
+    const int clanIdx = atoi(idxText);
+    if(clanIdx == 0)
+        return TRUE;
