template <typename CodeType, typename Compare>
inline bool ResolveCharacterSoundCodeShared(const char *name, CodeType &code, Compare compare)
{
    if(!name)
        return false;

    const CharacterSoundCodeEntry *entries = CharacterSoundCodeEntries();
    for(int index = 0; entries[index].code; ++index)
    {
        if(compare(entries[index].name, name) == 0)
        {
            code = static_cast<CodeType>(entries[index].code);
            return true;
        }
    }
    return false;
}

