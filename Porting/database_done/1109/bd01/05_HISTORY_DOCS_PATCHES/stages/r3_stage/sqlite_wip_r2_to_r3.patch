+The compatibility layer currently handles the SQL Server constructs still found in active callers: qualified database names, `SELECT TOP N`, `GETDATE()` (preserved as server-local `datetime('now','localtime')`), `DATEADD(DAY, literal, GETDATE())`, `DAY/MONTH`, and known collations. SQL Server control-flow (`IF/BEGIN/ELSE`) is intentionally rejected; those queries must be migrated explicitly at the caller so bind numbering and write semantics stay reviewable.
 
 `SqliteQueryCompat` is implemented as an `.inl` included by `SQLiteConnection.cpp`. This is intentional: the validated source graph authorizes only one new server translation unit for the SQLite backend.
 
 Schema migration is versioned under `Database/migrations/`. Do not enable/claim a logical database as migrated until all of its tables, positional `SELECT *` contracts, required keys/constraints, and seeds have been reconstructed and validated. In particular, `INSERT OR IGNORE` / `INSERT OR REPLACE` must not be relied on without a matching UNIQUE/PRIMARY KEY constraint.
+
+## Automatic migration bootstrap
+
+`SQLiteConnection::Init()` applies the ordered files `001` through `008` from `Database/migrations/` against the shared physical database before the connection becomes usable. Migration state is stored in `PRAGMA user_version`; every migration is transactional (`BEGIN IMMEDIATE` / rollback on error). Pending migration files are mandatory, and a database whose `user_version` is newer than the server-supported version is rejected rather than silently downgraded.
+
+This bootstrap only guarantees the currently reconstructed schema subset. It does not claim that all historical logical databases/tables are ready yet.
diff --git a/SrcServer/src/systems/persistence/database/sqlite/SQLiteConnection.cpp b/SrcServer/src/systems/persistence/database/sqlite/SQLiteConnection.cpp
index cd286da..df5d649 100644
--- a/SrcServer/src/systems/persistence/database/sqlite/SQLiteConnection.cpp
+++ b/SrcServer/src/systems/persistence/database/sqlite/SQLiteConnection.cpp
@@ -5,7 +5,9 @@
 #include <windows.h>
 
 #include <cstdio>
+#include <cstdlib>
 #include <cstring>
+#include <fstream>
 #include <sstream>
 #include <string>
 
@@ -149,6 +151,143 @@ struct SQLiteConnection::Impl
 		return true;
 	}
 
+	static int UserVersionCallback(void *context, int argc, char **argv, char **)
+	{
+		if(!context || argc < 1 || !argv || !argv[0])
+			return 0;
+		*static_cast<int *>(context) = std::atoi(argv[0]);
+		return 0;
+	}
+
+	bool ReadUserVersion(int &version)
+	{
+		version = 0;
+		if(exec(database, "PRAGMA user_version;", &UserVersionCallback, &version, nullptr) != SQLITE_OK)
+		{
+			SetDatabaseError("SQLite: falha ao ler PRAGMA user_version.");
+			return false;
+		}
+		return true;
+	}
+
+	bool ReadMigrationFile(const std::string &path, std::string &contents)
+	{
+		std::ifstream file(path.c_str(), std::ios::in | std::ios::binary);
+		if(!file)
+		{
+			lastError = "SQLite: migration ausente: ";
+			lastError += path;
+			return false;
+		}
+
+		std::ostringstream buffer;
+		buffer << file.rdbuf();
+		if(!file.good() && !file.eof())
+		{
+			lastError = "SQLite: falha ao ler migration: ";
+			lastError += path;
+			return false;
+		}
+
+		contents = buffer.str();
+		if(contents.empty())
+		{
+			lastError = "SQLite: migration vazia: ";
+			lastError += path;
+			return false;
+		}
+		return true;
+	}
+
+	bool ApplyMigrations(const char *databaseDirectory)
+	{
+		struct MigrationSpec
+		{
+			int version;
+			const char *filename;
+		};
+
+		static const MigrationSpec migrations[] =
+		{
+			{ 1, "001_accountdb.sql" },
+			{ 2, "002_coinshopdb.sql" },
+			{ 3, "003_questdb_core.sql" },
+			{ 4, "004_serverdb_pvp.sql" },
+			{ 5, "005_questdb_progress.sql" },
+			{ 6, "006_serverdb_active_contracts.sql" },
+			{ 7, "007_securitydb_active_contracts.sql" },
+			{ 8, "008_serverdb_premiumdata.sql" }
+		};
+
+		int currentVersion = 0;
+		if(!ReadUserVersion(currentVersion))
+			return false;
+
+		const int latestVersion = migrations[(sizeof(migrations) / sizeof(migrations[0])) - 1].version;
+		if(currentVersion > latestVersion)
