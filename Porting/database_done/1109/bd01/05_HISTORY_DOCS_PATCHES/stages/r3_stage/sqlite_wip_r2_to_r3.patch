+    "TimeLeft" INTEGER NOT NULL,
+    "ItemType" INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS "ServerDB__PremiumData_CharacterName"
+    ON "ServerDB__PremiumData" ("CharacterName");
