diff --git a/Database/migrations/005_questdb_progress.sql b/Database/migrations/005_questdb_progress.sql
new file mode 100644
index 0000000..287b672
--- /dev/null
+++ b/Database/migrations/005_questdb_progress.sql
@@ -0,0 +1,25 @@
+-- Summit SQLite migration 005: QuestDB Progress positional contract.
+-- Active INSERT INTO Progress statements provide exactly five values, while
+-- SELECT * callers read QuestID/QuestKind/QuestType from columns 1/2/3.
+-- Therefore this five-column order is part of the legacy persistence ABI.
+
+CREATE TABLE IF NOT EXISTS "QuestDB__Progress"
+(
+    "QuestID" INTEGER NOT NULL,
+    "QuestKind" INTEGER NOT NULL,
+    "QuestType" INTEGER NOT NULL,
+    "PlayerName" TEXT NOT NULL,
+    "StartDate" TEXT NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS "QuestDB__Progress_PlayerName"
+    ON "QuestDB__Progress" ("PlayerName");
+
+CREATE INDEX IF NOT EXISTS "QuestDB__Progress_QuestKind_PlayerName"
+    ON "QuestDB__Progress" ("QuestKind", "PlayerName");
+
+CREATE INDEX IF NOT EXISTS "QuestDB__Progress_Quest_Player"
+    ON "QuestDB__Progress" ("QuestID", "QuestKind", "QuestType", "PlayerName");
+
+CREATE INDEX IF NOT EXISTS "QuestDB__Complete_PlayerName"
+    ON "QuestDB__Complete" ("PlayerName");
diff --git a/Database/migrations/006_serverdb_active_contracts.sql b/Database/migrations/006_serverdb_active_contracts.sql
new file mode 100644
index 0000000..544d814
--- /dev/null
+++ b/Database/migrations/006_serverdb_active_contracts.sql
@@ -0,0 +1,31 @@
+-- Summit SQLite migration 006: ServerDB tables whose active layout is proven
+-- by named writes and/or positional SELECT * reads in the current server.
+
+-- InsertDB names all four columns; SELECT * reads IdVip from column 2.
+CREATE TABLE IF NOT EXISTS "ServerDB__Vip"
+(
+    "PlayerName" TEXT NOT NULL,
+    "IdVip" INTEGER NOT NULL,
+    "DateStart" TEXT NOT NULL,
+    "DateEnd" TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS "ServerDB__Vip_PlayerName"
+    ON "ServerDB__Vip" ("PlayerName");
+
+-- OpenPremiumBox now projects ItemCode/Count/Class explicitly and filters by Kind;
+-- the migration no longer depends on an unknown legacy SELECT * column order.
+CREATE TABLE IF NOT EXISTS "ServerDB__BoxRewards"
+(
+    "Kind" INTEGER NOT NULL,
+    "ItemCode" TEXT NOT NULL,
+    "Count" INTEGER NOT NULL,
+    "Class" INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS "ServerDB__BoxRewards_Kind"
+    ON "ServerDB__BoxRewards" ("Kind");
+
+-- The active contract selects only ItemCode; no positional SELECT * dependency.
+CREATE TABLE IF NOT EXISTS "ServerDB__DropLogAlert"
+(
+    "ItemCode" TEXT NOT NULL
+);
diff --git a/Database/migrations/007_securitydb_active_contracts.sql b/Database/migrations/007_securitydb_active_contracts.sql
new file mode 100644
index 0000000..26e0efa
--- /dev/null
+++ b/Database/migrations/007_securitydb_active_contracts.sql
@@ -0,0 +1,35 @@
+-- Summit SQLite migration 007: SecurityDB contracts directly supported by
+-- active queries. Ambiguous legacy tables remain intentionally absent.
+
+-- InsertAgingFailed now names all seven used columns explicitly. SELECT/DELETE
+-- callers also use named predicates/projections, removing any dependency on an
+-- unused SQL Server IDENTITY column that may have existed in the legacy table.
+CREATE TABLE IF NOT EXISTS "SecurityDB__AgingFailed"
+(
+    "PlayerID" TEXT NOT NULL,
+    "PlayerName" TEXT NOT NULL,
+    "ItemName" TEXT NOT NULL,
+    "ItemAging" INTEGER NOT NULL,
+    "Head" INTEGER NOT NULL,
+    "ChkSum" INTEGER NOT NULL,
+    "Date" TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS "SecurityDB__AgingFailed_PlayerItem"
+    ON "SecurityDB__AgingFailed" ("PlayerID", "PlayerName", "Head", "ChkSum");
+
+-- recordAttack names every column explicitly, so column order is not a caller ABI.
+CREATE TABLE IF NOT EXISTS "SecurityDB__Security"
+(
+    "AccountId" TEXT NOT NULL,
+    "IP" TEXT NOT NULL,
+    "Date" TEXT NOT NULL,
+    "Protocol" TEXT NOT NULL
+);
+
+-- RecordWindowLog only tests whether a row exists for ClassName.
+CREATE TABLE IF NOT EXISTS "SecurityDB__ClassCheatList"
+(
+    "ClassName" TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS "SecurityDB__ClassCheatList_ClassName"
+    ON "SecurityDB__ClassCheatList" ("ClassName");
