   285				wsprintf(DownUserCharacterInfo[index].Name, "%s", ServerUserCharacterInfo->CharInfo[index].szName);
   286				DownUserCharacterInfo[index].Level = ServerUserCharacterInfo->CharInfo[index].Level;
   287	
   288				wsprintf(DownUserCharacterInfo[index].BodyName, "%s", ServerUserCharacterInfo->CharInfo[index].szModelName);
   289				wsprintf(DownUserCharacterInfo[index].FaceName, "%s", ServerUserCharacterInfo->CharInfo[index].szModelName2);
   290	
   291				DownUserCharacterInfo[index].Job = ServerUserCharacterInfo->CharInfo[index].JOB_CODE;
   292				DownUserCharacterInfo[index].StartField = ServerUserCharacterInfo->CharInfo[index].StartField;
   293	
   294				DownUserCharacterInfo[index].PosX = ServerUserCharacterInfo->CharInfo[index].PosX;
   295				DownUserCharacterInfo[index].PosZ = ServerUserCharacterInfo->CharInfo[index].PosZ;
   296	
   297	
   298			}
   299			DownUserCharacterCount = ServerUserCharacterInfo->PlayUserCount;
   300		}
   301		else if(dwCode == OpCode::OPCODE_SERVER_INFO)
   302		{
   303			DownServerListInfo = (TRANS_SERVER_LIST *)RecvBuff;
   304	
   305	#ifdef __MINGW32__
   306			{
   307				FILE *fp = fopen("LOGS\\mingw_ho_recv.txt", "a");
   308				if(fp)
   309				{
   310					fprintf(
   311						fp,
   312						"SERVER_INFO name=[%s] count=%d\n",
   313						DownServerListInfo->szServerName,
   314						DownServerListInfo->ServerCount
   315					);
   316					fclose(fp);
   317				}
   318			}
   319	#endif
   320	
   321			memset(UserServerListInfo, 0, sizeof(UserServerListInfo));
   322			UserServerListInfoCount = 0;
   323	
   324			strcpy_s(szConnServerName, DownServerListInfo->szServerName);
   325	
   326	
   327			for(int index = 0; index < DownServerListInfo->ServerCount; index++)
   328			{
   329				memcpy(UserServerListInfo[index].szServerName, DownServerListInfo->ServerInfo[index].szServerName, strlen(DownServerListInfo->ServerInfo[index].szServerName));
   330				memcpy(UserServerListInfo[index].szServerIp1, DownServerListInfo->ServerInfo[index].szServerIp1, strlen(DownServerListInfo->ServerInfo[index].szServerIp1));
   331				memcpy(UserServerListInfo[index].szServerIp2, DownServerListInfo->ServerInfo[index].szServerIp2, strlen(DownServerListInfo->ServerInfo[index].szServerIp2));
   332				memcpy(UserServerListInfo[index].szServerIp3, DownServerListInfo->ServerInfo[index].szServerIp3, strlen(DownServerListInfo->ServerInfo[index].szServerIp3));
   333	
   334				UserServerListInfo[index].dwServerPort1 = DownServerListInfo->ServerInfo[index].dwServerPort1;
   335				UserServerListInfo[index].dwServerPort2 = DownServerListInfo->ServerInfo[index].dwServerPort2;
   336				UserServerListInfo[index].dwServerPort3 = DownServerListInfo->ServerInfo[index].dwServerPort3;
   337	
   338				UserServerListInfoCount++;
   339			}
   340		}
   341		else if(dwCode == OpCode::OPCODE_FAILCONNECT)
   342		{
   343			ServerLoginError = (smTRANS_COMMAND *)RecvBuff;
   344	
   345	#ifdef __MINGW32__
   346			FILE *fp = fopen("LOGS\\mingw_ho_recv.txt", "a");
   347			if(fp)
   348			{
   349				fprintf(
   350					fp,
   351					"FAILCONNECT WParam=%d LParam=%d\n",
   352					ServerLoginError->WParam,
   353					ServerLoginError->LParam
   354				);
   355				fclose(fp);
   356			}
   357	#endif
   358		}
   359		else
   360			ServerReturn = (smTRANS_CHAR_COMMAND2 *)RecvBuff;
   361	
   362	
   363	
   364		return TRUE;
   365	}
