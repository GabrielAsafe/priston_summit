  2412		{
  2413			lpStgArea = &StageArea[AreaNum];
  2414	
  2415			for(cnt = 0; cnt < STG_MONSTER_MAX; cnt++)
  2416			{
  2417				if(lpStgArea->lpCharMonster[cnt] && lpStgArea->lpCharMonster[cnt]->dwObjectSerial == dwObjectSerial)
  2418				{
  2419					return lpStgArea->lpCharMonster[cnt];
  2420				}
  2421			}
  2422		}
  2423	
  2424		return NULL;
