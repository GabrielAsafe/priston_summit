  2187	int rsCheckActiveFile(char *szFile)
  2188	{
  2189		WIN32_FIND_DATA	fd;
  2190		HANDLE	hFindHandle;
  2191	
  2192		hFindHandle = FindFirstFile(szFile, &fd);
  2193		if(hFindHandle == INVALID_HANDLE_VALUE) return FALSE;
  2194		FindClose(hFindHandle);
  2195	
  2196	
  2197		int cnt, len;
  2198		char szFileName[128];
  2199	
  2200		len = lstrlen(szFile);
  2201		memcpy(szFileName, szFile, len + 1);
  2202	
  2203		for(cnt = len - 1; cnt >= 0; cnt--)
  2204		{
  2205			if(szFileName[cnt] == '//')
  2206			{
  2207				szFileName[cnt] = 0;
  2208				break;
  2209			}
  2210		}
  2211	
  2212		if(lstrcmpi(szFileName, szUserModelPath) != 0)
  2213			return FALSE;
  2214	
  2215		return TRUE;
  2216	}
