  2389	
  2390		for(cnt = 0; cnt < AUTOPLAYER_MAX; cnt++)
  2391		{
  2392			if(chrAutoPlayer[cnt].dwObjectSerial == dwObjectSerial &&
  2393				chrAutoPlayer[cnt].Flag)
  2394			{
  2395	
  2396				return &chrAutoPlayer[cnt];
  2397			}
  2398		}
  2399	
