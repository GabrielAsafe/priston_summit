  2266	char *SetFieldInfoPath(char *SaveBuff, char *szFieldPath, char *InfoExt)
  2267	{
  2268		int cnt;
  2269		int len;
  2270		char *szFile;
  2271	
  2272		len = lstrlen(szFieldPath);
  2273		cnt = len - 1;
  2274	
  2275		szFile = szFieldPath;
  2276	
  2277		while(cnt > 0)
  2278		{
  2279			if(szFieldPath[cnt] == '/' || szFieldPath[cnt] == '\\') // MINGW_SETFIELDINFOPATH_SEPARATOR_FIX_V1
  2280			{
  2281				szFile = &szFieldPath[cnt + 1];
  2282				break;
  2283			}
  2284			cnt--;
  2285		}
  2286	
  2287		wsprintf(SaveBuff, "%s%s.%s", szFieldInfoPath, szFile, InfoExt);
  2288	
  2289		return SaveBuff;
  2290	}
