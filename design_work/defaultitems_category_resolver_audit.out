  2535			y * mVect._22 +
  2536			z * mVect._32;
  2537	
  2538		vz = x * mVect._13 +
  2539			y * mVect._23 +
  2540			z * mVect._33;
  2541	
  2542		vx >>= FLOATNS;
  2543		vy >>= FLOATNS;
  2544		vz >>= FLOATNS;
  2545	
  2546		Config->MapLightVector.x = vx;
  2547		Config->MapLightVector.y = vy;
  2548		Config->MapLightVector.z = vz;
  2549	
  2550		Config->MapBright = 130;
  2551		Config->MapContrast = 300;
  2552	
  2553		return &smConfig;
  2554	};
