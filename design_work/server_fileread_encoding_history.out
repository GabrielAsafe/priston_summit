 static char *local_GetWord(char *q, char *p)
 {
+	if(!q)
+		return p;
 
-
-	while((*p == 32) || (*p == 9))
+	if(!p)
 	{
-		p++;
+		q[0] = 0;
+		return p;
 	}
 
-	while((*p != 32) && (*p != 9))
+	while(*p == ' ' || *p == '\t')
+		p++;
+
+	int count = 0;
+
+	while(*p != 0 &&
+		  *p != ' ' &&
+		  *p != '\t' &&
+		  *p != '\n' &&
+		  *p != '\r')
 	{
-		if(*p == '/n' || *p == '/r') break;
-		*q++ = *p++;
-	}
-	*q++ = 0;
+		if(count < 255)
+		{
+			q[count] = *p;
+			count++;
+		}
 
+		p++;
+	}
 
+	q[count] = 0;
 
 	return p;
 }

