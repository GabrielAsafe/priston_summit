   181	void cITEM::Draw()
   182	{
   183		int t = 0, i = 0;
   184		char TempBuff[64];
   185		int len = 0, len2 = 0;
   186		int tSetTextXposi = 0;
   187		int x, y;
   188		len = lstrlen(szInfoBuff);
   189	
   190		memset(&TempBuff, 0, sizeof(TempBuff));
   191		for(i = 0; i < len; i++)
   192		{
   193			if(szInfoBuff[i] == '/r')
   194			{
   195				memcpy(TempBuff, szInfoBuff, i);
   196				break;
   197			}
   198	
   199		}
   200		len2 = lstrlen(TempBuff);
   201		tSetTextXposi = (int)(ItemBoxPosi.x + (((ItemBoxSize.x * 16) / 2) - ((len2*5.5) / 2)) + (len2*5.5));
   202	
   203		if(MouseItem.Flag)
   204		{
   205			if(!MouseItem.lpItem)
   206				dsDrawColorBox(RGBA_MAKE(125, 125, 255, 125), MouseItem.x, MouseItem.y, MouseItem.w, MouseItem.h);
   207	
   208			x = pCursorPos.x - (MouseItem.w / 2);
   209			y = pCursorPos.y - (MouseItem.h / 2);
   210	
   211			dsDrawOffsetArray = dsARRAY_TOP;
   212			DrawSprite(x, y, MouseItem.lpItem, 0, 0, MouseItem.w, MouseItem.h);
   213			if((MouseItem.sItemInfo.CODE & sinITEM_MASK2) == sinPZ1 || (MouseItem.sItemInfo.CODE & sinITEM_MASK2) == sinPZ2)
   214			{
   215				if(MouseItem.sItemInfo.PotionCount == 2)
   216				{
   217					if(MouseItem.w == 44)
   218						DrawSprite(x, y, cInvenTory.lpPuzzlewidth, 0, 0, 44, 22);
   219					if(MouseItem.w == 22)
   220						DrawSprite(x, y, cInvenTory.lpPuzzleHeight, 0, 0, 22, 44);
   221				}
   222			}
