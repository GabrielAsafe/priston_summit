    72	void cITEM::Init()
    73	{
    74		for(int cnt = 0; cnt < MAX_ITEM; cnt++)
    75		{
    76			sItem[cnt].sItemInfo.CODE = sItem[cnt].CODE;
    77		}
    78	
    79		MatItemInfoBox = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    80	
    81		MatItemInfoBox_TopLeft = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxTopLeft.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    82		MatItemInfoBox_TopRight = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxTopRight.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    83		MatItemInfoBox_TopCenter = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxTopCenter.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    84	
    85		MatItemInfoBox_BottomLeft = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxBottomLeft.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    86		MatItemInfoBox_BottomRight = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxBottomRight.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    87		MatItemInfoBox_BottomCenter = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxBottomCenter.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    88	
    89		MatItemInfoBox_Left = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxLeft.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    90		MatItemInfoBox_Right = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxRight.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    91		MatItemInfoBox_Center = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxCenter.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
    92	
    93		Load();
    94	
    95	
    96		int CheckCount = 0;
    97		while(1)
    98		{
    99	
   100			if(NotSell_Item_CODE[NotSell_Item_CODECnt])
   101				NotSell_Item_CODECnt++;
   102			else
   103				CheckCount++;
   104	
   105			if(NotSell_Item_MASK[NotSell_Item_MASKCnt])
   106				NotSell_Item_MASKCnt++;
   107			else
   108				CheckCount++;
   109	
   110			if(NotSell_Item_KIND[NotSell_Item_KINDCnt])
   111				NotSell_Item_KINDCnt++;
   112			else
   113				CheckCount++;
   114	
   115	
   116			if(NotDrow_Item_CODE[NotDrow_Item_CODECnt])
   117				NotDrow_Item_CODECnt++;
   118			else
   119				CheckCount++;
   120	
   121			if(NotDrow_Item_MASK[NotDrow_Item_MASKCnt])
   122				NotDrow_Item_MASKCnt++;
   123			else
   124				CheckCount++;
   125	
   126			if(NotDrow_Item_KIND[NotDrow_Item_KINDCnt])
   127				NotDrow_Item_KINDCnt++;
   128			else
   129				CheckCount++;
   130	
   131	
   132			if(NotSet_Item_CODE[NotSet_Item_CODECnt])
   133				NotSet_Item_CODECnt++;
   134			else
   135				CheckCount++;
   136	
   137			if(NotSet_Item_MASK[NotSet_Item_MASKCnt])
   138				NotSet_Item_MASKCnt++;
   139			else
   140				CheckCount++;
   141	
   142			if(NotSet_Item_KIND[NotSet_Item_KINDCnt])
   143				NotSet_Item_KINDCnt++;
   144			else
   145				CheckCount++;
   146	
   147			if(CheckCount >= 9)
   148				break;
   149	
   150		}
   151	
   152		memset(g_Manufacture_ItemInfo, 0, sizeof(SManufacture_ResultItemInfo));
   153	}
