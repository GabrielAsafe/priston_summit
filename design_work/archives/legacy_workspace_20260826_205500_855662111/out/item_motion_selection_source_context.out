  2386	int smCHAR::FindMotionCountFromCode(DWORD MotionCode)
  2387	{
  2388		int FindCnt = 0;
  2389	
  2390		for (DWORD cnt = 0; cnt < smMotionInfo->MotionCount; cnt++)
  2391		{
  2392			if (smMotionInfo->MotionInfo[cnt].State == MotionCode)
  2393				FindCnt++;
  2394		}
  2395	
  2396		return FindCnt;
  2397	}
