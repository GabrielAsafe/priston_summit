  2450	int CreateItem(psITEM *lpsItem, char *szCoed, int JobCode)
  2451	{
  2452		int cnt;
  2453		DWORD dwCode;
  2454		DWORD dwCodeMask1, dwCodeMask2;
  2455	
  2456		for (cnt = 0; cnt < MAX_ITEM; cnt++)
  2457		{
  2458			if (lstrcmpi(szCoed, sItem[cnt].LastCategory) == 0)
  2459			{
  2460				dwCode = sItem[cnt].CODE; break;
  2461			}
  2462		}
  2463	
  2464		if (cnt >= MAX_ITEM) return FALSE;
  2465	
  2466		for (cnt = 0; cnt < DefaultItemCount; cnt++)
  2467		{
  2468			if (DefaultItems[cnt].Item.CODE == dwCode && !DefaultItems[cnt].Item.UniqueItem)
  2469			{
  2470				CreateDefItemPerf(&lpsItem->ItemInfo, &DefaultItems[cnt], JobCode);
  2471	
  2472	
  2473				if (spTimeAdjust)
  2474				{
  2475					dwCodeMask1 = lpsItem->ItemInfo.CODE&sinITEM_MASK2;
  2476					dwCodeMask2 = lpsItem->ItemInfo.CODE&sinITEM_MASK3;
  2477					if ((dwCodeMask1 == sinDA1 || dwCodeMask1 == sinDA2) && dwCodeMask2 >= sin31)
  2478					{
  2479						ReformItem_AdjustTime(&lpsItem->ItemInfo, spTimeAdjust);
  2480					}
  2481	
  2482	
  2483					if ((dwCodeMask1 == sinOA1 && dwCodeMask2 == sin32) || (dwCodeMask1 == sinOR2 && dwCodeMask2 == sin27) ||
  2484						(dwCodeMask1 == sinOA1 && dwCodeMask2 == sin33) || (dwCodeMask1 == sinOR2 && dwCodeMask2 == sin28))
  2485					{
  2486						ReformItem_AdjustTime(&lpsItem->ItemInfo, spTimeAdjust);
  2487					}
  2488				}
  2489	
  2490	
  2491				rsSaveCreateItemToHDD(lpsItem);
  2492				return TRUE;
  2493			}
  2494		}
  2495	
  2496	
  2497		return FALSE;
  2498	}
  2499	
  2500	int srSetItemFromCode(psITEM *lpsItem, char *szCoed)
  2501	{
  2502		int cnt;
  2503		DWORD dwCode;
  2504		DWORD dwCodeMask1, dwCodeMask2;
  2505	
  2506		for(cnt = 0; cnt < MAX_ITEM; cnt++)
  2507		{
  2508			if(lstrcmpi(szCoed, sItem[cnt].LastCategory) == 0)
  2509			{
  2510				dwCode = sItem[cnt].CODE; break;
  2511			}
  2512		}
  2513	
  2514		if(cnt >= MAX_ITEM) return FALSE;
  2515	
  2516		for(cnt = 0; cnt < DefaultItemCount; cnt++)
  2517		{
  2518			if(DefaultItems[cnt].Item.CODE == dwCode && !DefaultItems[cnt].Item.UniqueItem)
  2519			{
  2520				CreateDefItem(&lpsItem->ItemInfo, &DefaultItems[cnt], spJobCode, spItemNormal);
  2521	
  2522				if(spTimeAdjust)
  2523				{
  2524					dwCodeMask1 = lpsItem->ItemInfo.CODE&sinITEM_MASK2;
  2525					dwCodeMask2 = lpsItem->ItemInfo.CODE&sinITEM_MASK3;
  2526					if((dwCodeMask1 == sinDA1 || dwCodeMask1 == sinDA2) && dwCodeMask2 >= sin31)
  2527					{
  2528						ReformItem_AdjustTime(&lpsItem->ItemInfo, spTimeAdjust);
  2529					}
  2530	
  2531	
  2532					if((dwCodeMask1 == sinOA1 && dwCodeMask2 == sin32) || (dwCodeMask1 == sinOR2 && dwCodeMask2 == sin27) ||
  2533						(dwCodeMask1 == sinOA1 && dwCodeMask2 == sin33) || (dwCodeMask1 == sinOR2 && dwCodeMask2 == sin28))
  2534					{
  2535						ReformItem_AdjustTime(&lpsItem->ItemInfo, spTimeAdjust);
  2536					}
  2537				}
  2538	
  2539	
  2540				rsSaveCreateItemToHDD(lpsItem);

