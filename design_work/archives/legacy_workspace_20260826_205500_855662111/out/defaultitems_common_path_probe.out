 41464	int	rsUpdateServerParam(rsPLAYINFO *lpPlayInfo, DWORD dwUpdateCode, int Param1, int Param2, int TargetMode)
 41465	{
 41466		smTRANS_COMMAND	smTransCommand;
 41467	
 41468		smTransCommand.size = sizeof(smTRANS_COMMAND);
 41469		smTransCommand.code = OpCode::OPCODE_UPDATE_SERVER_PARAM;
 41470		smTransCommand.WParam = dwUpdateCode;
 41471		smTransCommand.LParam = Param1;
 41472		smTransCommand.SParam = Param2;
 41473		smTransCommand.EParam = rsServerConfig.ServerCode;
 41474	
 41475		if(lpPlayInfo->lpsmSock)
 41476		{
 41477			if(TargetMode)
 41478				return rsSendDataServer(lpPlayInfo->lpsmSock, &smTransCommand);
 41479			else
 41480				return rsSendGameServer(lpPlayInfo->lpsmSock, &smTransCommand);
 41481		}
 41482	
 41483		return NULL;
 41484	}
