  2221	int InitItems()
  2222	{
  2223		HANDLE hFindHandle;
  2224		WIN32_FIND_DATA	fd;
  2225		char	szFindPath[64];
  2226		char	szFilePath[64];
  2227		sDEF_ITEMINFO	DefItem;
  2228	
  2229		DefaultItemCount = 0;
  2230	
  2231		strcpy_s(szFindPath, ItemPath);
  2232		lstrcat(szFindPath, "*.txt");
  2233	
  2234		hFindHandle = FindFirstFile(szFindPath, &fd);
  2235		if(hFindHandle != INVALID_HANDLE_VALUE)
  2236		{
  2237			while(1)
  2238			{
  2239				strcpy_s(szFilePath, ItemPath);
  2240				lstrcat(szFilePath, fd.cFileName);
  2241	
  2242				DecodeItemInfo(szFilePath, &DefaultItems[DefaultItemCount]);
  2243	
  2244				memcpy(&DefItem, &DefaultItems[DefaultItemCount], sizeof(sDEF_ITEMINFO));
  2245				SetLowerItem(&DefItem);
  2246	
  2247				DefItem.Item.BackUpKey = 0;
  2248				DefItem.Item.BackUpChkSum = 0;
  2249				DefItem.Item.dwCreateTime = 0;
  2250	
  2251				DefaultItems[DefaultItemCount].DefCompressDataLen = EecodeCompress((BYTE *)&DefItem.Item, (BYTE *)DefaultItems[DefaultItemCount].DefCompressData, sizeof(sITEMINFO));
  2252	
  2253				DefaultItemCount++;
  2254	
  2255				if(FindNextFile(hFindHandle, &fd) == FALSE) break;
  2256				if(DefaultItemCount >= DEF_ITEM_MAX) break;
  2257			}
  2258		}
  2259		FindClose(hFindHandle);
  2260	
  2261	
  2262		return TRUE;
  2263	}
