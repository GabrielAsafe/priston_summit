    92	void cITEM::Init()
    93	{
    94		for (int cnt = 0; cnt < MAX_ITEM; cnt++)
    95		{
    96			sItem[cnt].sItemInfo.CODE = sItem[cnt].CODE;
    97		}
    98	
    99		MatItemInfoBox = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   100	
   101		MatItemInfoBox_TopLeft = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxTopLeft.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   102		MatItemInfoBox_TopRight = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxTopRight.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   103		MatItemInfoBox_TopCenter = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxTopCenter.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   104	
   105		MatItemInfoBox_BottomLeft = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxBottomLeft.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   106		MatItemInfoBox_BottomRight = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxBottomRight.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   107		MatItemInfoBox_BottomCenter = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxBottomCenter.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   108	
   109		MatItemInfoBox_Left = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxLeft.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   110		MatItemInfoBox_Right = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxRight.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   111		MatItemInfoBox_Center = CreateTextureMaterial("Image//SinImage//Items//ItemInfoBox//BoxCenter.tga", 0, 0, 0, 0, SMMAT_BLEND_ALPHA);
   112	
   113		Load();
   114	
   115	
   116		int CheckCount = 0;
   117		while (1)
   118		{
   119	
   120			if (NotSell_Item_CODE[NotSell_Item_CODECnt])
   121				NotSell_Item_CODECnt++;
   122			else
   123				CheckCount++;
   124	
   125			if (NotSell_Item_MASK[NotSell_Item_MASKCnt])
   126				NotSell_Item_MASKCnt++;
   127			else
   128				CheckCount++;
   129	
   130			if (NotSell_Item_KIND[NotSell_Item_KINDCnt])
   131				NotSell_Item_KINDCnt++;
   132			else
   133				CheckCount++;
   134	
   135	
   136			if (NotDrow_Item_CODE[NotDrow_Item_CODECnt])
   137				NotDrow_Item_CODECnt++;
   138			else
   139				CheckCount++;
   140	
   141			if (NotDrow_Item_MASK[NotDrow_Item_MASKCnt])
   142				NotDrow_Item_MASKCnt++;
   143			else
   144				CheckCount++;
   145	
   146			if (NotDrow_Item_KIND[NotDrow_Item_KINDCnt])
   147				NotDrow_Item_KINDCnt++;
   148			else
   149				CheckCount++;
   150	
   151	
   152			if (NotSet_Item_CODE[NotSet_Item_CODECnt])
   153				NotSet_Item_CODECnt++;
   154			else
   155				CheckCount++;
   156	
   157			if (NotSet_Item_MASK[NotSet_Item_MASKCnt])
   158				NotSet_Item_MASKCnt++;
   159			else
   160				CheckCount++;
   161	
   162			if (NotSet_Item_KIND[NotSet_Item_KINDCnt])
   163				NotSet_Item_KINDCnt++;
   164			else
   165				CheckCount++;
   166	
   167			if (CheckCount >= 9)
   168				break;
   169	
   170		}
   171	
   172		memset(g_Manufacture_ItemInfo, 0, sizeof(SManufacture_ResultItemInfo));
   173	}
