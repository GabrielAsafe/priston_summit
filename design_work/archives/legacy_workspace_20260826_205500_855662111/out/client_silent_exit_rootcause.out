======================================================================
6. CLIENTE.SH - TRECHO DE FLAGS / LINK
======================================================================
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	################################################################################
     5	# SummitTale — build, link e envio do cliente MinGW i686
     6	################################################################################
     7	
     8	ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
     9	cd "$ROOT"
    10	
    11	BUILD_SCRIPT="${BUILD_SCRIPT:-build_client_mingw_i686_multicore.sh}"
    12	LINK_SCRIPT="${LINK_SCRIPT:-link_client_mingw_i686.sh}"
    13	DIST_DIR="${DIST_DIR:-dist_mingw_client_i686}"
    14	CLIENT_EXE="${CLIENT_EXE:-Game.exe}"
    15	
    16	# Pode ser alterado sem editar o script:
    17	# DEST='utilizador@host:C:/caminho' PORT=2223 ./cliente.sh
    18	DEST="${DEST:-server@127.0.0.1:C:/Users/server/Desktop/cli}"
    19	
    20	
    21	PORT="${PORT:-2223}"
    22	
    23	MINGW_BIN="${MINGW_BIN:-/usr/i686-w64-mingw32/sys-root/mingw/bin}"
    24	
    25	RUNTIME_DLLS=(
    26	    libgcc_s_dw2-1.dll
    27	    libstdc++-6.dll
    28	    libwinpthread-1.dll
    29	)
    30	
    31	log_section()
    32	{
    33	    echo
    34	    echo "===================================="
    35	    echo "$1"
    36	    echo "===================================="
    37	}
    38	
    39	require_file()
    40	{
    41	    if [ ! -f "$1" ]; then
    42	        echo "Erro: ficheiro não encontrado: $1" >&2
    43	        exit 1
    44	    fi
    45	}
    46	
    47	require_command()
    48	{
    49	    if ! command -v "$1" >/dev/null 2>&1; then
    50	        echo "Erro: comando não encontrado: $1" >&2
    51	        exit 1
    52	    fi
    53	}
    54	
    55	require_file "$BUILD_SCRIPT"
    56	require_file "$LINK_SCRIPT"
    57	require_command bash
    58	require_command scp
    59	
    60	log_section "1/4 — COMPILAÇÃO DO CLIENTE"
    61	bash "$BUILD_SCRIPT"
    62	
    63	log_section "2/4 — LINK DO CLIENTE"
    64	bash "$LINK_SCRIPT"
    65	
    66	OUTPUT="$DIST_DIR/$CLIENT_EXE"
    67	require_file "$OUTPUT"
    68	
    69	log_section "3/4 — DLLs DE RUNTIME"
    70	mkdir -p "$DIST_DIR"
    71	
    72	FILES_TO_SEND=("$OUTPUT")
    73	
    74	for dll in "${RUNTIME_DLLS[@]}"; do
    75	    source_path="$MINGW_BIN/$dll"
    76	    target_path="$DIST_DIR/$dll"
    77	
    78	    if [ -f "$source_path" ]; then
    79	        cp -f "$source_path" "$target_path"
    80	        FILES_TO_SEND+=("$target_path")
    81	        echo "OK   $dll"
    82	    elif [ -f "$target_path" ]; then
    83	        FILES_TO_SEND+=("$target_path")
    84	        echo "OK   $dll (já existente em $DIST_DIR)"
    85	    else
    86	        echo "Aviso: DLL não encontrada: $source_path" >&2
    87	    fi
    88	done
    89	
    90	log_section "4/4 — ENVIO DO CLIENTE"
    91	echo "Destino : $DEST"
    92	echo "Porta   : $PORT"
    93	echo "Ficheiros:"
    94	printf '  %s\n' "${FILES_TO_SEND[@]}"
    95	echo
    96	
    97	scp -P "$PORT" "${FILES_TO_SEND[@]}" "$DEST"
    98	
    99	log_section "CLIENTE CONCLUÍDO"
   100	echo "Executável: $OUTPUT"
   101	echo "Enviado para: $DEST"
