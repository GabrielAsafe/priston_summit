======================================================================
1. WINDUMP / EXCEPTION HANDLER COMPLETO
======================================================================
     1	#include <windows.h>
     2	#include <imagehlp.h>
     3	#include "WinDump.h"
     4	
     5	#pragma comment(lib,"Imagehlp.lib")
     6	
     7	typedef	BOOL(WINAPI * MINIDUMP_WRITE_DUMP)(
     8		IN HANDLE			hProcess,
     9		IN DWORD			ProcessId,
    10		IN HANDLE			hFile,
    11		IN MINIDUMP_TYPE	DumpType,
    12		IN CONST PMINIDUMP_EXCEPTION_INFORMATION	ExceptionParam, OPTIONAL
    13		IN PMINIDUMP_USER_STREAM_INFORMATION		UserStreamParam, OPTIONAL
    14		IN PMINIDUMP_CALLBACK_INFORMATION			CallbackParam OPTIONAL
    15		);
    16	
    17	void create_minidump(struct _EXCEPTION_POINTERS* apExceptionInfo)
    18	{
    19		HMODULE	hDbgHelp;
    20		MINIDUMP_WRITE_DUMP	MiniDumpWriteDump_;
    21	
    22		hDbgHelp = LoadLibraryA("DBGHELP.DLL");
    23		MiniDumpWriteDump_ = (MINIDUMP_WRITE_DUMP)GetProcAddress(hDbgHelp, "MiniDumpWriteDump");
    24	
    25		if(MiniDumpWriteDump_)
    26		{
    27			MINIDUMP_EXCEPTION_INFORMATION  M;
    28			HANDLE  hDump_File;
    29	
    30			M.ThreadId = GetCurrentThreadId();
    31			M.ExceptionPointers = apExceptionInfo;  //got by GetExceptionInformation()
    32			M.ClientPointers = 0;
    33	
    34	
    35			hDump_File = CreateFileA("crash.dmp", GENERIC_WRITE, 0,
    36				NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    37	
    38			const DWORD Flags = MiniDumpWithFullMemory |
    39				MiniDumpWithFullMemoryInfo |
    40				MiniDumpWithHandleData |
    41				MiniDumpWithUnloadedModules |
    42				MiniDumpWithThreadInfo;
    43	
    44			MiniDumpWriteDump_(GetCurrentProcess(), GetCurrentProcessId(),
    45							   hDump_File, (MINIDUMP_TYPE)Flags,
    46							   (apExceptionInfo) ? &M : NULL, NULL, NULL);
    47	
    48			CloseHandle(hDump_File);
    49		}
    50	
    51	}
    52	
    53	LONG WINAPI unhandled_handler(struct _EXCEPTION_POINTERS* apExceptionInfo)
    54	{
    55		create_minidump(apExceptionInfo);
    56		ExitProcess(0);
    57		return EXCEPTION_CONTINUE_SEARCH;
    58	}
    59	
    60	
    61	
    62	
    63	

