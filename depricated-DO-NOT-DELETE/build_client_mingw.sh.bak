#!/usr/bin/env bash

set -e

ROOT="$(pwd)"
OBJDIR="$ROOT/build_mingw_client"

mkdir -p "$OBJDIR"

find SrcGame/src -iname '*.cpp' > cpp_files.txt

parallel -j$(nproc) --bar '
obj="'$OBJDIR'/{/.}.o"

x86_64-w64-mingw32-g++ \
-c {} \
-o "$obj" \
-std=gnu++17 \
-fpermissive \
-Wno-write-strings \
-Wno-narrowing \
-Wno-unused-variable \
-Wno-unused-parameter \
-Wno-deprecated-declarations \
-DWIN32 \
-D_WINDOWS \
-DNDEBUG \
-I. \
-IShared \
-IShared2 \
-ISrcGame/src \
-ISrcGame/src/smLib3d \
-ISrcGame/src/sinbaram \
-ISrcGame/src/Language \
-ISrcGame/src/Resources \
-ISrcGame/src/Sound \
-ISrcGame/src/HoBaram \
-ISrcGame/src/HoBaram/NewEffect \
-ISrcGame/src/HoBaram/NewEffect/math \
-ISrcGame/src/HoBaram/NewEffect/Script \
-ISrcGame/src/Library/LuaSrc \
-ISrcGame/src/Library/LuaSrc/Lua \
-ISrcGame/src/TJBOY/clanmenu \
-ISrcGame/src/TJBOY/isaocheck \
-ISrcGame/src/TJBOY/park \
-ISrcGame/src/TJBOY/Ygy \
-ISrcGame/src/TJBOY/Ygy/memmap \
-ISrcGame/src/Server \
-ISrcGame/src/WinInt \
-ISrcGame/src/Security \
-ISrcGame/src/Settings \
-Imodules \
-Imodules/File \
-Imodules/MD5 \
-Imodules/Helper \
-IDependency/DirectX9/Include \
2>> build_compile_errors.log
' :::: cpp_files.txt

echo
echo "Compilação terminada."
echo "Objetos gerados em:"
echo "$OBJDIR"
echo
echo "Erros:"
echo "build_compile_errors.log"
